/* ===== 新手教程：锚点高亮 + 泡泡对话气泡（重设计版） ===== */

.onb-root {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.onb-hole {
  position: fixed;
  border: 3rpx solid #34B8C5;
  border-radius: 14px;
  background: transparent;
  box-shadow: 0 0 0 9999rpx rgba(9, 26, 44, 0.66), 0 0 0 8rpx rgba(52, 184, 197, 0.25);
  pointer-events: none;
  z-index: 101;
  transition: all 0.18s ease;
}

.onb-hole.full {
  border: none;
  border-radius: 0;
  background: rgba(9, 26, 44, 0.66);
  box-shadow: none;
}

.onb-pop {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  z-index: 102;
  transition: opacity 0.15s ease;
}

.onb-pop-moving {
  opacity: 0;
  pointer-events: none;
}

.onb-pop-center {
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 0 56rpx;
  box-sizing: border-box;
}

.onb-bubble {
  display: flex;
  flex-direction: column;
  position: relative;
  padding: 26rpx 24rpx 22rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 6rpx 6rpx 0 rgba(28, 28, 28, 0.85);
}

.onb-body {
  display: flex;
  align-items: flex-start;
}

.onb-pop-center .onb-bubble {
  width: 100%;
  box-sizing: border-box;
}

.onb-tail {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background: #FFFFFF;
  z-index: 1;
}

.pop-below .onb-tail {
  top: -13rpx;
  border-left: 3rpx solid #1C1C1C;
  border-top: 3rpx solid #1C1C1C;
  transform: rotate(45deg);
}

.pop-above .onb-tail {
  bottom: -13rpx;
  border-right: 3rpx solid #1C1C1C;
  border-bottom: 3rpx solid #1C1C1C;
  transform: rotate(45deg);
}

.pop-center .onb-tail,
.pop-moving .onb-tail {
  display: none;
}

/* 左侧吉祥物：探出气泡上沿，无框透明底 */
.onb-mascot {
  flex-shrink: 0;
  width: 208rpx;
  height: 208rpx;
  margin-right: 14rpx;
  margin-top: -52rpx;
  margin-left: -10rpx;
}

/* 右侧文本区 */
.onb-text {
  flex: 1;
  min-width: 0;
}

.onb-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 进度圆点：当前步拉长成胶囊 */
.onb-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.onb-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #DCE5EC;
}

.onb-dot.on {
  width: 28rpx;
  background: #34B8C5;
}

.onb-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #14324A;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.onb-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #55677A;
}

.onb-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.onb-skip {
  padding: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #9AA8B2;
}

.onb-next {
  padding: 12rpx 44rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #34B8C5;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  font-size: 28rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.onb-next:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}
