.watch-ball {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 90;
  width: 150rpx;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(28, 28, 28, 0.8);
  border-radius: 50%;
  background: linear-gradient(150deg, rgba(231, 251, 252, 0.72) 0%, rgba(52, 184, 197, 0.6) 100%);
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.35);
  animation: watch-ball-pulse 1.6s ease-in-out infinite;
}

.watch-ball.is-snap {
  transition: left 0.25s ease;
}

@keyframes watch-ball-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

.watch-ball-icon {
  width: 88rpx;
  height: 88rpx;
}

.watch-ball-time {
  margin-top: 2rpx;
  color: #1C1C1C;
  font-size: 22rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
