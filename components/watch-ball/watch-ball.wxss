.watch-ball {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 90;
  /* 尺寸固定 150rpx：utils/watchBall 的拖拽边界按同值换算，尺寸必须与之一致 */
  width: 150rpx;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(28, 28, 28, 0.22);
  border-radius: 50%;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.84), rgba(231, 251, 252, 0.58));
  -webkit-backdrop-filter: blur(14px) saturate(160%);
  backdrop-filter: blur(14px) saturate(160%);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.92), 0 12rpx 30rpx rgba(28, 28, 28, 0.18);
  animation: watch-ball-pulse 2s ease-in-out infinite;
}

.watch-ball.is-snap {
  transition: left 0.25s ease;
}

@keyframes watch-ball-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

.watch-ball-icon {
  width: 88rpx;
  height: 88rpx;
}

.watch-ball-time {
  margin-top: 2rpx;
  color: #1C1C1C;
  font-size: 22rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

/* ===== 点球后的操作菜单 ===== */

/* 透明遮罩：只负责「点空白收起」，不挡视觉 */
.ball-menu-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 95;
}

/* 贴着球的一侧展开，尺寸与 TS 里算位置用的 236rpx / 276rpx 保持一致 */
.ball-menu {
  position: fixed;
  z-index: 96;
  width: 236rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  animation: ball-menu-in 0.16s ease-out both;
}

@keyframes ball-menu-in {
  from { opacity: 0; transform: scale(0.9); }
  to   { opacity: 1; transform: scale(1); }
}

.ball-menu-item {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1C1C1C;
  font-size: 26rpx;
  font-weight: 800;
}

.ball-menu-item + .ball-menu-item {
  border-top: 2rpx solid rgba(28, 28, 28, 0.1);
}

.ball-menu-item.danger {
  color: #D9463F;
}

.ball-menu-item.tap {
  background: rgba(28, 28, 28, 0.05);
}
