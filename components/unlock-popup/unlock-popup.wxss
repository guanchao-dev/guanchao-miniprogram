.unlock-mask {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 40rpx 80rpx;
  box-sizing: border-box;
  background: rgba(8, 22, 44, 0.78);
}

.unlock-close {
  position: absolute;
  top: calc(48rpx + env(safe-area-inset-top));
  right: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 1;
}

.unlock-copy {
  position: relative;
  z-index: 2;
  width: 100%;
  text-align: center;
}

.unlock-kicker {
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 900;
  text-shadow: 0 0 16rpx rgba(246, 208, 129, 0.7);
}

.unlock-name {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 20rpx;
  color: #F6D081;
  font-size: 40rpx;
  font-weight: 900;
}

.wing {
  color: #A7D9C7;
  font-size: 28rpx;
}

.unlock-desc {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  line-height: 1.5;
}

.unlock-stage {
  position: relative;
  /* 自成层，保证星星/光环只盖在勋章图上，不会飞到上方文案里 */
  z-index: 1;
  width: 380rpx;
  height: 380rpx;
  margin: 28rpx 0 36rpx;
}

.unlock-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 340rpx;
  height: 340rpx;
  transform: translate(-50%, -50%);
}

.unlock-badge image {
  width: 340rpx;
  height: 340rpx;
}

.burst-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  /* 起始直径调大，扩散后能超出放大后的勋章图，形成外圈光环 */
  width: 240rpx;
  height: 240rpx;
  margin: -120rpx 0 0 -120rpx;
  border: 8rpx solid #F6D081;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 24rpx rgba(246, 208, 129, 0.85);
}

.burst-ring.late {
  border-color: #34B8C5;
  box-shadow: 0 0 24rpx rgba(52, 184, 197, 0.85);
}

.burst-ring.go {
  /* 循环播放，两圈错开半周期，形成持续扩散的光环 */
  animation: ring-pop 1600ms ease-out infinite;
}

.burst-ring.late.go {
  animation-delay: 800ms;
}

.unlock-btn {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 88rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFF4D6, #F6D081 55%, #E8B85A);
  color: #1C1C1C;
  font-size: 32rpx;
  font-weight: 850;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

@keyframes ring-pop {
  0% {
    opacity: 0.95;
    transform: scale(0.75);
  }
  /* 中段才慢淡，光环扩散更持久 */
  70% {
    opacity: 0.45;
  }
  100% {
    opacity: 0;
    transform: scale(2.6);
  }
}
