.district-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 4rpx 0;
}

.district-chip {
  display: inline-block;
  padding: 9rpx 22rpx;
  margin-right: 10rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
  color: #1C1C1C;
  font-size: 23rpx;
  font-weight: 750;
}

.district-chip.active {
  background: #34B8C5;
  color: #FFFFFF;
  font-weight: 850;
}

.spot-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
}

.item-rank {
  width: 46rpx;
  height: 46rpx;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #F6D081;
  text-align: center;
  line-height: 40rpx;
  font-size: 22rpx;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.item-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  color: #1C1C1C;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  font-size: 21rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.meta-heat {
  color: #D9463F;
}

.meta-dist {
  color: #2E9E5B;
}

.meta-district {
  color: #6B7C8A;
}

.item-arrow {
  color: #1888BF;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.mask {
  position: fixed;
  inset: 0;
  /* 高于悬浮赶海球（90） */
  z-index: 95;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(11, 31, 56, 0.56);
}

.sheet {
  width: 100%;
  max-height: 84vh;
  overflow: hidden;
  border: 4rpx solid #1C1C1C;
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  background: #FBF7EF;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx 12rpx;
  color: #1C1C1C;
  font-size: 32rpx;
  font-weight: 900;
}

.sheet-close {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #FFFFFF;
  color: #1C1C1C;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
}

.sheet-body {
  padding: 8rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.detail-chip {
  padding: 5rpx 16rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}

.detail-chip.heat {
  background: #FDECC8;
  color: #8A5B00;
}

.detail-chip.dist {
  background: #DDF3F6;
  color: #0E7C92;
}

.tide-summary {
  display: block;
  margin-top: 10rpx;
  color: #4F6787;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.5;
}

.detail-link {
  margin-top: 18rpx;
  height: 72rpx;
  line-height: 66rpx;
  text-align: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F6D081;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  color: #1C1C1C;
  font-size: 25rpx;
  font-weight: 850;
}

.detail-link:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

/* 导航行：左文右「纸飞机+导航」按钮，参照地图 App 的地点导航样式 */
.nav-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.nav-row:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

.nav-row-main {
  flex: 1;
  min-width: 0;
}

.nav-row-title {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
  color: #1C1C1C;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #6B7C8A;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-row-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 18rpx;
  flex-shrink: 0;
}

.nav-plane {
  width: 60rpx;
  height: 60rpx;
  box-sizing: border-box;
  line-height: 54rpx;
  text-align: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #F6D081;
  font-size: 28rpx;
  color: #1C1C1C;
}

.nav-row-label {
  margin-top: 4rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: #6B7C8A;
}
