<view class="page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle lg" style="top: 20rpx; right: -40rpx; background:#34B8C5;"></view>
    <view class="geo-square" style="bottom: 180rpx; left: -30rpx; background:#F6D081;"></view>
  </view>

  <view class="page-content">
    <!-- 区域筛选 -->
    <scroll-view scroll-x class="district-bar" wx:if="{{districts.length > 1}}">
      <view
        class="district-chip {{(!currentDistrict && item === '全部') || currentDistrict === item ? 'active' : ''}}"
        wx:for="{{districts}}"
        wx:key="*this"
        data-district="{{item}}"
        bindtap="onSelectDistrict"
        hover-class="tap"
      >{{item}}</view>
    </scroll-view>
    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>
    <view class="empty-tip" wx:elif="{{!filteredList.length}}">该区域暂无赶海点</view>
    <view class="spot-item card" wx:for="{{filteredList}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen" hover-class="tap">
      <view class="item-rank">{{index + 1}}</view>
      <image class="item-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <view class="item-body">
        <view class="item-name">{{item.name}}</view>
        <view class="item-meta">
          <text class="meta-heat">🔥 {{item.heat}}</text>
          <text class="meta-dist" wx:if="{{item.distanceText}}">{{item.distanceText}}</text>
        </view>
      </view>
      <text class="item-arrow">›</text>
    </view>
  </view>

  <view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text>{{detail.name}}</text>
        <text class="sheet-close" bindtap="closeDetail" hover-class="tap">×</text>
      </view>
      <scroll-view scroll-y class="sheet-body">
        <!-- 多张照片时自动轮播，单张静态展示 -->
        <swiper
          wx:if="{{photos.length}}"
          class="pano"
          indicator-dots
          circular
          autoplay="{{photos.length > 1}}"
          interval="3500"
          duration="420"
        >
          <swiper-item wx:for="{{photos}}" wx:key="*this">
            <image class="pano-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewPhoto" hover-class="tap"></image>
          </swiper-item>
        </swiper>
        <view class="pano-fallback" wx:else>
          <image src="{{detail.icon}}" mode="aspectFit"></image>
          <text>暂无全景照片</text>
        </view>

        <!-- 上传现场照片（1~3 张，提交后进入审核） -->
        <view class="photo-upload-btn {{uploadingPhotos ? 'disabled' : ''}}" bindtap="onUploadPhotos" hover-class="tap">
          <text class="photo-upload-btn-icon">＋</text>
          <text>上传现场照片</text>
        </view>

        <view class="info-row">
          <text class="info-k">距离</text>
          <text class="info-v">{{detail.distanceText}}</text>
        </view>
        <view class="info-row">
          <text class="info-k">开放</text>
          <text class="info-v">{{detail.openTime}}</text>
        </view>

        <view class="nav-row" bindtap="onNavigate" hover-class="tap">
          <view class="nav-row-main">
            <text class="nav-row-title">导航到{{detail.navName || detail.name}}</text>
            <text class="nav-row-sub">{{detail.distanceText}} · 高德 / 百度等地图一键导航</text>
          </view>
          <view class="nav-row-action">
            <view class="nav-plane">✈</view>
            <text class="nav-row-label">导航</text>
          </view>
        </view>

        <view class="block-title">今日潮汐</view>
        <text class="tide-summary">{{tideSummary}}</text>
        <view class="tide-table" wx:if="{{tideRows.length}}">
          <view class="tide-row" wx:for="{{tideRows}}" wx:key="time">
            <text>{{item.time}}</text>
            <text>{{item.label}}</text>
            <text>{{item.height}}</text>
          </view>
        </view>

        <view class="block-title">可能遇到</view>
        <view class="chip-row">
          <text
            class="chip {{item.id ? 'active' : ''}}"
            wx:for="{{detail.species}}"
            wx:key="name"
            data-id="{{item.id}}"
            bindtap="openSpecies"
           hover-class="tap">{{item.name}}</text>
        </view>
        <text class="hint">{{detail.observeHint}}</text>

        <view class="chip-row" wx:if="{{detail.safetyTags.length}}">
          <text class="chip" wx:for="{{detail.safetyTags}}" wx:key="*this">{{item}}</text>
        </view>
        <!-- scroll-view 的 padding-bottom 不计入滚动高度，用占位块保证底部留白 -->
        <view class="sheet-bottom-gap"></view>
      </scroll-view>
    </view>
  </view>
</view>

<watch-ball />
