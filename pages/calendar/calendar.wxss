.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
}

.cal-nav {
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  line-height: 66rpx;
  text-align: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  color: #1C1C1C;
  font-size: 40rpx;
  font-weight: 800;
}

.cal-nav:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

.cal-month {
  padding: 6rpx 20rpx;
  color: #1C1C1C;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.cal-spot {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 16rpx 6rpx 0;
  padding: 10rpx 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.cal-spot-dot {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #34B8C5;
}

.cal-spot-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #1C1C1C;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cal-spot-label {
  flex-shrink: 0;
  color: #6B7C8A;
  font-size: 20rpx;
  font-weight: 700;
}

.cal-swipe-tip {
  padding: 10rpx 8rpx 28rpx;
  color: #6B7C8A;
  font-size: 20rpx;
  font-weight: 650;
  text-align: center;
}

.cal-card {
  margin-top: 16rpx;
  padding: 10rpx 6rpx;
  min-height: 700rpx; /* 保证加载中也有一块可滑动的区域 */
  box-sizing: border-box;
  overflow: hidden;
}

.cal-week {
  display: flex;
}

.cal-weekday {
  flex: 1;
  padding: 8rpx 0;
  text-align: center;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 650;
}

.cal-head .cal-weekday {
  color: #1C1C1C;
  font-weight: 800;
}

.cal-cell {
  flex: 1;
  min-width: 0;
  min-height: 116rpx;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(28, 28, 28, 0.08);
  border-left: 2rpx solid rgba(28, 28, 28, 0.08);
}

.cal-day {
  color: #1C1C1C;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

/* 今天：青底浅染 + 日期换成青底白字胶囊，和全局「选中=青」一致 */
.cal-cell.today {
  border-radius: 10rpx;
  background: #E7FBFC;
  box-shadow: inset 0 0 0 2rpx rgba(52, 184, 197, 0.55);
}

.cal-cell.today .cal-day {
  display: inline-block;
  min-width: 44rpx;
  padding: 2rpx 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #34B8C5;
  color: #FFFFFF;
  font-weight: 900;
  text-align: center;
}

.cal-low {
  margin-top: 4rpx;
  color: #2E9E5B;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.cal-high {
  margin-top: 2rpx;
  color: #D9463F;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.cal-hint {
  margin-top: 2rpx;
  color: #8A5B00;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.25;
}
