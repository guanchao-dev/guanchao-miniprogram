.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
}

.cal-nav {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #087CFF;
  border-radius: 50%;
}

.cal-month {
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
  padding: 8rpx 24rpx;
}

.cal-swipe-tip {
  padding: 8rpx 8rpx 28rpx;
  color: #9AA6B4;
  font-size: 20rpx;
  text-align: center;
}

.cal-card {
  margin-top: 16rpx;
  padding: 12rpx 8rpx;
  min-height: 700rpx; /* 保证加载中也有一块可滑动的区域 */
  box-sizing: border-box;
  overflow: hidden;
}

.cal-week {
  display: flex;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  color: #6B7C8A;
  font-size: 22rpx;
  padding: 8rpx 0;
}

.cal-head .cal-weekday {
  font-weight: 800;
  color: #3D4A54;
}

.cal-cell {
  flex: 1;
  min-width: 0;
  min-height: 116rpx;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #EEF2F5;
  border-left: 1rpx solid #F5F7F9;
}

.cal-day {
  font-weight: 800;
  font-size: 28rpx;
  color: #1C1C1C;
}

.cal-cell.today {
  background: #EAF4FF;
  border-radius: 8rpx;
}

.cal-cell.today .cal-day {
  color: #087CFF;
}

.cal-low {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #0E8A5F;
  line-height: 1.3;
}

.cal-high {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #E64340;
  line-height: 1.3;
}

.cal-hint {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #C77F00;
  line-height: 1.2;
}
