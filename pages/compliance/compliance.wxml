<view class="page">
  <view class="page-content">
    <view class="card list-card">
      <view class="list-title">{{doc.title}}</view>
      <view class="list-meta">最近更新：{{doc.updated}}</view>
      <view class="list-meta doc-intro">{{doc.intro}}</view>
    </view>

    <view class="card list-card" wx:for="{{doc.items}}" wx:key="title">
      <view class="list-title">{{item.title}}</view>
      <view class="doc-line" wx:for="{{item.lines}}" wx:key="label" wx:for-item="line">
        <text class="doc-label">{{line.label}}</text>
        <text class="doc-value">{{line.value}}</text>
      </view>
    </view>
  </view>
</view>

<watch-ball />
