<view class="community-page">
  <view class="card list-card user-head">
    <image class="author-avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
    <view class="author-meta">
      <view class="list-title">{{user.nickname}}</view>
      <view class="list-meta">Lv.{{user.level}} {{user.title}}</view>
      <view class="list-meta">笔记 {{user.noteCount}} ｜ 粉丝 {{user.followerCount}}</view>
    </view>
    <view class="btn" wx:if="{{!user.me}}" bindtap="onFollow">{{user.followed ? '已关注' : '关注'}}</view>
  </view>

  <view class="chip-row">
    <view class="chip {{tab === 'notes' ? 'active' : ''}}" data-tab="notes" bindtap="onTab">笔记</view>
    <view class="chip {{tab === 'favorites' ? 'active' : ''}}" data-tab="favorites" bindtap="onTab">收藏</view>
  </view>

  <view class="empty-tip" wx:if="{{!left.length && !right.length}}">这里还空着</view>
  <view class="waterfall">
    <view class="wf-col">
      <view class="note-card card" wx:for="{{left}}" wx:key="id" data-id="{{item.id}}" bindtap="openNote">
        <image class="note-cover" src="{{item.coverUrl}}" mode="aspectFill" style="height: {{item.coverHeight}}rpx;"></image>
        <view class="note-title">{{item.title}}</view>
      </view>
    </view>
    <view class="wf-col">
      <view class="note-card card" wx:for="{{right}}" wx:key="id" data-id="{{item.id}}" bindtap="openNote">
        <image class="note-cover" src="{{item.coverUrl}}" mode="aspectFill" style="height: {{item.coverHeight}}rpx;"></image>
        <view class="note-title">{{item.title}}</view>
      </view>
    </view>
  </view>
</view>
