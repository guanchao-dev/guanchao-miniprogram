.tutorial-page {
  padding-bottom: 60rpx;
}

.tutorial-intro {
  position: relative;
  z-index: 2;
  margin: 8rpx 6rpx 26rpx;
}

.tutorial-heading {
  font-size: 42rpx;
  font-weight: 850;
}

.tutorial-sub {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.video-card {
  position: relative;
  z-index: 2;
  margin-bottom: 22rpx;
  padding: 26rpx 24rpx;
}

.video-title {
  font-size: 32rpx;
  font-weight: 850;
}

.video-desc {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.video-box {
  width: 100%;
  height: 380rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #0E1621;
}

.video-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 260rpx;
  margin-top: 18rpx;
  border: 3rpx dashed #C9D4DE;
  border-radius: 16rpx;
  background: #F6F8FA;
}

.placeholder-mark {
  color: #6B7C8A;
  font-size: 28rpx;
  font-weight: 750;
}

.placeholder-text {
  margin-top: 8rpx;
  color: #9AA3AF;
  font-size: 22rpx;
}
