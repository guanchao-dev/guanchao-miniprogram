.tutorial-page {
  padding-bottom: 40rpx;
}

.tutorial-intro {
  position: relative;
  z-index: 2;
  margin: 8rpx 6rpx 24rpx;
}

.tutorial-heading {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0.5rpx;
  color: #1C1C1C;
}

.tutorial-sub {
  margin-top: 8rpx;
  color: #6B7C8A;
  font-size: 23rpx;
  line-height: 1.5;
}

.video-card {
  position: relative;
  z-index: 2;
  margin-bottom: 20rpx;
  padding: 22rpx;
}

.video-title {
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.video-desc {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 22rpx;
  line-height: 1.5;
}

.video-box {
  width: 100%;
  height: 380rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #0E1621;
  box-sizing: border-box;
}

.video-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 260rpx;
  margin-top: 16rpx;
  border: 3rpx dashed rgba(28, 28, 28, 0.24);
  border-radius: 16rpx;
  background: #FBF7EF;
  box-sizing: border-box;
}

.placeholder-mark {
  color: #4F6787;
  font-size: 26rpx;
  font-weight: 850;
}

.placeholder-text {
  margin-top: 8rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  line-height: 1.5;
}
