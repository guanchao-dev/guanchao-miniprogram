.species-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.species-cell {
  width: 48%;
  box-sizing: border-box;
  overflow: hidden;
  margin-bottom: 18rpx;
  /* NEW 角标要绝对定位到右上角，需要这层做定位父级 */
  position: relative;
}

/* 新获得：右上角一个 NEW。
   和金边（.unlocked）、呼吸光晕 + 扫光（.is-new）一起标识「这是刚拿到的」，
   进过一次图鉴后三者一起消失，只留静态金边。 */
.new-badge {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  padding: 4rpx 14rpx 6rpx;
  border-left: 3rpx solid #1C1C1C;
  border-bottom: 3rpx solid #1C1C1C;
  border-bottom-left-radius: 16rpx;
  background: #E8B84B;
  color: #1C1C1C;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.species-thumb {
  display: block;
  width: 100%;
  height: 200rpx;
  background: #F3FBFA;
}

.species-name {
  padding: 14rpx 18rpx 16rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

/* ===== 收集进度条 ===== */
.lit-progress {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.lit-progress-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: #E9EFED;
  overflow: hidden;
}

.lit-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #F6D081, #E8B84B);
}

.lit-progress-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #7A8A86;
  white-space: nowrap;
}

/* ===== 缩略图包裹层：扫光需要一个定位父级 ===== */
.species-thumb-wrap {
  position: relative;
  overflow: hidden;
}

/* ===== 未点亮：置灰 =====
   拆成两条声明：万一某些基础库不支持 filter，opacity 仍能兜底表达「未获得」。 */
.species-cell.locked .species-thumb {
  opacity: 0.45;
  filter: grayscale(1);
}

.species-cell.locked .species-name {
  color: #A8B3B0;
}

/* ===== 已点亮：静态金边 ===== */
.species-cell.unlocked {
  border: 3rpx solid #E8B84B;
}

/* ===== 新获得：在金边之上再加呼吸光晕 + 扫光，用来标识「这是刚拿到的」=====
   判定在服务端（species_unlocks.seen）：图鉴页展示过一次就标记为已看过，
   之后只保留上面的静态金边。 */
.species-cell.unlocked.is-new {
  animation: goldBreath 2.4s ease-in-out infinite;
}

@keyframes goldBreath {
  0%, 100% {
    box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85), 0 0 10rpx 2rpx rgba(246, 208, 129, 0.55);
  }
  50% {
    box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85), 0 0 26rpx 8rpx rgba(246, 208, 129, 0.95);
  }
}

/* 不灵不灵：一道斜光周期性扫过缩略图。只有「新获得」的才扫 */
.species-cell.unlocked.is-new .species-thumb-wrap::after {
  content: '';
  position: absolute;
  top: -60%;
  left: -80%;
  width: 55%;
  height: 220%;
  transform: rotate(18deg);
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  animation: shineSweep 2.8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes shineSweep {
  0% {
    left: -80%;
  }
  55% {
    left: 130%;
  }
  100% {
    left: 130%;
  }
}
