/* ===== 顶部搜索框 ===== */
.wiki-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  margin-bottom: 20rpx;
}

.wiki-search input {
  flex: 1;
  height: 78rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
  color: #1C1C1C;
  font-size: 24rpx;
  font-weight: 650;
}

.species-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.species-cell {
  width: 48%;
  box-sizing: border-box;
  overflow: hidden;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  /* NEW 角标要绝对定位到右上角，需要这层做定位父级 */
  position: relative;
}

/* 新获得：右上角一个 NEW，配合金边一起标识「这是刚拿到的」 */
.new-badge {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  padding: 4rpx 14rpx 6rpx;
  border-left: 3rpx solid #1C1C1C;
  border-bottom: 3rpx solid #1C1C1C;
  border-bottom-left-radius: 14rpx;
  background: #F6D081;
  color: #1C1C1C;
  font-size: 19rpx;
  font-weight: 850;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.species-thumb {
  display: block;
  width: 100%;
  height: 200rpx;
  background: #F3FBFA;
}

.species-name {
  padding: 14rpx 16rpx 16rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

/* ===== 收集进度条 ===== */
.lit-progress {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.lit-progress-track {
  flex: 1;
  height: 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  overflow: hidden;
}

.lit-progress-fill {
  height: 100%;
  background: #F6D081;
}

.lit-progress-text {
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #4F6787;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* ===== 缩略图包裹层 ===== */
.species-thumb-wrap {
  position: relative;
  overflow: hidden;
}

/* ===== 未点亮：置灰 =====
   拆成两条声明：万一某些基础库不支持 filter，opacity 仍能兜底表达「未获得」。 */
.species-cell.locked .species-thumb {
  opacity: 0.45;
  filter: grayscale(1);
}

.species-cell.locked .species-name {
  color: #9AA8B2;
}

/* ===== 已点亮：金边 ===== */
.species-cell.unlocked {
  border: 4rpx solid #E0A83A;
}

/* ===== 分类 + 抽卡入口 ===== */
.wiki-actions {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.wiki-actions .wiki-search {
  flex: 1;
  margin-bottom: 0;
}

/* 没有封面的新分类：用分类色块做卡片封面 */
.species-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.species-placeholder-cat {
  color: #4F6787;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.cat-physical {
  background: linear-gradient(135deg, #E4F2F5, #C6E0E6);
}

.cat-tech {
  background: linear-gradient(135deg, #E8F0EC, #CDDDD6);
}

.cat-other_marine {
  background: linear-gradient(135deg, #E9F0F2, #CCDFE4);
}


/* ===== 一级分类：大标签 + 下划线 ===== */
.primary-tabs-wrap {
  margin: 2rpx 0 0;
  border-bottom: 2rpx solid rgba(28, 28, 28, .12);
}

.primary-tabs {
  width: 100%;
  height: 80rpx;
  white-space: nowrap;
}

.primary-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-bottom: 4rpx solid transparent;
  color: #6B7C8A;
  font-size: 25rpx;
  font-weight: 800;
}

.primary-tab.active {
  border-bottom-color: #34B8C5;
  color: #1C1C1C;
  font-weight: 900;
}

/* ===== 二级分类：缩进 + 左竖线 + 小标签 ===== */
.sub-panel {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 16rpx 0 0 20rpx;
  padding: 12rpx 12rpx 12rpx 16rpx;
  border-left: 4rpx solid #34B8C5;
  border-radius: 0 16rpx 16rpx 0;
  background: #F3FBFA;
}

.sub-label {
  flex-shrink: 0;
  padding-top: 8rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.sub-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.sub-tab {
  padding: 7rpx 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #4F6787;
  font-size: 22rpx;
  font-weight: 750;
}

.sub-tab.active {
  background: #34B8C5;
  color: #FFFFFF;
  font-weight: 800;
}

/* ===== 层级面包屑 ===== */
.breadcrumb {
  margin: 14rpx 4rpx 10rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 650;
}

.breadcrumb-current {
  color: #1C1C1C;
  font-weight: 800;
}
