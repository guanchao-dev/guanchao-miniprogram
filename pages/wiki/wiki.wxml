<view class="page">
  <view class="page-content">
    <view class="wiki-actions">
      <view class="card wiki-search">
        <input placeholder="搜索图鉴生物" value="{{keyword}}" bindinput="onInput" confirm-type="search" bindconfirm="onSearch" />
        <view class="btn" bindtap="onSearch" hover-class="tap">搜索</view>
      </view>
    </view>
    <view class="primary-tabs-wrap">
      <scroll-view class="primary-tabs" scroll-x enable-flex>
        <view class="primary-tab {{group === item.id ? 'active' : ''}}" wx:for="{{cats}}" wx:key="id" data-id="{{item.id}}" bindtap="onCat" hover-class="tap">{{item.name}}</view>
      </scroll-view>
    </view>

    <view class="sub-panel" wx:if="{{group === 'forage'}}">
      <view class="sub-label">细分</view>
      <view class="sub-tabs">
        <view class="sub-tab {{category === item.id ? 'active' : ''}}" wx:for="{{subCats}}" wx:key="id" data-id="{{item.id}}" bindtap="onSubCat" hover-class="tap">{{item.name}}</view>
      </view>
    </view>

    <view class="breadcrumb">
      图鉴 / <text class="breadcrumb-current">{{currentGroupName}}</text><text wx:if="{{currentSubName}}"> / {{currentSubName}}</text>
    </view>
    <!-- 收集进度：识别并确认过的物种才会点亮 -->
    <view class="lit-progress" wx:if="{{totalCount > 0}}">
      <view class="lit-progress-track">
        <view class="lit-progress-fill" style="width: {{litCount / totalCount * 100}}%"></view>
      </view>
      <text class="lit-progress-text">已点亮 {{litCount}} / {{totalCount}}</text>
    </view>

    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>
    <view class="empty-tip" wx:elif="{{!list.length}}">{{emptyText}}</view>
    <view class="species-grid">
      <view class="species-cell card {{item.lit ? 'unlocked' : 'locked'}} {{item.isNew ? 'is-new' : ''}}" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail" hover-class="tap">
        <!-- 新获得：右上角一个 NEW，配合金边与闪光一起标识 -->
        <view class="new-badge" wx:if="{{item.isNew}}">NEW</view>
        <view class="species-thumb-wrap">
          <image wx:if="{{item.coverSrc}}" class="species-thumb" src="{{item.coverSrc}}" mode="aspectFill"></image>
          <view wx:else class="species-thumb species-placeholder cat-{{item.category}}">
            <text class="species-placeholder-cat">{{item.categoryName}}</text>
          </view>
        </view>
        <view class="species-name">{{item.name}}</view>
      </view>
    </view>
  </view>
</view>

<watch-ball />
