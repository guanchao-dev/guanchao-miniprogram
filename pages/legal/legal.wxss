.legal-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.legal-row.tap {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

.legal-main {
  flex: 1;
  min-width: 0;
}

.legal-title {
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
  color: #1C1C1C;
}

.legal-desc {
  margin-top: 8rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  line-height: 1.5;
}

.legal-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(28, 28, 28, 0.06);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
  color: #6B7C8A;
}
