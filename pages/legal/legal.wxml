    <view class="geo-circle md" style="top: 30rpx; right: -40rpx; background:#F6D081;"></view>
  </view>

  <view class="page-content">
    <view class="card legal-row" bindtap="openDoc" data-type="agreement" hover-class="tap">
      <view class="legal-main">
        <view class="legal-title">用户协议</view>
        <view class="legal-desc">使用追潮记的规则与约定</view>
      </view>
      <text class="legal-arrow">›</text>
    </view>

    <view class="card legal-row" bindtap="openDoc" data-type="privacy" hover-class="tap">
      <view class="legal-main">
        <view class="legal-title">隐私政策</view>
        <view class="legal-desc">我们如何收集与保护你的信息</view>
      </view>
      <text class="legal-arrow">›</text>
    </view>

    <view class="card legal-row" bindtap="openDoc" data-type="children" hover-class="tap">
      <view class="legal-main">
        <view class="legal-title">儿童个人信息保护规则</view>
        <view class="legal-desc">未满 14 周岁儿童的信息保护</view>
