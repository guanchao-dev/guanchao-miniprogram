<view class="page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle md" style="top: 30rpx; right: -40rpx; background:#F6D081;"></view>
  </view>

  <view class="page-content">
    <view class="card edit-card" wx:if="{{!loggedIn}}">
      <view class="list-title">还没有登录</view>
      <view class="edit-hint">登录后才能修改头像和昵称。</view>
      <view class="btn full-btn" bindtap="goLogin">去登录</view>
    </view>

    <block wx:else>
      <view class="card edit-card edit-avatar-card">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="edit-avatar" src="{{avatarPreview}}" mode="aspectFill"></image>
          <view class="edit-avatar-tip">换个头像</view>
        </button>
        <view class="edit-level" wx:if="{{levelText}}">{{levelText}}</view>
      </view>

      <view class="card edit-card">
        <view class="list-title">昵称</view>
        <input
          class="edit-input"
          type="nickname"
          maxlength="20"
          value="{{nickname}}"
          placeholder="给自己起个赶海名号"
          placeholder-class="edit-placeholder"
          bindinput="onNickname"
        />
        <view class="edit-hint">头像来自微信授权选择，昵称保存后展示在个人主页。</view>
      </view>

      <view class="btn full-btn edit-save" bindtap="onSave">{{saving ? '保存中…' : '保存'}}</view>
    </block>
  </view>
</view>

<watch-ball />
