<view class="page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle md" style="top: 30rpx; right: -40rpx; background:#F6D081;"></view>
    <view class="geo-square" style="top: 200rpx; left: -30rpx; background:#34B8C5;"></view>
  </view>

  <view class="page-content">
    <view class="card edit-card" wx:if="{{!loggedIn}}">
      <view class="list-title">还没有登录</view>
      <view class="edit-hint">登录后才能修改头像和昵称。</view>
      <view class="btn full-btn" bindtap="goLogin" hover-class="tap">去登录</view>
    </view>

    <block wx:else>
      <!-- 头像区 -->
      <view class="edit-card edit-avatar-card">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="edit-avatar" src="{{avatarPreview}}" mode="aspectFill"></image>
          <view class="edit-avatar-tip">换个头像</view>
        </button>
        <view class="edit-level" wx:if="{{levelText}}">🌊 {{levelText}}</view>
      </view>

      <!-- 昵称区 -->
      <view class="edit-card nickname-card">
        <view class="nickname-row">
          <text class="nickname-label">昵称：</text>
          <input
            class="edit-input"
            type="nickname"
            maxlength="20"
            value="{{nickname}}"
            placeholder="给自己起个赶海名号"
            placeholder-class="edit-placeholder"
            bindinput="onNickname"
          />
        </view>
      </view>

      <!-- 保存按钮 -->
      <view class="btn full-btn edit-save" bindtap="onSave" hover-class="tap">
        <text>{{saving ? '保存中…' : '保存资料'}}</text>
      </view>
    </block>
  </view>
</view>

<watch-ball />
