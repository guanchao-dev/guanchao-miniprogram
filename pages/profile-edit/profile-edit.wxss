.edit-card {
  position: relative;
  z-index: 2;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 头像卡片 */
.edit-avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx 28rpx;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  margin: 0 auto;
  border: none;
  background: transparent;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.edit-avatar {
  display: block;
  width: 160rpx;
  height: 160rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--ink);
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.edit-avatar-tip {
  width: auto;
  margin-top: 14rpx;
  padding: 5rpx 16rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: #F6D081;
  color: var(--ink);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.4;
}

.edit-level {
  margin-top: 14rpx;
  padding: 6rpx 18rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: #34B8C5;
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.4;
}

/* 昵称卡片：外层不带框，输入框自带描边并与上下卡片对齐 */
.nickname-card {
  padding: 24rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  height: 88rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--ink);
  border-radius: 16rpx;
  background: #FFFFFF;
  overflow: hidden;
}

.nickname-label {
  flex-shrink: 0;
  padding-left: 20rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 800;
}

.edit-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 20rpx 0 8rpx;
  border: none;
  background: transparent;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  text-align: left;
}

.edit-placeholder {
  color: #9AA8B2;
  font-weight: 500;
}

.edit-hint {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.6;
}

/* 未登录卡片里的「去登录」：与首页主操作同色 */
.edit-card .full-btn {
  height: 84rpx;
  margin-top: 20rpx;
  border-width: 4rpx;
  background: #F6D081;
  color: var(--ink);
  font-weight: 850;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

/* 保存按钮 */
.edit-save {
  height: 88rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--ink);
  border-radius: 999rpx;
  background: #34B8C5;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
}

.edit-save:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}
