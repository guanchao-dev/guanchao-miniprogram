.edit-card {
  position: relative;
  z-index: 2;
  margin-bottom: 24rpx;
}

/* 头像卡片 */
.edit-avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 24rpx 30rpx;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  margin: 0 auto;
  border: none;
  background: transparent;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.edit-avatar {
  display: block;
  width: 160rpx;
  height: 160rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  box-sizing: border-box;
}

.edit-avatar-tip {
  margin-top: 14rpx;
  padding: 4rpx 16rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F6D081;
  color: #1C1C1C;
  font-size: 22rpx;
  font-weight: 800;
  width: auto;
}

.edit-level {
  margin-top: 16rpx;
  padding: 6rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #34B8C5;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 850;
}

/* 昵称卡片：去掉外层框，内层框与上方对齐 */
.nickname-card {
  padding: 0 24rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #F7FCFF;
  box-shadow: inset 2rpx 2rpx 0 rgba(28, 28, 28, 0.06);
  overflow: hidden;
}

.nickname-label {
  flex-shrink: 0;
  padding: 0 16rpx 0 20rpx;
  font-size: 28rpx;
  font-weight: 850;
  color: #1C1C1C;
}

.edit-input {
  flex: 1;
  min-width: 0;
  padding: 18rpx 20rpx 18rpx 0;
  border: none;
  background: transparent;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.edit-placeholder {
  color: #9AA6B4;
  font-weight: 500;
}

.edit-hint {
  margin-top: 14rpx;
  color: #6B7C8A;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 保存按钮 */
.edit-save {
  margin-top: 12rpx;
  padding: 22rpx 0;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #34B8C5;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  font-size: 30rpx;
  font-weight: 900;
  color: #FFFFFF;
  text-align: center;
}

.edit-save:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}
