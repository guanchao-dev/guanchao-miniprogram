.edit-card {
  position: relative;
  z-index: 2;
}

.edit-avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 24rpx 30rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  box-sizing: border-box;
}

.edit-avatar-tip {
  margin-top: 14rpx;
  padding: 4rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F6D081;
  color: #1C1C1C;
  font-size: 22rpx;
  font-weight: 800;
}

.edit-level {
  margin-top: 16rpx;
  padding: 4rpx 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #D6EEF8;
  color: #1C1C1C;
  font-size: 22rpx;
  font-weight: 800;
}

.edit-input {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #F7FCFF;
  font-size: 28rpx;
  font-weight: 700;
}

.edit-placeholder {
  color: #9AA6B4;
  font-weight: 500;
}

.edit-hint {
  margin-top: 12rpx;
  color: #6B7C8A;
  font-size: 22rpx;
  line-height: 1.6;
}

.edit-save {
  margin-top: 32rpx;
}
