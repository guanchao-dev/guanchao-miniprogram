.explore-page {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: 24rpx;
}

.explore-bar {
  position: relative;
  z-index: 2;
  padding: 20rpx 24rpx 16rpx;
}

.explore-title {
  font-size: 36rpx;
  font-weight: 850;
}

.explore-meta {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 24rpx;
}

.btn-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.btn.ghost {
  background: #FFFFFF;
}

.btn.danger {
  background: #1878FF;
  color: #FFFFFF;
}

.hint {
  margin-top: 12rpx;
  color: #8A7A6B;
  font-size: 20rpx;
  line-height: 1.45;
}

.explore-map {
  width: 100%;
  height: 62vh;
  display: block;
}

.result-card {
  margin: 16rpx 24rpx 0;
  padding: 22rpx;
}
