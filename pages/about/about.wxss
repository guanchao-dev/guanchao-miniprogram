/* Hero 品牌区 */
.about-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 56rpx 24rpx 40rpx;
  background: linear-gradient(160deg, #EAF7FB 0%, #DDF3F6 55%, #FBE4E1 100%);
  overflow: hidden;
}

/* 上浮气泡 */
.hero-bubbles {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.hb {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.95), rgba(52, 184, 197, 0.3));
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  opacity: 0;
  animation: heroRise linear infinite;
}

.hb.b1 { left: 9%; bottom: -40rpx; width: 26rpx; height: 26rpx; animation-duration: 9s; }
.hb.b2 { left: 26%; bottom: -60rpx; width: 16rpx; height: 16rpx; animation-duration: 12s; animation-delay: 1.5s; }
.hb.b3 { left: 62%; bottom: -50rpx; width: 34rpx; height: 34rpx; animation-duration: 11s; animation-delay: 0.8s; }
.hb.b4 { left: 82%; bottom: -40rpx; width: 20rpx; height: 20rpx; animation-duration: 8s; animation-delay: 2.4s; }
.hb.b5 { left: 46%; bottom: -70rpx; width: 14rpx; height: 14rpx; animation-duration: 14s; animation-delay: 3s; }

@keyframes heroRise {
  0% { transform: translateY(0) scale(0.8); opacity: 0; }
  15% { opacity: 0.75; }
  100% { transform: translateY(-420rpx) scale(1.05); opacity: 0; }
}

/* 品牌图标 */
.about-logo {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 5rpx 5rpx 0 rgba(28, 28, 28, 0.85);
}

.about-mascot {
  width: 158rpx;
  height: 158rpx;
}

.about-name {
  position: relative;
  z-index: 2;
  margin-top: 26rpx;
  font-size: 52rpx;
  font-weight: 900;
  color: #14324A;
  letter-spacing: 6rpx;
}

.about-slogan {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  color: #1888BF;
  font-size: 26rpx;
  font-weight: 700;
}

.about-tags {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 22rpx;
}

.about-tag {
  padding: 8rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 22rpx;
  font-weight: 750;
  color: #1C1C1C;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}

/* 通用区块 */
.about-section {
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.label-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34B8C5;
  border: 2rpx solid #1C1C1C;
}

.section-label text:last-child {
  font-size: 30rpx;
  font-weight: 850;
  color: #1C1C1C;
}

.about-text {
  color: #4F6787;
  font-size: 26rpx;
  line-height: 1.75;
}

/* 意见反馈 */
.feedback-box {
  margin-top: 16rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 18rpx;
  background: #F7FCFF;
  overflow: hidden;
}

.feedback-input {
  display: block;
  width: 100%;
  height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1C1C1C;
}

.contact-input {
  width: 100%;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(28, 28, 28, 0.1);
  font-size: 26rpx;
  color: #1C1C1C;
}

.feedback-ph {
  color: #9AA6B4;
}

.about-submit {
  background: #34B8C5;
  color: #FFFFFF;
}

/* 页脚 */
.about-copy {
  margin-top: 20rpx;
  color: #9AA6B4;
  font-size: 20rpx;
  text-align: center;
}

.about-copy + .about-copy {
  margin-top: 6rpx;
}
