.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
}

.fallback-card {
  width: 100%;
  padding: 48rpx 36rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  text-align: center;
}

.fallback-emoji {
  display: block;
  font-size: 72rpx;
  line-height: 1;
}

.fallback-title {
  display: block;
  margin-top: 20rpx;
  color: #1C1C1C;
  font-size: 32rpx;
  font-weight: 850;
}

.fallback-tip {
  display: block;
  margin-top: 16rpx;
  color: #4F6787;
  font-size: 24rpx;
  line-height: 1.6;
}

.fallback-btn {
  margin-top: 28rpx;
  height: 76rpx;
  line-height: 70rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F6D081;
  color: #1C1C1C;
  font-size: 28rpx;
  font-weight: 800;
}

.fallback-btn.ghost {
  margin-top: 16rpx;
  background: #FFFFFF;
  color: #4F6787;
}
