<view class="page">
  <view class="page-content">
    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>
    <view class="empty-tip" wx:elif="{{!list.length}}">暂无点位，请稍后重试</view>
    <view class="card list-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="list-title">{{item.name}}</view>
      <view class="list-meta">{{item.city}} {{item.distanceText}}</view>
      <view class="list-meta">{{item.openTime}}</view>
      <view class="chip-row" wx:if="{{item.safetyTags.length}}">
        <text class="chip" wx:for="{{item.safetyTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
    </view>
  </view>
</view>

<watch-ball />
