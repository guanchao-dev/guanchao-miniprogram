<view class="page">
  <view class="page-content">
    <!-- 宝藏地点入口：用户分享、审核通过的点位 -->
    <view class="card treasure-entry" bindtap="goTreasure" hover-class="tap">
      <view class="treasure-entry-main">
        <view class="treasure-entry-title">宝藏地点</view>
        <view class="treasure-entry-sub">看看大家发现的赶海好去处</view>
      </view>
      <view class="treasure-entry-arrow">›</view>
    </view>

    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>
    <view class="empty-tip" wx:elif="{{!list.length}}">暂无点位，请稍后重试</view>
    <view class="card list-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail" hover-class="tap">
      <view class="list-title">{{item.name}}</view>
      <view class="list-meta">{{item.city}} {{item.distanceText}}</view>
      <view class="list-meta">{{item.openTime}}</view>
      <view class="chip-row" wx:if="{{item.safetyTags.length}}">
        <text class="chip" wx:for="{{item.safetyTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
    </view>
  </view>
</view>

<watch-ball />
