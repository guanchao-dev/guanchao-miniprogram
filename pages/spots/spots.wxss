/* 宝藏地点入口卡片 */
.treasure-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 26rpx 24rpx;
  background: var(--yellow);
}
.treasure-entry-main {
  flex: 1;
  min-width: 0;
}
.treasure-entry-title {
  font-size: 32rpx;
  font-weight: 850;
}
.treasure-entry-sub {
  margin-top: 6rpx;
  color: rgba(28, 28, 28, 0.62);
  font-size: 22rpx;
}
.treasure-entry-arrow {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}
.treasure-entry:active {
  transform: translate(2rpx, 2rpx);
}
