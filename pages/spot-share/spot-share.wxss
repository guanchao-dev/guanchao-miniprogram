.hero {
  padding: 24rpx 8rpx 28rpx;
}
.hero-title {
  color: #1C1C1C;
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.2;
}
.hero-sub {
  margin-top: 10rpx;
  color: #6B7C8A;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.55;
}

.card {
  border: 4rpx solid #1C1C1C;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  margin-bottom: 24rpx;
}

.field-card {
  padding: 24rpx;
}

.field-label {
  margin-bottom: 14rpx;
  color: #6B7C8A;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.field-input {
  font-size: 26rpx;
  font-weight: 650;
  padding: 16rpx 4rpx;
  border-bottom: 2rpx dashed rgba(28, 28, 28, 0.2);
}

.field-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.55;
  padding: 10rpx 4rpx;
  border-bottom: 2rpx dashed rgba(28, 28, 28, 0.2);
  box-sizing: border-box;
}

/* 选点 */
.place-pick {
  padding: 20rpx 16rpx;
  border: 3rpx dashed rgba(28, 28, 28, 0.2);
  border-radius: 18rpx;
  background: #FBF7EF;
}
.place-pick:active { background: #F3EBDC; }
.place-name {
  font-size: 28rpx;
  font-weight: 850;
  color: #1C1C1C;
}
.place-addr {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 21rpx;
}
.place-coord {
  margin-top: 8rpx;
  color: #1888BF;
  font-size: 19rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.place-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #6B7C8A;
  font-size: 24rpx;
  padding: 14rpx 0;
}
.place-empty-icon { font-size: 32rpx; }

.place-map {
  width: 100%;
  height: 320rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  border: 3rpx solid #1C1C1C;
}

/* 照片九宫格（1~3 张，风格沿用上面的虚线框） */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.photo-item {
  position: relative;
  width: 190rpx;
  height: 190rpx;
}
.photo-thumb {
  width: 100%;
  height: 100%;
  border: 3rpx solid rgba(28, 28, 28, 0.16);
  border-radius: 18rpx;
}
.photo-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 2rpx solid #FFFFFF;
  border-radius: 50%;
  background: #D9463F;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-align: center;
}
.photo-add {
  width: 190rpx;
  height: 190rpx;
  border: 3rpx dashed rgba(28, 28, 28, 0.2);
  border-radius: 18rpx;
  background: #FBF7EF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add:active { background: #F3EBDC; }
.photo-add-icon {
  color: #6B7C8A;
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1;
}
.field-tip {
  margin-top: 14rpx;
  color: #6B7C8A;
  font-size: 20rpx;
  font-weight: 700;
}

/* 提交按钮 */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 12rpx;
  box-sizing: border-box;
  background: #34B8C5;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 850;
  border: 4rpx solid #1C1C1C;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  letter-spacing: 1rpx;
}
.submit-btn::after { border: none; }
.submit-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}
.submit-btn.disabled {
  background: #9AA8B2;
  border-color: #9AA8B2;
  color: #FFFFFF;
  box-shadow: none;
}
