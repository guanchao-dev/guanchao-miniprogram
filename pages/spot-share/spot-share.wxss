.hero {
  padding: 24rpx 8rpx 32rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 850;
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.card {
  border: 3rpx solid var(--ink);
  border-radius: 28rpx;
  background: var(--card);
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

.field-card {
  padding: 26rpx 26rpx 30rpx;
}

.field-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--muted);
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.field-input {
  font-size: 30rpx;
  padding: 14rpx 4rpx;
  border-bottom: 2rpx dashed rgba(28,28,28,0.25);
}

.field-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  line-height: 1.55;
  padding: 8rpx 4rpx;
  border-bottom: 2rpx dashed rgba(28,28,28,0.25);
  box-sizing: border-box;
}

/* 选点 */
.place-pick {
  padding: 22rpx 16rpx;
  border: 2rpx dashed rgba(28,28,28,0.4);
  border-radius: 18rpx;
  background: #F7FBFD;
}
.place-pick:active { background: #EDF5F8; }
.place-name {
  font-size: 32rpx;
  font-weight: 850;
}
.place-addr {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 24rpx;
}
.place-coord {
  margin-top: 8rpx;
  color: var(--blue);
  font-size: 22rpx;
  font-family: monospace;
}
.place-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
  padding: 14rpx 0;
}
.place-empty-icon { font-size: 36rpx; }

.place-map {
  width: 100%;
  height: 320rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--ink);
}

/* 现场照片（1~3 张） */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.photo-cell,
.photo-add {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.photo-cell {
  border: 2rpx solid var(--ink);
}
.photo-cell-img { width: 100%; height: 100%; }
.photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(28,28,28,0.72);
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 42rpx;
  text-align: center;
}
.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx dashed rgba(28,28,28,0.4);
  background: #F7FBFD;
  color: var(--muted);
}
.photo-add:active { background: #EDF5F8; }
.photo-add-icon { font-size: 52rpx; line-height: 1; }
.photo-add-tip { font-size: 22rpx; }
.photo-count {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 22rpx;
  text-align: right;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 12rpx;
  background: var(--teal);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  border: 3rpx solid var(--ink);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
  letter-spacing: 2rpx;
}
.submit-btn::after { border: none; }
.submit-btn.disabled {
  background: #C8D2DA;
  color: rgba(255,255,255,0.85);
  box-shadow: 2rpx 2rpx 0 rgba(28,28,28,0.4);
}
