.profile-page {
  min-height: 100vh;
  background: #FFFFFF;
  position: relative;
  overflow: hidden;
}

.profile-hero {
  position: relative;
  z-index: 2;
  padding: 36rpx 28rpx 10rpx;
  overflow: hidden;
}

.user-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.user-meta {
  flex: 1;
  margin-left: 22rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 850;
}

.level-pill {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #1888BF;
  color: #fff;
  font-size: 22rpx;
  font-weight: 750;
}

.stats {
  display: flex;
  margin-top: 28rpx;
  padding: 22rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
  border-right: 3rpx solid #1C1C1C;
}

.stat:last-child {
  border-right: 0;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 850;
  color: #184D97;
}

.stat-label {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 20rpx;
}

.profile-body {
  min-height: auto;
  padding-top: 8rpx;
  background: transparent;
}

.record-card {
  display: flex;
  flex-wrap: nowrap;
  justify-content: flex-start;
  padding: 22rpx 8rpx 18rpx;
}

.record {
  width: 25%;
  margin-bottom: 0;
  text-align: center;
  font-size: 18rpx;
  font-weight: 700;
}

.record-icon {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto 10rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 22rpx;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  overflow: hidden;
}

.record-icon image {
  width: 100%;
  height: 100%;
}

.record-icon.mint { background: #D8F4EE; }
.record-icon.sky { background: #D6EEF8; }
.record-icon.yellow { background: #FBECC8; }
.record-icon.pink { background: #E4F2FF; }

.menu-card {
  padding: 0 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 0 16rpx;
  border-bottom: 3rpx solid #E8EEF2;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item image {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #F6E9D3;
}

.menu-item text {
  flex: 1;
  margin-left: 18rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.arrow {
  flex: none !important;
  margin-left: 0 !important;
  color: #6B7C8A;
  font-size: 40rpx;
}

.version {
  margin-top: 36rpx;
  color: #6B7C8A;
  font-size: 20rpx;
  text-align: center;
}
