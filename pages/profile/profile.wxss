.profile-page {
  min-height: 100vh;
  background: #FFFFFF;
  position: relative;
  overflow: hidden;
}

.profile-hero {
  position: relative;
  z-index: 2;
  padding: 36rpx 28rpx 10rpx;
  overflow: hidden;
}

.user-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.user-meta {
  flex: 1;
  margin-left: 22rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 850;
}

.level-pill {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #1888BF;
  color: #fff;
  font-size: 22rpx;
  font-weight: 750;
}

.profile-body {
  min-height: auto;
  padding-top: 8rpx;
  background: transparent;
}

.record-banner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F2FCF9, #D8F4EE);
}

.record-banner-deco {
  position: absolute;
  right: -36rpx;
  top: -36rpx;
  width: 150rpx;
  height: 150rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: rgba(52, 184, 197, 0.25);
}

.record-banner-icon {
  position: relative;
  z-index: 1;
  width: 108rpx;
  height: 108rpx;
  flex-shrink: 0;
  border: 3rpx solid #1C1C1C;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  overflow: hidden;
}

.record-banner-icon image {
  width: 100%;
  height: 100%;
}

.record-banner-copy {
  position: relative;
  z-index: 1;
  flex: 1;
}

.record-banner-desc {
  display: block;
  color: #3D4A54;
  font-size: 26rpx;
  font-weight: 650;
}

.record-banner-arrow {
  position: relative;
  z-index: 1;
  color: #1888BF;
  font-size: 44rpx;
  font-weight: 300;
}

.service-icon.mint { background: #D8F4EE; }
.service-icon.sky { background: #D6EEF8; }
.service-icon.yellow { background: #FBECC8; }
.service-icon.pink { background: #E4F2FF; }

.service-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 8rpx 12rpx;
}

.service-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.service-icon {
  width: 92rpx;
  height: 92rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 24rpx;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  overflow: hidden;
}

.service-icon image {
  width: 100%;
  height: 100%;
}

.service-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #1C1C1C;
}

.compliance-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx 20rpx;
  margin-top: 28rpx;
  padding: 0 12rpx;
}

.compliance-link {
  color: #087CFF;
  font-size: 22rpx;
  font-weight: 650;
}

.version {
  margin-top: 36rpx;
  color: #6B7C8A;
  font-size: 20rpx;
  text-align: center;
}
