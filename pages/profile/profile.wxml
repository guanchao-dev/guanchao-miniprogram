<view class="profile-page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle lg" style="top: 20rpx; right: -50rpx; background:#34B8C5;"></view>
    <view class="geo-star lg" style="bottom: 200rpx; left: -30rpx;"></view>
    <!-- 气泡背景：呼应吉祥物"泡泡"，从底部缓慢上浮 -->
    <view class="bubble-layer">
      <view class="bubble b1"></view>
      <view class="bubble b2"></view>
      <view class="bubble b3"></view>
      <view class="bubble b4"></view>
      <view class="bubble b5"></view>
      <view class="bubble b6"></view>
      <view class="bubble b7"></view>
      <view class="bubble b8"></view>
      <view class="bubble b9"></view>
      <view class="bubble b10"></view>
      <view class="bubble b11"></view>
      <view class="bubble b12"></view>
      <view class="bubble b13"></view>
      <view class="bubble b14"></view>
    </view>
  </view>

  <view class="page-content">
    <view class="profile-hero">
      <view class="user-row" bindtap="goLogin" hover-class="tap">
        <image class="avatar" src="{{user.avatar}}" mode="aspectFit" catchtap="goEditProfile"></image>
        <view class="user-meta">
          <view class="user-name">{{user.name}}</view>
          <view class="level-pill">{{user.level}}</view>
        </view>
        <!-- 消息 / 设置：管理员回复与账号入口。catchtap 避免触发整行的 goLogin -->
        <view class="profile-actions">
          <view class="bell-btn" catchtap="goNotifications" hover-class="tap">
            <view class="bell-icon"></view>
            <text class="bell-dot" wx:if="{{unread > 0}}">{{unread > 99 ? '99+' : unread}}</text>
          </view>
          <view class="bell-btn" catchtap="goSettings" hover-class="tap">
            <view class="gear-icon"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="page profile-body">
      <!-- 赶海足迹：次数 / 生物 / 天数 -->
      <view class="stat-card card">
        <view class="stat-cell">
          <text class="stat-num">{{stats.watchCount}}</text>
          <text class="stat-label">赶海次数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-cell">
          <text class="stat-num">{{stats.speciesCount}}</text>
          <text class="stat-label">识别生物</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-cell">
          <text class="stat-num">{{stats.dayCount}}</text>
          <text class="stat-label">记录天数</text>
        </view>
      </view>

      <view class="section-head">
        <view class="section-head-main">
          <view class="title-dot"></view>
          <text class="section-title">我的服务</text>
        </view>
      </view>
      <view class="service-grid card">
        <view
          class="service-item {{item.gold ? 'gold' : ''}}"
          wx:for="{{services}}"
          wx:key="title"
          id="{{item.title === '宝藏点位' ? 'onb-spot-entry' : ''}}"
          data-url="{{item.url}}"
          data-tab="{{item.tab}}"
          data-action="{{item.action}}"
          bindtap="onService"
         hover-class="tap">
          <view class="service-icon {{item.tone}}">
            <image src="{{item.icon}}" mode="aspectFit"></image>
          </view>
          <text class="service-label">{{item.title}}</text>
        </view>
      </view>

      <view class="profile-footer">
        <view class="footer-rule"></view>
        <text class="footer-text">追潮记 · 和泡泡一起赶海</text>
      </view>
    </view>
  </view>
  <unlock-popup id="unlockPopup"></unlock-popup>
</view>

<onboarding
  visible="{{showOnboarding}}"
  start-index="{{onbStartIndex}}"
  target-rect="{{onbRect}}"
  bind:finish="onOnboardingFinish"
  bind:locate="onOnboardingLocate"
/>

<watch-ball />
