<view class="page">
  <view class="page-content">
    <view class="card list-card">
      <view class="list-title">照片（1-9）</view>
      <view class="photo-row">
        <image class="photo" wx:for="{{photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="removePhoto"></image>
        <view class="photo add" wx:if="{{photos.length < 9}}" bindtap="addPhoto">＋</view>
      </view>
      <view class="list-meta">点已选照片可移除</view>

      <view class="field-label">标题</view>
      <input class="input" value="{{title}}" maxlength="30" placeholder="4-30 个字，说说你看见了什么" bindinput="onTitle" />

      <view class="field-label">观察</view>
      <textarea class="note" value="{{content}}" maxlength="1000" placeholder="至少 10 个字。只写观察，不写学校和真实姓名。" bindinput="onContent"></textarea>

      <view class="field-label">话题（最多 3 个）</view>
      <view class="chip-row">
        <view
          class="chip {{item.on ? 'active' : ''}}"
          wx:for="{{topics}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTopic"
        >{{item.name}}</view>
      </view>

      <view class="list-meta">地点：{{place}}</view>
      <view class="btn full-btn" bindtap="onSubmit">{{submitting ? '发布中...' : '发布到社区'}}</view>
    </view>
  </view>
  <unlock-popup id="unlockPopup"></unlock-popup>
</view>
