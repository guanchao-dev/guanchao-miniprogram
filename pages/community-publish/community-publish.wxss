.photo-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 8rpx;
}

.photo,
.photo.add {
  width: 180rpx;
  height: 180rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #F3FBFA;
}

.photo.add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #6B7C8A;
}

.field-label {
  margin-top: 22rpx;
  font-size: 26rpx;
  font-weight: 750;
}

.input {
  margin-top: 10rpx;
  height: 72rpx;
  padding: 0 16rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
}
