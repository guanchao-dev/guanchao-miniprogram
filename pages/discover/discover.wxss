.discover-page {
  min-height: 100vh;
}

.form-card,
.result-card {
  padding: 28rpx;
}

.field-label {
  margin: 18rpx 0 10rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.photo-box {
  height: 320rpx;
  overflow: hidden;
  border: 3rpx solid #1C1C1C;
  border-radius: 22rpx;
  background: #F3FBFA;
}

.photo {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6B7C8A;
  font-size: 26rpx;
}

.photo-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.readonly,
.picker,
.input {
  min-height: 72rpx;
  padding: 0 20rpx;
  line-height: 72rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #FFFFFF;
  font-size: 26rpx;
}

.row {
  display: flex;
  gap: 16rpx;
}

.col {
  flex: 1;
}

.textarea {
  width: 100%;
  height: 140rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #FFFFFF;
  font-size: 26rpx;
}

.submit-btn {
  width: 100%;
  height: 84rpx;
  margin-top: 28rpx;
  background: #1878FF;
  color: #FFFFFF;
  box-sizing: border-box;
}

.result-cover {
  width: 100%;
  height: 360rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 22rpx;
  background: #F3FBFA;
}

.result-title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.result-meta,
.obs,
.safety,
.disc {
  margin-top: 10rpx;
  color: #4F6787;
  font-size: 24rpx;
  line-height: 1.55;
}

.obs-title {
  margin-top: 22rpx;
  font-size: 26rpx;
  font-weight: 850;
}

.safety {
  padding: 16rpx;
  border-radius: 16rpx;
  background: #FFF6E4;
  color: #8A5A12;
}

.disc {
  color: #8A7A6B;
  font-size: 20rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  background: #F6D081;
}

.share-btn {
  background: #1878FF;
  color: #FFFFFF;
}
