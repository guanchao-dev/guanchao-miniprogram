.discover-page {
  min-height: 100vh;
}

.form-card,
.result-card {
  padding: 24rpx;
}

/* 表单小标题：统一成弱色辅助字，让输入区成为主体 */
.field-label {
  margin: 18rpx 0 8rpx;
  color: var(--ink-soft);
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.form-card .field-label:first-child {
  margin-top: 0;
}

.photo-box {
  height: 320rpx;
  overflow: hidden;
  border: 3rpx solid var(--ink);
  border-radius: 20rpx;
  background: #F3FBFA;
}

.photo {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 25rpx;
  font-weight: 650;
}

.photo-hint {
  margin-top: 8rpx;
  color: #9AA8B2;
  font-size: 20rpx;
  font-weight: 650;
}

/* 输入控件统一 80rpx 高、3rpx 描边 */
.readonly,
.picker,
.input {
  height: 80rpx;
  padding: 0 18rpx;
  line-height: 74rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--ink);
  border-radius: 16rpx;
  background: #FFFFFF;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 650;
}

/* 只读项视觉可辨：不加描边高光，改成浅灰底 */
.readonly {
  background: #F5F6F7;
  color: var(--ink-soft);
}

.row {
  display: flex;
  gap: 16rpx;
}

.col {
  flex: 1;
  min-width: 0;
}

.textarea {
  width: 100%;
  height: 140rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--ink);
  border-radius: 16rpx;
  background: #FFFFFF;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.55;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 26rpx;
  border-width: 4rpx;
  background: #1888BF;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 850;
  box-sizing: border-box;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.result-cover {
  width: 100%;
  height: 340rpx;
  border: 3rpx solid var(--ink);
  border-radius: 20rpx;
  background: #F3FBFA;
}

.result-title {
  margin-top: 20rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.result-meta,
.obs,
.safety,
.disc {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.55;
}

.obs-title {
  margin-top: 20rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 800;
}

.obs {
  margin-top: 8rpx;
}

.safety {
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #FFF6E4;
  color: #8A5A12;
  font-size: 23rpx;
}

.disc {
  color: #8A7A6B;
  font-size: 20rpx;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-width: 4rpx;
  background: #F6D081;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 850;
}

.share-btn {
  background: #1888BF;
  color: #FFFFFF;
}
