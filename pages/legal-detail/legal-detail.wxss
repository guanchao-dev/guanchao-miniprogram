.doc-head {
  margin-bottom: 20rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(150deg, #F4FCFD 0%, #E4F6F8 100%);
}

.doc-title {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
  color: #14324A;
}

.doc-updated {
  margin-top: 8rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  line-height: 1.5;
}

.doc-body {
  padding: 28rpx 24rpx 36rpx;
}

.doc-summary {
  padding: 18rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #F7FCFF;
  color: #4F6787;
  font-size: 25rpx;
  line-height: 1.75;
}

.doc-section {
  margin-top: 28rpx;
}

.doc-heading {
  position: relative;
  padding-left: 24rpx;
  font-size: 30rpx;
  font-weight: 850;
  color: #14324A;
  line-height: 1.5;
}

.doc-heading::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  width: 12rpx;
  height: 26rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 5rpx;
  background: #34B8C5;
}

.doc-para {
  margin-top: 12rpx;
  color: #3C556B;
  font-size: 25rpx;
  line-height: 1.8;
}
