<view class="page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle md" style="top: 30rpx; right: -40rpx; background:#34B8C5;"></view>
  </view>

  <view class="page-content">
    <view class="card doc-head">
      <view class="doc-title">{{doc.title}}</view>
      <view class="doc-updated">最近更新：{{doc.updated}}</view>
    </view>

    <view class="card doc-body">
      <view class="doc-summary">{{doc.summary}}</view>
      <view class="doc-section" wx:for="{{doc.sections}}" wx:key="heading">
        <view class="doc-heading">{{item.heading}}</view>
        <view class="doc-para" wx:for="{{item.paragraphs}}" wx:for-item="para" wx:key="*this">{{para}}</view>
      </view>
    </view>
  </view>
</view>

<watch-ball />
