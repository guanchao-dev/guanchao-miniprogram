.add-page {
  background: #FBF6EA;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.step-body {
  padding-top: 8rpx;
}

.step-title {
  font-size: 44rpx;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.pick-tap { opacity: .78; }

.ai-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 24rpx 0 4rpx;
}

.ai-btn {
  padding: 22rpx;
  border: 0;
  border-radius: 14rpx;
  background: #2F7F86;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(47, 127, 134, .22);
}

.ai-btn.busy { opacity: .6; }

.meta-row {
  display: flex;
  gap: 12rpx;
  margin: 0 0 4rpx;
}

.mini-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(28, 28, 28, .12);
  border-radius: 12rpx;
  background: #fff;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.mini-btn.busy { opacity: .5; }
.mini-btn.active { background: #1C1C1C; color: #fff; }

.canvas-wrap {
  display: flex;
  justify-content: center;
  margin: 22rpx 0 18rpx;
}

.cut-canvas {
  display: block;
  border: 1rpx solid rgba(28, 28, 28, .16);
  border-radius: 14rpx;
  background: #0B2A38;
  box-shadow: 0 8rpx 20rpx rgba(28, 28, 28, .10);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action {
  flex: 1;
  padding: 22rpx 18rpx;
  border: 1rpx solid rgba(28, 28, 28, .16);
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.action.primary { background: #2F7F86; color: #fff; border-color: #2F7F86; }
.action.ghost { background: #fff; color: var(--ink); }
.action.disabled { opacity: .5; pointer-events: none; }

.sticker-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 340rpx;
  margin: 22rpx 0 22rpx;
  border: 1rpx solid rgba(28, 28, 28, .10);
  border-radius: 20rpx;
  background: linear-gradient(160deg, #F4FBFC, #E6F4F6 55%, #DCEFF2);
  box-shadow: 0 8rpx 20rpx rgba(28, 28, 28, .06);
  overflow: hidden;
}

.sticker-img {
  max-width: 82%;
  max-height: 320rpx;
  filter: drop-shadow(0 16rpx 18rpx rgba(5, 45, 65, .28));
}

.field-label {
  margin: 20rpx 0 10rpx;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 900;
}

.field-input {
  width: 100%;
  height: 96rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid rgba(28, 28, 28, .16);
  border-radius: 12rpx;
  background: #fff;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.field-placeholder {
  color: #A4B0B9;
  font-weight: 600;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(28, 28, 28, .16);
  border-radius: 10rpx;
  background: #fff;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.chip.active {
  background: #1C1C1C;
  color: #fff;
}

.size-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.size-slider {
  flex: 1;
  margin: 0;
}

.size-value {
  flex-shrink: 0;
  min-width: 76rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
  text-align: right;
}
