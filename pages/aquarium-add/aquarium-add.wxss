.add-page {
  background: #FBF7EF;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.step-body {
  padding-top: 8rpx;
}

.step-title {
  font-size: 46rpx;
  line-height: 1.15;
  font-weight: 900;
  letter-spacing: 0;
}

.pick-tap { opacity: .68; }

.ai-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 20rpx 0 4rpx;
}

.ai-btn {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 4rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F6D081;
  color: #1C1C1C;
  font-size: 27rpx;
  font-weight: 850;
  text-align: center;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.ai-btn.busy { opacity: .5; }

.meta-row {
  display: flex;
  gap: 12rpx;
  margin: 0 0 4rpx;
}

.mini-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #fff;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.mini-btn.busy { opacity: .5; }
.mini-btn.active { background: #34B8C5; color: #fff; }

.canvas-wrap {
  display: flex;
  justify-content: center;
  margin: 20rpx 0 16rpx;
}

.cut-canvas {
  display: block;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #0B2A38;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 4rpx solid #1C1C1C;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  font-size: 27rpx;
  font-weight: 850;
  text-align: center;
}

.action.primary { background: #F6D081; color: #1C1C1C; }
.action.ghost { background: #fff; color: var(--ink); }
.action.disabled { opacity: .5; pointer-events: none; }

.sticker-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 340rpx;
  margin: 20rpx 0;
  border: 3rpx solid rgba(28, 28, 28, .18);
  border-radius: 20rpx;
  background: linear-gradient(160deg, #F4FBFC, #E6F4F6 55%, #DCEFF2);
  overflow: hidden;
}

.sticker-img {
  max-width: 82%;
  max-height: 320rpx;
  filter: drop-shadow(0 16rpx 18rpx rgba(5, 45, 65, .28));
}

.field-label {
  margin: 20rpx 0 10rpx;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 850;
  letter-spacing: .5rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  line-height: 82rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #fff;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.field-placeholder {
  color: #9AA8B2;
  font-weight: 600;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #fff;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.chip.active {
  background: #34B8C5;
  color: #fff;
}

.size-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.size-slider {
  flex: 1;
  margin: 0;
}

.size-value {
  flex-shrink: 0;
  min-width: 84rpx;
  color: #4F6787;
  font-size: 22rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  text-align: right;
}
