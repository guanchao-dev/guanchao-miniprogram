<view class="page add-page">
  <view class="step-body" wx:if="{{step === 'edit'}}">
    <view class="step-title">抠图</view>

    <view class="ai-row">
      <view class="ai-btn {{aiBusy ? 'busy' : ''}}" bindtap="onAiCut" hover-class="pick-tap">{{aiBusy ? 'AI 抠图中…' : 'AI 自动抠图'}}</view>
    </view>

    <view class="canvas-wrap">
      <canvas
        type="2d"
        id="cutCanvas"
        class="cut-canvas"
        style="width:{{canvasW}}px;height:{{canvasH}}px;"
        disable-scroll="true"
        bindtouchstart="onTouchStart"
        catchtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
      ></canvas>
    </view>

    <view class="actions">
      <view class="action ghost" bindtap="onRetake" hover-class="pick-tap">重新选择照片</view>
      <view class="action primary" bindtap="onCut" hover-class="pick-tap">完成抠图</view>
    </view>
  </view>

  <view class="step-body" wx:if="{{step === 'preview'}}">
    <view class="step-title">预览与设置</view>

    <view class="sticker-stage">
      <image class="sticker-img" src="{{cutoutPath}}" mode="aspectFit" style="transform: rotate({{rotate}}deg) scaleX({{flipped ? -1 : 1}});"></image>
    </view>

    <view class="meta-row">
      <view class="mini-btn {{refineBusy ? 'busy' : ''}}" bindtap="onAiRefine" hover-class="pick-tap">{{refineBusy ? '精修中…' : 'AI 精修'}}</view>
      <view class="mini-btn {{flipped ? 'active' : ''}}" bindtap="onFlip" hover-class="pick-tap">水平翻转</view>
    </view>

    <view class="field-label">名称</view>
    <input
      class="field-input"
      value="{{name}}"
      bindinput="onName"
      maxlength="12"
      placeholder="输入名称"
      placeholder-class="field-placeholder"
    />

    <view class="field-label">运动方式</view>
    <view class="chips">
      <view class="chip {{kind === 'fish' ? 'active' : ''}}" data-kind="fish" bindtap="onKind">游动</view>
      <view class="chip {{kind === 'crab' ? 'active' : ''}}" data-kind="crab" bindtap="onKind">横移</view>
      <view class="chip {{kind === 'snail' ? 'active' : ''}}" data-kind="snail" bindtap="onKind">爬行</view>
      <view class="chip {{kind === 'jelly' ? 'active' : ''}}" data-kind="jelly" bindtap="onKind">漂浮</view>
    </view>

    <view class="field-label">旋转角度</view>
    <view class="size-row">
      <slider
        class="size-slider"
        min="0"
        max="360"
        step="5"
        value="{{rotate}}"
        activeColor="#2F7F86"
        backgroundColor="#E6EAE9"
        block-size="22"
        bindchanging="onRotateChange"
        bindchange="onRotateChange"
      />
      <text class="size-value">{{rotate}}°</text>
    </view>

    <view class="actions">
      <view class="action ghost" bindtap="onBackEdit" hover-class="pick-tap">返回抠图</view>
      <view class="action primary {{uploading ? 'disabled' : ''}}" bindtap="onPlace" hover-class="pick-tap">{{uploading ? '加入中…' : '加入潮池'}}</view>
    </view>
  </view>
</view>
