<view class="page">
  <view class="page-content">
    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>
    <view class="card list-card" wx:elif="{{item.id}}">
      <image wx:if="{{coverSrc}}" class="cover" src="{{coverSrc}}" mode="aspectFill" data-url="{{coverUrl}}" bindtap="onPreviewPhoto" hover-class="tap"></image>
      <view class="list-title">{{item.name}}</view>
      <view class="list-meta" wx:if="{{akaText}}">又名 {{akaText}}</view>
      <view class="list-meta" wx:if="{{item.summary}}">{{item.summary}}</view>
      <block wx:if="{{isScience}}">
        <view class="list-meta">知识点：{{item.look}}</view>
        <view class="list-meta">应用与影响：{{item.habitat}}</view>
        <view class="list-meta">延伸：{{item.observeTip}}</view>
        <view class="list-meta">提示：{{item.safetyTip}}</view>
      </block>
      <block wx:else>
        <view class="list-meta">外形：{{item.look}}</view>
        <view class="list-meta">栖息：{{item.habitat}}</view>
        <view class="list-meta">观察：{{item.observeTip}}</view>
        <view class="list-meta">安全：{{item.safetyTip}}</view>
      </block>
      <view class="list-meta" wx:if="{{item.source}}">来源：{{item.source}}</view>
      <view class="btn full-btn" bindtap="onFavorite" hover-class="tap">{{item.favorited ? '已收藏' : '收藏图鉴'}}</view>
    </view>
  </view>
</view>

<watch-ball />
