/* ==================== 入口 ==================== */
.hero {
  padding: 20rpx 8rpx 28rpx;
}

.hero-title {
  color: var(--ink);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  border: 4rpx solid var(--ink);
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.entry-card:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}

.entry-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 90rpx;
  text-align: center;
  border: 3rpx solid var(--ink);
  border-radius: 24rpx;
  font-size: 44rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.entry-icon.create { background: #D9EEF2; }
.entry-icon.join { background: #D9F2E2; }

.entry-body { flex: 1; min-width: 0; }

.entry-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 850;
}

.entry-desc {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.5;
}

.entry-arrow {
  color: #9AA8B2;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

/* ==================== 我发起的签到 ==================== */
.sec-head {
  margin: 32rpx 8rpx 16rpx;
}

.sec-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 850;
}

.sess-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 4rpx solid var(--ink);
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.sess-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sess-place {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 850;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sess-badge {
  flex-shrink: 0;
  padding: 3rpx 14rpx;
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  background: #F0F2F5;
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.5;
}

.sess-badge.on {
  background: #D9F2E2;
  color: #2E9E5B;
}

.sess-key {
  margin-top: 12rpx;
  color: #1888BF;
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  font-variant-numeric: tabular-nums;
}

.sess-key.muted {
  color: #C9D2DA;
  letter-spacing: 4rpx;
}

.sess-meta {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 650;
}

.sess-num {
  color: #1888BF;
  font-size: 26rpx;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
}

.sess-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

/* ==================== 顶部返回栏 ==================== */
.topbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 4rpx 20rpx;
}

.topbar-back {
  color: #1888BF;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.topbar-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 900;
}

/* ==================== 小节标题 ==================== */
.step {
  display: flex;
  align-items: center;
  margin: 30rpx 6rpx 14rpx;
}

.step-name {
  padding-left: 16rpx;
  border-left: 6rpx solid #34B8C5;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.2;
}

/* ==================== 面板 ==================== */
.panel {
  padding: 24rpx;
  border: 4rpx solid var(--ink);
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.panel-tip {
  display: block;
  margin-bottom: 14rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.5;
}

.panel-empty {
  padding: 24rpx 0;
  text-align: center;
  color: #9AA8B2;
  font-size: 24rpx;
  font-weight: 650;
}

.panel-note {
  display: block;
  margin-top: 14rpx;
  color: #9AA8B2;
  font-size: 20rpx;
  font-weight: 650;
  text-align: center;
}

.panel-btn {
  width: 100%;
  height: 80rpx;
  line-height: 72rpx;
  margin-top: 16rpx;
  text-align: center;
  border: 4rpx solid var(--ink);
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.panel-btn.primary {
  background: #34B8C5;
  color: #FFFFFF;
}

/* ==================== 地点 ==================== */
.place-row {
  display: flex;
  gap: 12rpx;
}

.place-pin { font-size: 30rpx; line-height: 1.2; }

.place-text { flex: 1; min-width: 0; }

.place-name {
  display: block;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 850;
}

.place-addr {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.5;
}

/* ==================== 地图（放大） ==================== */
.fence-map {
  width: 100%;
  height: 640rpx;
  border: 3rpx solid var(--ink);
  border-radius: 18rpx;
  overflow: hidden;
}

.poly-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.ghost-btn {
  flex: 1;
  height: 72rpx;
  line-height: 66rpx;
  text-align: center;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  box-sizing: border-box;
}

.ghost-btn:active { background: #F1F3F5; }

/* ==================== 主按钮 ==================== */
/* 用 flex 居中而不是 height + line-height：
   后者在文案变长或换行时会溢出、文字偏上。 */
.main-btn {
  width: 100%;
  min-height: 88rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 4rpx solid var(--ink);
  border-radius: 999rpx;
  background: #1888BF;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 850;
  box-sizing: border-box;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.main-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}

/* 禁用态必须一眼可辨：灰底灰字、无阴影 */
.main-btn.disabled {
  background: #9AA8B2;
  border-color: #9AA8B2;
  color: #F2F4F5;
  box-shadow: none;
}

/* ==================== 小按钮 ==================== */
.mini-btn {
  height: 72rpx;
  line-height: 66rpx;
  padding: 0 26rpx;
  text-align: center;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  box-sizing: border-box;
  flex-shrink: 0;
}

.mini-btn.primary { background: #1888BF; color: #FFFFFF; }
.mini-btn.danger { color: var(--danger); border-color: var(--danger); }

/* ==================== 成功结果 ==================== */
.result-card {
  padding: 36rpx 24rpx 28rpx;
  border: 4rpx solid var(--ink);
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.result-badge {
  width: 104rpx;
  height: 104rpx;
  line-height: 96rpx;
  margin: 0 auto 18rpx;
  text-align: center;
  border: 4rpx solid var(--ink);
  border-radius: 50%;
  background: #2E9E5B;
  color: #FFFFFF;
  font-size: 52rpx;
  font-weight: 850;
  box-sizing: border-box;
}

.result-title {
  text-align: center;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 900;
}

.result-sub {
  margin-top: 8rpx;
  text-align: center;
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 650;
}

.key-display {
  margin: 28rpx 0 24rpx;
  padding: 26rpx 0;
  border: 3rpx dashed #1888BF;
  border-radius: 20rpx;
  background: #F3FBFA;
  text-align: center;
}

.key-value {
  display: block;
  color: #1888BF;
  font-size: 60rpx;
  font-weight: 900;
  letter-spacing: 12rpx;
  font-variant-numeric: tabular-nums;
}

.key-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 650;
}

.qr-img {
  display: block;
  width: 340rpx;
  height: 340rpx;
  margin: 0 auto;
  border: 3rpx solid var(--ink);
  border-radius: 18rpx;
  background: #FFFFFF;
}

.qr-hint {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 650;
}

/* 分组信息行：标签在左、值靠右对齐。
   值右对齐是关键 —— 扫下来数值排成一列，比左对齐好读得多，
   这也是系统设置类列表的通行做法。
   分隔线用发丝级实线（原来是虚线，看着像没做完的稿子）。 */
.info-list {
  margin-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.info-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

/* 最后一行不画线 —— 收在卡片底边上更干净 */
.info-row:last-child {
  padding-bottom: 6rpx;
  border-bottom: 0;
}

.info-k {
  width: 118rpx;
  flex-shrink: 0;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 650;
}

.info-v {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  text-align: right;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1.5;
  word-break: break-all;
}

/* ==================== 密钥输入 ==================== */
.key-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.key-field {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 16rpx;
  text-align: center;
  border: 3rpx solid var(--ink);
  border-radius: 16rpx;
  background: #FFFFFF;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}

.key-placeholder {
  color: #9AA8B2;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0;
}

/* ==================== 活动信息 ==================== */
.session-head {
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid var(--line);
}

.session-name {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 850;
}

.session-place {
  display: block;
  margin-top: 10rpx;
  color: #3D4A54;
  font-size: 24rpx;
  font-weight: 650;
}

.session-owner {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 650;
}

/* ==================== 表单 ==================== */
.form-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.form-row:last-child { border-bottom: none; }

.form-label {
  width: 88rpx;
  flex-shrink: 0;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 750;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 18rpx;
  border: 3rpx solid var(--ink);
  border-radius: 16rpx;
  background: #FFFFFF;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.form-ph {
  color: #9AA8B2;
  font-weight: 500;
}

/* ==================== 定位状态 ==================== */
.loc-btn-row { margin-bottom: 4rpx; }

.loc-state {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
}

.loc-state.ok { background: #EAF9F1; }
.loc-state.bad { background: #FFF3D6; }

.loc-state-icon { font-size: 30rpx; line-height: 1.2; }

.loc-state-text { flex: 1; min-width: 0; }

.loc-state-title {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
}

.loc-state.ok .loc-state-title { color: var(--success); }
.loc-state.bad .loc-state-title { color: #8A5B00; }

.loc-state-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.5;
}

.loc-state.ok .loc-state-desc { color: #3D4A54; }
.loc-state.bad .loc-state-desc { color: #8A5B00; }

/* ==================== 名单 ==================== */
.records-place {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 850;
}

.records-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 650;
}

.records-count {
  color: #1888BF;
  font-size: 24rpx;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
}

.name-card {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border: 3rpx solid var(--ink);
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name-main {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 800;
}

.name-sub {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.name-meta {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
