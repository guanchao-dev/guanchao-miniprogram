.audit-page {
  background: #FBF6EA;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.audit-head {
  padding: 8rpx 0 20rpx;
}

.audit-head .title {
  line-height: 1.1;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.state {
  padding: 60rpx 20rpx;
  color: var(--muted);
  font-size: 24rpx;
  text-align: center;
}

.card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(28, 28, 28, .12);
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(28, 28, 28, .07);
}

.thumb {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(28, 28, 28, .10);
  border-radius: 10rpx;
  background: #F2F2EE;
}

.info {
  flex: 1;
  min-width: 0;
}

.pill {
  display: inline-block;
  padding: 2rpx 14rpx;
  border: 1rpx solid rgba(28, 28, 28, .16);
  border-radius: 6rpx;
  font-size: 19rpx;
  font-weight: 800;
}

.pill.pending { background: #FFF3D6; }
.pill.approved { background: #D8F3E9; }
.pill.rejected { background: #FFE1DA; }
.pill.appealed { background: #E3ECFF; }

.reason {
  margin-top: 8rpx;
  color: #B4462F;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.4;
}

.time {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(28, 28, 28, .16);
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.btn.primary { background: #2F7F86; color: #fff; border-color: #2F7F86; }
.btn.ghost { background: #fff; color: var(--ink); }
.audit-tap { opacity: .78; }
