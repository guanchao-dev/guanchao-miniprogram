.audit-page {
  background: #FBF7EF;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.audit-head {
  padding: 8rpx 0 20rpx;
}

.audit-head .title {
  line-height: 1.15;
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.state {
  padding: 80rpx 20rpx;
  color: #6B7C8A;
  font-size: 24rpx;
  text-align: center;
}

.card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.thumb {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  border: 3rpx solid rgba(28, 28, 28, .16);
  border-radius: 16rpx;
  background: #F2F2EE;
}

.info {
  flex: 1;
  min-width: 0;
}

.pill {
  display: inline-block;
  padding: 4rpx 16rpx;
  border: 3rpx solid rgba(28, 28, 28, .18);
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
}

.pill.pending { background: #FFF3D6; color: #8A5B00; }
.pill.approved { background: #D8F3E9; color: #1F7A55; }
.pill.rejected { background: #FFE1DA; color: #B03A22; }
.pill.appealed { background: #E3ECFF; color: #1163C7; }

.reason {
  margin-top: 8rpx;
  color: #D9463F;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.45;
}

.time {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 19rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.btn.primary {
  background: #F6D081;
  color: #1C1C1C;
}

.audit-tap { opacity: .68; }
