.region-page {
  padding-bottom: 64rpx;
}

.region-intro {
  position: relative;
  z-index: 2;
  margin: 8rpx 6rpx 28rpx;
}

.region-title {
  color: #1C1C1C;
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.region-sub {
  margin-top: 10rpx;
  color: #6B7C8A;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.5;
}

.region-list {
  position: relative;
  z-index: 2;
}

.region-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.region-item:active,
.locate-card:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

.region-item.is-active {
  background: #E7FBFC;
  box-shadow: 3rpx 3rpx 0 rgba(52, 184, 197, 0.55);
}

.region-main {
  flex: 1;
  min-width: 0;
}

.region-name {
  color: #1C1C1C;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.3;
}

.region-desc {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.45;
}

.region-badge {
  flex: none;
  margin-left: 16rpx;
  padding: 5rpx 16rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #34B8C5;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 800;
}

.region-arrow {
  flex: none;
  margin-left: 16rpx;
  color: #6B7C8A;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.locate-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
}

.locate-card.is-disabled {
  opacity: 0.5;
}

.locate-mark {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #34B8C5;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 1;
}

.locate-main {
  flex: 1;
  min-width: 0;
}

.locate-title {
  color: #1C1C1C;
  font-size: 27rpx;
  font-weight: 800;
}

.region-tip {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  color: #6B7C8A;
  text-align: center;
  font-size: 21rpx;
  font-weight: 650;
}
