.hero {
  padding: 20rpx 8rpx 16rpx;
}

.hero-title {
  color: var(--ink);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

/* 一条消息：点位名 + 管理员回复 +（我原来说的） */
.msg-card {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
}

.msg-where {
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--line);
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
}

.msg-reply {
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg-mine {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--line);
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
}

/* 空状态 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 64rpx 32rpx;
}

.empty-icon {
  font-size: 88rpx;
  line-height: 1.1;
}

.empty-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 850;
}
