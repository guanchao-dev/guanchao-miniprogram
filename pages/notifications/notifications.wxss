.hero {
  padding: 24rpx 8rpx 20rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 850;
  letter-spacing: 2rpx;
}

/* 一条消息：点位名 + 管理员回复 +（我原来说的）*/
.msg-card {
  margin-bottom: 22rpx;
  padding: 26rpx 24rpx;
}
.msg-where {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}
.msg-reply {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-word;
  white-space: pre-wrap;
}
.msg-mine {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed rgba(28, 28, 28, 0.14);
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
}

/* 空状态 */
.empty-card {
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}
.empty-icon {
  font-size: 96rpx;
}
.empty-title {
  font-size: 34rpx;
  font-weight: 850;
}
