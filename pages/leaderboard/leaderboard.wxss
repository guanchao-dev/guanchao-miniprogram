.lb-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  margin: 0 0 14rpx;
  padding: 14rpx 20rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--ink);
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.lb-row.me {
  background: #EAF8FA;
}

/* 名次：前三名是金 / 银 / 铜圆徽章，其余只留数字 */
.lb-rank {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  box-sizing: border-box;
  text-align: center;
  border-radius: 50%;
  color: #8A99A6;
  font-size: 26rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.lb-rank.rank-1,
.lb-rank.rank-2,
.lb-rank.rank-3 {
  border: 3rpx solid var(--ink);
  line-height: 42rpx;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}

.lb-rank.rank-1 {
  background: #F6D081;
  color: var(--ink);
}

.lb-rank.rank-2 {
  background: #DCE3E8;
  color: #33414D;
}

.lb-rank.rank-3 {
  background: #EAC3A5;
  color: #4A2E1C;
}

.lb-avatar {
  width: 72rpx;
  height: 72rpx;
  margin: 0 16rpx;
  border: 3rpx solid var(--ink);
  border-radius: 50%;
  background: #E8F4F8;
}

.lb-meta {
  flex: 1;
  min-width: 0;
}

.lb-name {
  display: block;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lb-row.me .lb-name {
  color: #0E6E9F;
}

.lb-level {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 650;
}

.lb-score {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #1888BF;
  font-size: 30rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.lb-more {
  padding: 24rpx 0 56rpx;
  color: #9AA8B2;
  font-size: 21rpx;
  font-weight: 650;
  text-align: center;
}
