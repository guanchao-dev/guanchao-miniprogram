<view class="community-page">
  <view class="comm-head">
    <view class="feed-tabs">
      <view class="feed-tab {{tab === 'recommend' ? 'on' : ''}}" data-tab="recommend" bindtap="onTab">推荐</view>
      <view class="feed-tab {{tab === 'following' ? 'on' : ''}}" data-tab="following" bindtap="onTab">关注</view>
    </view>
    <view class="search-chip" bindtap="goSearch">
      <text>搜索观察笔记 / 话题 / 同学</text>
      <image class="search-icon" src="/assets/home/home-search.png" mode="aspectFit"></image>
    </view>
    <scroll-view class="topic-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="topic-row">
        <view
          class="chip {{topicId === item.id ? 'active' : ''}}"
          wx:for="{{topics}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTopic"
        >{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="empty-tip" wx:if="{{!left.length && !right.length}}">{{emptyText}}</view>
  <view class="waterfall">
    <view class="wf-col">
      <view class="note-card card" wx:for="{{left}}" wx:key="id" data-id="{{item.id}}" bindtap="openNote">
        <image class="note-cover" src="{{item.coverUrl}}" mode="aspectFill" style="height: {{item.coverHeight}}rpx;"></image>
        <view class="note-title">{{item.title}}</view>
        <view class="note-meta">{{item.spotName}}</view>
        <view class="note-foot">
          <image class="mini-avatar" src="{{item.author.avatarUrl}}" mode="aspectFill"></image>
          <text class="mini-name">{{item.author.nickname}}</text>
          <text class="mini-like">♡ {{item.likeCount}}</text>
        </view>
      </view>
    </view>
    <view class="wf-col">
      <view class="note-card card" wx:for="{{right}}" wx:key="id" data-id="{{item.id}}" bindtap="openNote">
        <image class="note-cover" src="{{item.coverUrl}}" mode="aspectFill" style="height: {{item.coverHeight}}rpx;"></image>
        <view class="note-title">{{item.title}}</view>
        <view class="note-meta">{{item.spotName}}</view>
        <view class="note-foot">
          <image class="mini-avatar" src="{{item.author.avatarUrl}}" mode="aspectFill"></image>
          <text class="mini-name">{{item.author.nickname}}</text>
          <text class="mini-like">♡ {{item.likeCount}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="goPublish">＋ 发布</view>
  <unlock-popup id="unlockPopup"></unlock-popup>
</view>
