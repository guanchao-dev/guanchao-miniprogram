.community-page {
  min-height: 100vh;
  padding: 16rpx 20rpx 160rpx;
  box-sizing: border-box;
  background: #FFFFFF;
}

.comm-head {
  position: sticky;
  top: 0;
  z-index: 5;
  padding-bottom: 8rpx;
  background: #FFFFFF;
}

.feed-tabs {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 16rpx;
}

.feed-tab {
  font-size: 32rpx;
  font-weight: 700;
  color: #9AA6B4;
  padding-bottom: 8rpx;
}

.feed-tab.on {
  color: #1C1C1C;
  font-weight: 850;
  border-bottom: 6rpx solid #1878FF;
}

.search-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 22rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F6F8FA;
  color: #6B7C8A;
  font-size: 24rpx;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
}

.topic-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.topic-row {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 8rpx;
}

.topic-row .chip {
  margin-bottom: 0;
  flex-shrink: 0;
}

.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.wf-col {
  flex: 1;
  min-width: 0;
}

.note-card {
  margin-bottom: 14rpx;
  overflow: hidden;
}

.note-cover {
  width: 100%;
  display: block;
  background: #E8F4F8;
}

.note-title {
  padding: 14rpx 14rpx 0;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.note-meta {
  padding: 6rpx 14rpx 0;
  color: #6B7C8A;
  font-size: 20rpx;
}

.note-foot {
  display: flex;
  align-items: center;
  padding: 12rpx 14rpx 14rpx;
}

.mini-avatar {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 50%;
  background: #fff;
}

.mini-name {
  flex: 1;
  margin-left: 8rpx;
  font-size: 20rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-like {
  color: #6B7C8A;
  font-size: 20rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  z-index: 8;
  height: 80rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #1878FF;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}
