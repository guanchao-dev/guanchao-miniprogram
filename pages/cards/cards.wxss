.empty {
  padding: 64rpx 20rpx;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 650;
  text-align: center;
  line-height: 1.6;
}

.day-block {
  margin-bottom: 24rpx;
}

/* 日期分隔：文字 + 向右延伸的发丝线，弱化但清楚 */
.day-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 4rpx 14rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.day-label::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: var(--line);
}

.mask {
  position: fixed;
  inset: 0;
  /* 高于悬浮赶海球（90） */
  z-index: 95;
  display: flex;
  /* 居中的弹窗，不再是贴底的 bottom sheet */
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  background: rgba(11, 31, 56, 0.56);
}

.sheet {
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
  box-sizing: border-box;
  border: 4rpx solid var(--ink);
  /* 四角都圆 —— 不再贴底 */
  border-radius: 32rpx;
  background: #FBF7EF;
  /* 列布局：内容区自适应收缩并内部滚动，不然内容一多会被 max-height 裁掉 */
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx 6rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 850;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  border: 3rpx solid var(--ink);
  border-radius: 50%;
  background: #FFFFFF;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-body {
  /* flex:1 + min-height:0 让内容区在弹窗变矮时自动收缩并内部滚动。
     min-height 必须显式置 0 —— flex 子项默认不会缩到内容高度以下。 */
  flex: 1;
  min-height: 0;
  max-height: 68vh;
  padding: 10rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.detail-spot {
  width: fit-content;
  margin: 14rpx auto 0;
  padding: 8rpx 18rpx;
  border: 2rpx solid #1888BF;
  border-radius: 999rpx;
  background: #EAF6FB;
  color: #0E6E9F;
  font-size: 21rpx;
  font-weight: 700;
}

/* 分组小标题：认出的生物 / 捡到的垃圾 */

/* 名称 + 副标题（垃圾的类别 / 生物的位置）两行 */

.detail-note {
  margin-top: 16rpx;
  color: #9AA8B2;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.5;
}

/* ===== 赶海日志卡：一行一个条目，标签在左、数值压在右侧横线上 ===== */
.log-card {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx 18rpx;
}

/* 统计条目收在一个方框里 */
.log-block {
  padding: 18rpx 20rpx 2rpx;
  border-radius: 18rpx;
  background: #F4F8F9;
}

.log-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 两列网格：一行放两个「标签 + 数值」 */
.log-g2 {
  display: flex;
  margin-bottom: 20rpx;
}

.log-g2:last-child {
  margin-bottom: 4rpx;
}

.log-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.log-cell + .log-cell {
  margin-left: 24rpx;
}

/* 网格里每格只有半栏宽（约 290rpx），标签和数值都要收一档，
   并且禁止换行 —— 时间这种较长的值一旦折行，两列就参差不齐了 */
.log-cell .log-k {
  font-size: 23rpx;
  white-space: nowrap;
}

.log-cell .log-v {
  margin-left: 10rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

.log-k {
  flex: none;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 700;
}

/* 数值压在一条横线上，横线由左延伸到右边 —— 对应参考图里那条手写填空线 */
.log-v {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  padding-bottom: 6rpx;
  border-bottom: 3rpx solid var(--ink);
  text-align: right;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

/* 「0 种」「无」这类空值弱化，不跟真结果抢视线 */
.log-v.is-zero {
  color: #A8B3B0;
  border-bottom-color: #C9D4D1;
}

/* 方框分区：这次认出的图鉴 */
.log-box {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #F4F8F9;
}

.log-box-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 800;
}

.log-thumbs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.log-thumb {
  width: 112rpx;
  height: 112rpx;
  margin: 0 12rpx 12rpx 0;
  border: 3rpx solid var(--ink);
  border-radius: 14rpx;
  background: #F3FBFA;
}

.log-thumbs-empty {
  margin-top: 6rpx;
  color: #9AA8B2;
  font-size: 23rpx;
  font-weight: 650;
}
