.empty {
  padding: 80rpx 20rpx;
  color: #6B7C8A;
  text-align: center;
  line-height: 1.6;
}

.day-block {
  margin-bottom: 28rpx;
}

.day-label {
  margin: 8rpx 4rpx 14rpx;
  font-size: 26rpx;
  font-weight: 850;
  color: #1888BF;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(11, 31, 56, 0.56);
}

.sheet {
  width: 100%;
  max-height: 84vh;
  overflow: hidden;
  border: 4rpx solid #1C1C1C;
  border-bottom: 0;
  border-radius: 36rpx 36rpx 0 0;
  background: #EAF3FF;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 8rpx;
  font-size: 34rpx;
  font-weight: 850;
}

.sheet-close {
  font-size: 44rpx;
  font-weight: 300;
}

.sheet-body {
  max-height: 72vh;
  padding: 8rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.detail-spot {
  margin: 12rpx auto 0;
  padding: 10rpx 20rpx;
  width: fit-content;
  border: 2rpx solid #1888BF;
  border-radius: 999rpx;
  color: #0E6E9F;
  font-size: 22rpx;
  font-weight: 700;
  background: #EAF6FB;
}

.species-box {
  margin-top: 24rpx;
  padding: 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.species-title {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 850;
}

/* 分组小标题：认出的生物 / 捡到的垃圾 */
.group-head {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
  padding-bottom: 6rpx;
  border-bottom: 2rpx dashed #E3EEF7;
}

.group-head-gap {
  margin-top: 18rpx;
}

.group-name {
  color: #1C1C1C;
  font-size: 22rpx;
  font-weight: 800;
}

.group-count {
  margin-left: 10rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #E3EEF7;
  color: #1878FF;
  font-size: 20rpx;
  font-weight: 800;
}

.species-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.species-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 名称 + 副标题（垃圾的类别 / 生物的位置）两行 */
.species-main {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.species-name {
  font-size: 26rpx;
  font-weight: 700;
}

.species-sub {
  margin-top: 2rpx;
  color: #6B7C8A;
  font-size: 20rpx;
}

.species-time {
  color: #6B7C8A;
  font-size: 22rpx;
}

.detail-note {
  margin-top: 20rpx;
  color: #9AA6B4;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ===== 观潮记录卡：标签 + 下划线数值 + 底部图鉴图 ===== */
.log-card {
  padding: 26rpx 28rpx 18rpx;
  margin-bottom: 18rpx;
}

.log-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.log-k {
  flex: none;
  width: 150rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #6B7F8F;
}

/* 数值落在一条下划线上，像纸质日志的填写栏 */
.log-v {
  flex: 1;
  padding-bottom: 6rpx;
  border-bottom: 3rpx solid #1C1C1C;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.25;
}

/* 「0 种」「无」这类空值弱化，不跟真结果抢视线 */
.log-v.is-zero {
  color: #A8B3B0;
  border-bottom-color: #C9D4D1;
}

.log-thumbs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.log-thumb {
  width: 112rpx;
  height: 112rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 16rpx;
  border: 3rpx solid #1C1C1C;
  background: #F3FBFA;
}

.log-thumbs-empty {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #A8B3B0;
}
