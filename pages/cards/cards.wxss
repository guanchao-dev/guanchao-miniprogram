.empty {
  padding: 80rpx 20rpx;
  color: #6B7C8A;
  text-align: center;
  line-height: 1.6;
}

.day-block {
  margin-bottom: 28rpx;
}

.day-label {
  margin: 8rpx 4rpx 14rpx;
  font-size: 26rpx;
  font-weight: 850;
  color: #1888BF;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  /* 居中的弹窗，不再是贴底的 bottom sheet */
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  background: rgba(11, 31, 56, 0.56);
}

.sheet {
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
  border: 4rpx solid #1C1C1C;
  /* 四角都圆 —— 不再贴底 */
  border-radius: 36rpx;
  background: #EAF3FF;
  box-sizing: border-box;
  /* 列布局：内容区自适应收缩并内部滚动，不然内容一多会被 max-height 裁掉 */
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 8rpx;
  font-size: 34rpx;
  font-weight: 850;
}

.sheet-close {
  font-size: 44rpx;
  font-weight: 300;
}

.sheet-body {
  /* flex:1 + min-height:0 让内容区在弹窗变矮时自动收缩并内部滚动。
     min-height 必须显式置 0 —— flex 子项默认不会缩到内容高度以下。 */
  flex: 1;
  min-height: 0;
  max-height: 68vh;
  padding: 8rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.detail-spot {
  margin: 12rpx auto 0;
  padding: 10rpx 20rpx;
  width: fit-content;
  border: 2rpx solid #1888BF;
  border-radius: 999rpx;
  color: #0E6E9F;
  font-size: 22rpx;
  font-weight: 700;
  background: #EAF6FB;
}

/* 分组小标题：认出的生物 / 捡到的垃圾 */

/* 名称 + 副标题（垃圾的类别 / 生物的位置）两行 */

.detail-note {
  margin-top: 20rpx;
  color: #9AA6B4;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ===== 观潮日志卡：一行一个条目，标签在左、数值压在右侧横线上 ===== */
.log-card {
  padding: 26rpx 28rpx 22rpx;
  margin-bottom: 18rpx;
}

/* 统计条目收在一个方框里 */
.log-block {
  padding: 20rpx 22rpx 2rpx;
  border-radius: 20rpx;
  background: #F3F7FB;
}

.log-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* 两列网格：一行放两个「标签 + 数值」 */
.log-g2 {
  display: flex;
  margin-bottom: 24rpx;
}

.log-g2:last-child {
  margin-bottom: 4rpx;
}

.log-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.log-cell + .log-cell {
  margin-left: 26rpx;
}

/* 网格里的数值字号小一档 —— 两列并排，太大会挤 */
.log-cell .log-k {
  font-size: 24rpx;
}

.log-cell .log-v {
  margin-left: 12rpx;
  font-size: 30rpx;
}

.log-k {
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: #6B7F8F;
}

/* 数值压在一条横线上，横线由左延伸到右边 —— 对应参考图里那条手写填空线 */
.log-v {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  padding-bottom: 8rpx;
  border-bottom: 3rpx solid #1C1C1C;
  text-align: right;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.2;
}

/* 「0 种」「无」这类空值弱化，不跟真结果抢视线 */
.log-v.is-zero {
  color: #A8B3B0;
  border-bottom-color: #C9D4D1;
}

/* 方框分区：这次认出的图鉴 */
.log-box {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #F3F7FB;
}

.log-box-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #6B7F8F;
}

.log-thumbs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.log-thumb {
  width: 112rpx;
  height: 112rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 16rpx;
  border: 3rpx solid #1C1C1C;
  background: #F3FBFA;
}

.log-thumbs-empty {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #A8B3B0;
}
