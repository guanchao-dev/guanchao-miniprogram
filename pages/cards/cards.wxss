.empty {
  padding: 80rpx 20rpx;
  color: #6B7C8A;
  text-align: center;
  line-height: 1.6;
}

.day-block {
  margin-bottom: 28rpx;
}

.day-label {
  margin: 8rpx 4rpx 14rpx;
  font-size: 26rpx;
  font-weight: 850;
  color: #1888BF;
}

.card-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
}

.card-mascot {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-name {
  font-size: 32rpx;
  font-weight: 850;
}

.card-meta {
  margin-top: 8rpx;
  color: #6B7C8A;
  font-size: 22rpx;
}

.card-arrow {
  color: #1888BF;
  font-size: 40rpx;
  font-weight: 300;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(11, 31, 56, 0.56);
}

.sheet {
  width: 100%;
  max-height: 84vh;
  overflow: hidden;
  border: 4rpx solid #1C1C1C;
  border-bottom: 0;
  border-radius: 36rpx 36rpx 0 0;
  background: #EAF3FF;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 8rpx;
  font-size: 34rpx;
  font-weight: 850;
}

.sheet-close {
  font-size: 44rpx;
  font-weight: 300;
}

.sheet-body {
  max-height: 72vh;
  padding: 8rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.detail-mascot {
  display: block;
  width: 180rpx;
  height: 180rpx;
  margin: 8rpx auto 16rpx;
}

.detail-time {
  text-align: center;
  font-size: 30rpx;
  font-weight: 850;
}

.detail-sub {
  margin-top: 8rpx;
  text-align: center;
  color: #1888BF;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-summary {
  display: block;
  margin-top: 20rpx;
  color: #4F6787;
  font-size: 26rpx;
  line-height: 1.65;
}

.species-box {
  margin-top: 24rpx;
  padding: 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.species-title {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 850;
}

/* 分组小标题：认出的生物 / 捡到的垃圾 */
.group-head {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
  padding-bottom: 6rpx;
  border-bottom: 2rpx dashed #E3EEF7;
}

.group-head-gap {
  margin-top: 18rpx;
}

.group-name {
  color: #1C1C1C;
  font-size: 22rpx;
  font-weight: 800;
}

.group-count {
  margin-left: 10rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #E3EEF7;
  color: #1878FF;
  font-size: 20rpx;
  font-weight: 800;
}

.species-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.species-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 名称 + 副标题（垃圾的类别 / 生物的位置）两行 */
.species-main {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.species-name {
  font-size: 26rpx;
  font-weight: 700;
}

.species-sub {
  margin-top: 2rpx;
  color: #6B7C8A;
  font-size: 20rpx;
}

.species-time {
  color: #6B7C8A;
  font-size: 22rpx;
}

.detail-note {
  margin-top: 20rpx;
  color: #9AA6B4;
  font-size: 22rpx;
  line-height: 1.5;
}
