<view class="page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle lg" style="top: 20rpx; right: -40rpx; background:#34B8C5;"></view>
    <view class="geo-square" style="bottom: 180rpx; left: -30rpx; background:#F6D081;"></view>
  </view>

  <view class="page-content">
    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>
    <view class="empty" wx:elif="{{!groups.length}}">还没有观潮记录。回首页点「开始观潮」，结束一次就会出现在这里。</view>

    <!-- 观潮记录卡：只留「认了几种生物 / 垃圾量」，底部铺这次认出的图鉴图 -->
    <view class="day-block" wx:for="{{groups}}" wx:key="date">
      <view class="day-label">{{item.label}}</view>
      <view class="log-card card" wx:for="{{item.items}}" wx:for-item="row" wx:key="id" data-id="{{row.id}}" bindtap="onOpen">
        <view class="log-row">
          <text class="log-k">识别生物</text>
          <text class="log-v {{row.creatureCount ? '' : 'is-zero'}}">{{row.creatureCount}} 种</text>
        </view>
        <view class="log-row">
          <text class="log-k">垃圾量</text>
          <text class="log-v {{row.trashAmountText === '无' ? 'is-zero' : ''}}">{{row.trashAmountText}}</text>
        </view>
        <view class="log-thumbs" wx:if="{{row.creatureCovers.length}}">
          <image
            class="log-thumb"
            wx:for="{{row.creatureCovers}}"
            wx:for-item="cv"
            wx:key="*this"
            src="{{cv}}"
            mode="aspectFill"
          ></image>
        </view>
        <view class="log-thumbs-empty" wx:else>这次没有认出生物</view>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text>观潮记录</text>
        <text class="sheet-close" bindtap="closeDetail">×</text>
      </view>
      <scroll-view scroll-y class="sheet-body">
        <!-- 与列表页同一套版式：只留「认了几种生物 / 垃圾量」，底部铺图鉴图 -->
        <view class="log-row">
          <text class="log-k">识别生物</text>
          <text class="log-v {{detail.creatureCount ? '' : 'is-zero'}}">{{detail.creatureCount}} 种</text>
        </view>
        <view class="log-row">
          <text class="log-k">垃圾量</text>
          <text class="log-v {{detail.trashAmountText === '无' ? 'is-zero' : ''}}">{{detail.trashAmountText}}</text>
        </view>
        <view class="log-thumbs" wx:if="{{detail.creatureCovers.length}}">
          <image
            class="log-thumb"
            wx:for="{{detail.creatureCovers}}"
            wx:for-item="cv"
            wx:key="*this"
            src="{{cv}}"
            mode="aspectFill"
          ></image>
        </view>
        <view class="log-thumbs-empty" wx:else>这次没有认出生物</view>

        <view class="detail-spot" wx:if="{{detail.spot}}">📍 观潮地点：{{detail.spot.name}}{{detail.spot.source === 'custom' ? '（地图自选）' : ''}}</view>
        <view class="species-box" wx:if="{{detail.groups.length}}">
          <view class="species-title">这次发现</view>
          <!-- 生物 / 垃圾各成一组，组内按时间排序，不混在一起 -->
          <block wx:for="{{detail.groups}}" wx:for-item="grp" wx:for-index="gi" wx:key="key">
            <view class="group-head {{gi > 0 ? 'group-head-gap' : ''}}">
              <text class="group-name">{{grp.title}}</text>
              <text class="group-count">{{grp.items.length}}</text>
            </view>
            <view class="species-row" wx:for="{{grp.items}}" wx:for-item="fd" wx:key="key">
              <image
                class="species-icon"
                src="{{fd.kind === 'trash' ? 'https://www.blueakaiwu.cn/api/v1/static/assets/home/home-gear.png' : 'https://www.blueakaiwu.cn/api/v1/static/assets/home/home-fish.png'}}"
                mode="aspectFit"
              ></image>
              <view class="species-main">
                <text class="species-name">{{fd.name}}{{fd.count > 1 ? ' ×' + fd.count : ''}}</text>
                <text class="species-sub" wx:if="{{fd.categoryLabel}}">{{fd.categoryLabel}}</text>
                <text class="species-sub" wx:elif="{{fd.label}}">{{fd.label}}</text>
              </view>
              <text class="species-time">{{fd.time}}</text>
            </view>
          </block>
        </view>
        <view class="detail-note">记录由观潮时间和拍照识别自动生成，不能自己上传图片。</view>
      </scroll-view>
    </view>
  </view>
</view>

<watch-ball />
