<view class="page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle lg" style="top: 20rpx; right: -40rpx; background:#34B8C5;"></view>
    <view class="geo-square" style="bottom: 180rpx; left: -30rpx; background:#F6D081;"></view>
  </view>

  <view class="page-content">
    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>
    <view class="empty" wx:elif="{{!groups.length}}">还没有观潮记录。回首页点「开始观潮」，结束一次就会出现在这里。</view>

    <!-- 观潮记录卡：只留「认了几种生物 / 垃圾量」，底部铺这次认出的图鉴图 -->
    <view class="day-block" wx:for="{{groups}}" wx:key="date">
      <view class="day-label">{{item.label}}</view>
      <view class="log-card card" wx:for="{{item.items}}" wx:for-item="row" wx:key="id" data-id="{{row.id}}" bindtap="onOpen" hover-class="tap">
        <!-- 日志卡版式：一行一个条目，标签在左、数值压在右侧的横线上 -->
        <view class="log-block">
          <view class="log-line">
            <text class="log-k">识别生物</text>
            <text class="log-v {{row.creatureCount ? '' : 'is-zero'}}">{{row.creatureCount}} 种</text>
          </view>
          <view class="log-line">
            <text class="log-k">垃圾量</text>
            <text class="log-v {{row.trashAmountText === '无' ? 'is-zero' : ''}}">{{row.trashAmountText}}</text>
          </view>
        </view>

        <!-- 方框分区：这次认出的图鉴 -->
        <view class="log-box">
          <text class="log-box-title">认出的生物</text>
          <view class="log-thumbs" wx:if="{{row.creatureCovers.length}}">
            <image
              class="log-thumb"
              wx:for="{{row.creatureCovers}}"
              wx:for-item="cv"
              wx:key="*this"
              src="{{cv}}"
              mode="aspectFill"
            ></image>
          </view>
          <view class="log-thumbs-empty" wx:else>这次没有认出生物</view>
        </view>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text>观潮记录</text>
        <text class="sheet-close" bindtap="closeDetail" hover-class="tap">×</text>
      </view>
      <scroll-view scroll-y class="sheet-body">
        <!-- 观潮日志卡：两列网格，每格「标签在左、数值压在右侧横线上」 -->
        <view class="log-block">
          <view class="log-g2">
            <view class="log-cell">
              <text class="log-k">观潮编号</text>
              <text class="log-v {{detail.seq ? '' : 'is-zero'}}">{{detail.seq ? detail.seq : '—'}}</text>
            </view>
            <view class="log-cell">
              <text class="log-k">日期</text>
              <text class="log-v {{detail.dateText ? '' : 'is-zero'}}">{{detail.dateText ? detail.dateText : '—'}}</text>
            </view>
          </view>
          <view class="log-g2">
            <view class="log-cell">
              <text class="log-k">温度</text>
              <text class="log-v {{detail.tempText ? '' : 'is-zero'}}">{{detail.tempText ? detail.tempText : '—'}}</text>
            </view>
            <view class="log-cell">
              <text class="log-k">天气</text>
              <text class="log-v {{detail.weatherText ? '' : 'is-zero'}}">{{detail.weatherText ? detail.weatherText : '—'}}</text>
            </view>
          </view>
          <view class="log-g2">
            <view class="log-cell">
              <text class="log-k">时间</text>
              <text class="log-v {{detail.timeText ? '' : 'is-zero'}}">{{detail.timeText ? detail.timeText : '—'}}</text>
            </view>
            <view class="log-cell">
              <text class="log-k">潮高</text>
              <text class="log-v {{detail.tideText ? '' : 'is-zero'}}">{{detail.tideText ? detail.tideText : '—'}}</text>
            </view>
          </view>
          <view class="log-g2">
            <view class="log-cell">
              <text class="log-k">识别生物</text>
              <text class="log-v {{detail.creatureCount ? '' : 'is-zero'}}">{{detail.creatureCount}} 种</text>
            </view>
            <view class="log-cell">
              <text class="log-k">垃圾量</text>
              <text class="log-v {{detail.trashAmountText === '无' ? 'is-zero' : ''}}">{{detail.trashAmountText}}</text>
            </view>
          </view>
        </view>
        <view class="log-box">
          <text class="log-box-title">认出的生物</text>
          <view class="log-thumbs" wx:if="{{detail.creatureCovers.length}}">
            <image
              class="log-thumb"
              wx:for="{{detail.creatureCovers}}"
              wx:for-item="cv"
              wx:key="*this"
              src="{{cv}}"
              mode="aspectFill"
            ></image>
          </view>
          <view class="log-thumbs-empty" wx:else>这次没有认出生物</view>
        </view>

        <view class="detail-spot" wx:if="{{detail.spot}}">📍 观潮地点：{{detail.spot.name}}{{detail.spot.source === 'custom' ? '（地图自选）' : ''}}</view>
        <view class="detail-note">记录由观潮时间和拍照识别自动生成，不能自己上传图片。</view>
      </scroll-view>
    </view>
  </view>
</view>

<watch-ball />
