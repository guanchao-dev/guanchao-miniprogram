.hero {
  padding: 24rpx 8rpx 20rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 850;
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.header-count {
  color: var(--muted);
  font-size: 24rpx;
}
.header-btn {
  padding: 12rpx 24rpx;
  background: var(--teal);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  border: 3rpx solid var(--ink);
  border-radius: 24rpx;
  box-shadow: var(--shadow);
}
.header-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28,28,28,0.85);
}

.card {
  border: 3rpx solid var(--ink);
  border-radius: 28rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

/* 空状态 */
.empty-card {
  padding: 64rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-icon {
  font-size: 96rpx;
}
.empty-title {
  font-size: 34rpx;
  font-weight: 850;
}
.empty-sub {
  color: var(--muted);
  font-size: 24rpx;
  text-align: center;
  line-height: 1.55;
}
.empty-cta {
  margin-top: 12rpx;
  padding: 18rpx 40rpx;
  background: var(--yellow);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  border: 3rpx solid var(--ink);
  border-radius: 26rpx;
  box-shadow: var(--shadow);
}
.empty-cta:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28,28,28,0.85);
}

/* 加载 */
.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 0;
  color: var(--muted);
  font-size: 24rpx;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(28,28,28,0.15);
  border-top-color: var(--teal);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 点位卡片 */
.spot-card {
  display: flex;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.spot-photo {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-right: 3rpx solid var(--ink);
}
.spot-body {
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.spot-name {
  font-size: 30rpx;
  font-weight: 850;
}
.spot-addr {
  color: var(--muted);
  font-size: 22rpx;
}
.spot-coord {
  color: var(--blue);
  font-size: 20rpx;
  font-family: monospace;
}
.spot-note {
  color: var(--ink);
  font-size: 22rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.spot-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 18rpx;
  border-left: 2rpx dashed rgba(28,28,28,0.18);
}
.action-btn {
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 18rpx;
  text-align: center;
  border: 2rpx solid var(--ink);
}
.action-btn.primary {
  background: var(--teal);
  color: #FFFFFF;
}
.action-btn.ghost {
  background: var(--yellow);
  color: var(--ink);
}
.action-btn.danger {
  background: #FFFFFF;
  color: #E0533D;
}
.action-btn:active {
  transform: translate(1rpx, 1rpx);
}
