.hero {
  padding: 24rpx 8rpx 20rpx;
}
.hero-title {
  color: #1C1C1C;
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.header-count {
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.header-btn {
  padding: 10rpx 22rpx;
  background: #34B8C5;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}
.header-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

.card {
  border: 4rpx solid #1C1C1C;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

/* 空状态 */
.empty-card {
  padding: 56rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.empty-icon {
  font-size: 88rpx;
  line-height: 1;
}
.empty-title {
  color: #1C1C1C;
  font-size: 34rpx;
  font-weight: 900;
}
.empty-sub {
  color: #6B7C8A;
  font-size: 22rpx;
  font-weight: 650;
  text-align: center;
  line-height: 1.55;
}
.empty-cta {
  margin-top: 12rpx;
  padding: 16rpx 36rpx;
  background: #F6D081;
  color: #1C1C1C;
  font-size: 26rpx;
  font-weight: 850;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}
.empty-cta:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

/* 加载 */
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #E3E9EF;
  border-top-color: #1888BF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* 点位卡片 */
.spot-card {
  display: flex;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.spot-photo {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-right: 3rpx solid #1C1C1C;
}
.spot-body {
  flex: 1;
  min-width: 0;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.spot-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.spot-name {
  color: #1C1C1C;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.3;
}
/* 审核状态徽章：审核中（黄）/ 已通过（青）/ 未通过（红描边） */
.status-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  font-size: 19rpx;
  font-weight: 700;
  border: 2rpx solid #1C1C1C;
  border-radius: 999rpx;
}
.status-badge.pending {
  background: #F6D081;
  color: #1C1C1C;
}
.status-badge.approved {
  background: #34B8C5;
  color: #FFFFFF;
}
.status-badge.rejected {
  background: #FFFFFF;
  color: #D9463F;
  border-color: #D9463F;
}
.spot-review-note {
  color: #D9463F;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.5;
}
.spot-addr {
  color: #6B7C8A;
  font-size: 21rpx;
  line-height: 1.45;
}
.spot-coord {
  color: #1888BF;
  font-size: 19rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.spot-note {
  color: #1C1C1C;
  font-size: 21rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.spot-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  border-left: 2rpx dashed rgba(28, 28, 28, 0.12);
}
.action-btn {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 800;
  border-radius: 999rpx;
  text-align: center;
  border: 3rpx solid #1C1C1C;
}
.action-btn.primary {
  background: #34B8C5;
  color: #FFFFFF;
}
.action-btn.danger {
  background: #FFFFFF;
  color: #D9463F;
  border-color: #D9463F;
}
.action-btn:active {
  transform: translate(2rpx, 2rpx);
}
