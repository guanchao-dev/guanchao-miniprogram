.login-page {
  min-height: 100vh;
}

.login-hero {
  padding: 40rpx 8rpx 0;
  text-align: center;
}

.login-mascot {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 10rpx;
}

.login-title {
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  color: #14324A;
}

.login-sub {
  margin-top: 10rpx;
  color: #6B7C8A;
  font-size: 24rpx;
  line-height: 1.6;
}

.login-card {
  margin-top: 32rpx;
  padding: 32rpx 24rpx 28rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: auto;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1.2;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #F3FBFA;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.avatar-tip {
  color: #6B7C8A;
  font-size: 19rpx;
  font-weight: 700;
}

.nickname-input {
  flex: 1;
  height: 84rpx;
  padding: 0 22rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  box-sizing: border-box;
}

.login-note {
  margin-top: 16rpx;
  color: #9AA8B2;
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  border-width: 4rpx;
  background: #2E9E5B;
  color: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  font-size: 27rpx;
  font-weight: 850;
  letter-spacing: 0.5rpx;
  box-sizing: border-box;
}
