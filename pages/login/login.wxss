.login-page {
  min-height: 100vh;
}

.login-hero {
  padding: 48rpx 8rpx 8rpx;
  text-align: center;
}

.login-mascot {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 12rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 850;
}

.login-sub {
  margin-top: 12rpx;
  color: #6B7C8A;
  font-size: 24rpx;
  line-height: 1.6;
}

.login-card {
  margin-top: 48rpx;
  padding: 40rpx 28rpx;
}

.login-btn {
  width: 100%;
  height: 84rpx;
  background: #20B85A;
  color: #FFFFFF;
  box-sizing: border-box;
}
