<view class="page memphis-bg">
  <view class="page-content">
    <view class="hero">
      <view class="hero-title">宝藏地点</view>
      <view class="hero-sub">大家发现、由我们实地核对后收录的赶海好去处</view>
    </view>

    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>

    <view class="card empty-card" wx:elif="{{empty}}">
      <text class="empty-icon">🧭</text>
      <view class="empty-title">还没有宝藏地点</view>
      <view class="empty-sub">上传你发现的赶海点，审核通过后就会出现在这里</view>
      <view class="empty-cta" bindtap="goShare" hover-class="tap">去上传</view>
    </view>

    <block wx:else>
      <view
        class="card list-card"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openDetail"
        hover-class="tap"
      >
        <view class="list-row">
          <text class="list-title">{{item.name}}</text>
          <text class="badge">用户推荐</text>
        </view>
        <view class="list-meta">{{item.city}}{{item.distanceText ? ' · ' + item.distanceText : ''}}</view>
        <view class="list-note" wx:if="{{item.note}}">{{item.note}}</view>
        <view class="chip-row" wx:if="{{item.safetyTags.length}}">
          <text class="chip" wx:for="{{item.safetyTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
      </view>

      <view class="list-foot-tip">这些地点由赶海用户分享，我们实地核对后收录</view>
    </block>
  </view>
</view>

<watch-ball />
