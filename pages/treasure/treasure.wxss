.hero {
  padding: 24rpx 8rpx 20rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 850;
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

/* 标题 + 「用户推荐」角标 */
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: var(--blue);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}
.list-note {
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1.55;
}

/* 空状态 */
.empty-card {
  padding: 64rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-icon {
  font-size: 96rpx;
}
.empty-title {
  font-size: 34rpx;
  font-weight: 850;
}
.empty-sub {
  color: var(--muted);
  font-size: 24rpx;
  text-align: center;
  line-height: 1.55;
}
.empty-cta {
  margin-top: 12rpx;
  padding: 18rpx 40rpx;
  background: var(--yellow);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  border: 3rpx solid var(--ink);
  border-radius: 26rpx;
  box-shadow: var(--shadow);
}
.empty-cta:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}

.list-foot-tip {
  padding: 12rpx 8rpx 40rpx;
  color: var(--muted);
  font-size: 22rpx;
  text-align: center;
}
