.wall-page {
  padding-top: 12rpx;
}

/* 顶部进度卡 + 下方勋章展柜，统一"展柜"风格：墨色描边 + 金色硬投影 + 暖底 */
.wall-header {
  padding: 24rpx 26rpx 22rpx;
  box-shadow: 4rpx 4rpx 0 #E0A83A;
  background: #FFFBF2;
}

.wall-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 标题前一抹金色，和展柜金边呼应 */
.wall-accent {
  width: 10rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #E0A83A;
}

.wall-title {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: .5rpx;
}

.wall-sub {
  margin-top: 8rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.wall-track {
  position: relative;
  height: 20rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFF6E0;
}

.wall-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1888BF, #34B8C5);
  transition: width 0.4s ease-out;
}

/* 勋章展柜：与成就页勋章墙同一套金色语言 */
.wall-grid {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding: 32rpx 12rpx 12rpx;
  box-shadow: 4rpx 4rpx 0 #E0A83A;
  background: #FFFBF2;
}

/* 展柜顶部一条金色饰线，中间一颗菱形 */
.wall-topline {
  position: absolute;
  top: 15rpx;
  left: 28rpx;
  right: 28rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: rgba(224, 168, 58, .7);
  pointer-events: none;
}

.wall-topline-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 3rpx;
  background: #E0A83A;
  transform: rotate(45deg);
}

.wall-cell {
  position: relative;
  width: 23%;
  height: 192rpx;
  margin-right: 2.666%;
  margin-bottom: 16rpx;
  padding: 24rpx 4rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  /* 已解锁 = 金边；未解锁在下面降级成灰调 */
  border: 3rpx solid #E0A83A;
  border-radius: 18rpx;
  background: #FFFBF2;
  box-shadow: 2rpx 2rpx 0 rgba(224, 168, 58, .45);
}

.wall-cell:nth-child(4n) {
  margin-right: 0;
}

.wall-tag {
  position: absolute;
  top: 6rpx;
  left: 4rpx;
  z-index: 2;
  max-width: 92%;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 750;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 勋章图尽量铺满格子，只给名称留一行 */
.wall-icon {
  width: 124rpx;
  height: 124rpx;
  margin-bottom: 2rpx;
}

.wall-name {
  display: block;
  width: 100%;
  color: #2F3A4A;
  font-size: 18rpx;
  font-weight: 750;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wall-cell.locked {
  border-color: #DCE2E7;
  background: #F3F5F7;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.08);
}

.wall-cell.locked .wall-icon {
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 22rpx;
  opacity: 0.7;
}

.wall-cell.locked .wall-name {
  color: #9AA8B2;
}
