<view class="page memphis-bg wall-page">
  <view class="memphis-layer">
    <view class="geo-circle lg" style="top: 30rpx; right: -50rpx; background:#F6D081;"></view>
    <view class="geo-square sm" style="bottom: 100rpx; left: -24rpx; background:#A7D9C7;"></view>
  </view>

  <view class="page-content">
    <view class="wall-header card">
      <view class="wall-title-wrap">
        <view class="wall-accent"></view>
        <text class="wall-title">勋章墙</text>
      </view>
      <view class="wall-sub">已解锁 {{unlockedCount}} / {{total}} 枚勋章</view>
      <view class="wall-track">
        <view class="wall-fill" style="width: {{percent}}%;"></view>
      </view>
    </view>

    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>

    <view class="empty-tip" wx:elif="{{!medals.length}}">暂无勋章</view>

    <!-- 展柜顶部饰线：放在格子之后，避免打乱 .wall-cell:nth-child(4n) 的换行间距 -->
    <view class="wall-grid card" wx:else>
      <view
        class="wall-cell {{item.locked ? 'locked' : ''}}"
        wx:for="{{medals}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="goMedalDetail"
        hover-class="tap"
      >
        <view class="wall-tag" style="background: {{item.tagBg}}; color: {{item.tagColor}};">{{item.tag}}</view>
        <image class="wall-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="wall-name">{{item.locked ? '???' : item.title}}</text>
      </view>
      <view class="wall-topline"><view class="wall-topline-dot"></view></view>
    </view>
  </view>

  <watch-ball />
</view>