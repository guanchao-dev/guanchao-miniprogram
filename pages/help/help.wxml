<view class="page">
  <view class="page-content">
    <view class="card list-card">
      <view class="list-title">常见问题</view>
      <view wx:for="{{faq}}" wx:key="id" class="faq-item">
        <view class="list-title">{{item.q}}</view>
        <view class="list-meta">{{item.a}}</view>
      </view>
    </view>

    <view class="card list-card">
      <view class="list-title">意见反馈</view>
      <textarea class="note" maxlength="500" placeholder="说说你遇到的问题或建议" bindinput="onInput" value="{{content}}"></textarea>
      <view class="btn full-btn" bindtap="onSubmit">提交反馈</view>
    </view>
  </view>
</view>
