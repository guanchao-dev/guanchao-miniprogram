<view class="page">
  <view class="page-content">
    <view class="card list-card" wx:if="{{!loggedIn}}">
      <view class="list-title">账号</view>
      <view class="list-meta">登录后可同步观潮记录、成就与探索进度。</view>
      <view class="btn full-btn" bindtap="goLogin">登录 / 注册</view>
    </view>

    <view class="card list-card" wx:if="{{loggedIn}}">
      <view class="list-title">账号</view>
      <view class="btn full-btn" bindtap="onLogout">退出登录</view>
      <view class="btn full-btn settings-danger" bindtap="onDelete">注销并删除数据</view>
    </view>

    <view class="card list-card">
      <view class="list-title">监护人同意</view>
      <view class="list-meta">未成年人使用寻潮记，建议由监护人确认同意后再开始场地探索。</view>
      <view class="btn full-btn" bindtap="onConsent">我是监护人，确认同意</view>
      <view class="btn full-btn ghost-btn" bindtap="onWithdrawConsent">撤回监护人同意</view>
    </view>

    <view class="card list-card">
      <view class="list-title">隐私与协议</view>
      <view class="list-meta" wx:if="{{version}}">当前版本 {{version}}</view>
      <view class="btn full-btn ghost-btn" bindtap="openPrivacy">查看用户协议 / 隐私政策</view>
    </view>

    <view class="settings-version">寻潮记 · 最初版 0.3.0</view>
  </view>
</view>

<watch-ball />
