<view class="page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle md" style="top: 30rpx; right: -40rpx; background:#F6D081;"></view>
    <view class="geo-square sm" style="bottom: 220rpx; left: -30rpx; background:#34B8C5;"></view>
  </view>

  <view class="page-content">
    <!-- 账号 -->
    <view class="settings-group tone-teal" wx:if="{{!loggedIn}}">
      <view class="group-title"><text class="group-dot"></text>账号</view>
      <view class="card settings-card">
        <view class="settings-row" bindtap="goLogin" hover-class="tap">
          <text class="row-label">登录 / 注册</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="settings-group tone-teal" wx:if="{{loggedIn}}">
      <view class="group-title"><text class="group-dot"></text>账号</view>
      <view class="card settings-card">
        <view class="settings-row" bindtap="onLogout" hover-class="tap">
          <text class="row-label">退出登录</text>
          <text class="row-arrow">›</text>
        </view>
        <view class="row-divider"></view>
        <view class="settings-row danger" bindtap="onDelete" hover-class="tap">
          <text class="row-label">注销并删除数据</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 使用引导 -->
    <view class="settings-group tone-yellow">
      <view class="group-title"><text class="group-dot"></text>使用引导</view>
      <view class="card settings-card">
        <view class="settings-row" bindtap="onReplayOnboarding" hover-class="tap">
          <text class="row-label">再次查看新手教程</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="settings-group tone-coral">
      <view class="group-title"><text class="group-dot"></text>关于</view>
      <view class="card settings-card">
        <view class="settings-row" bindtap="goAbout" hover-class="tap">
          <text class="row-label">关于我们</text>
          <text class="row-arrow">›</text>
        </view>
        <view class="row-divider"></view>
        <view class="settings-row" bindtap="goFaq" hover-class="tap">
          <text class="row-label">常见问题</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 隐私与协议 -->
    <view class="settings-group tone-teal">
      <view class="group-title"><text class="group-dot"></text>隐私与协议</view>
      <view class="card settings-card">
        <view class="settings-row" bindtap="openPrivacy" hover-class="tap">
          <text class="row-label">用户协议 / 隐私政策</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="settings-version" wx:if="{{version}}">追潮记 · {{version}}</view>
  </view>
</view>

<watch-ball />
