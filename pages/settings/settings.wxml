<view class="page">
  <view class="page-content">
    <view class="card list-card">
      <view class="list-title">隐私与协议</view>
      <view class="list-meta" wx:if="{{version}}">当前版本 {{version}}</view>
      <view class="btn full-btn" bindtap="openPrivacy">查看用户协议 / 隐私政策</view>
    </view>

    <view class="card list-card">
      <view class="list-title">监护人同意</view>
      <view class="list-meta">未成年人使用观潮，建议由监护人确认同意。</view>
      <view class="btn full-btn" bindtap="onConsent">我是监护人，确认同意</view>
      <view class="btn full-btn" bindtap="onWithdrawConsent">撤回监护人同意</view>
    </view>

    <view class="card list-card">
      <view class="list-title">账号</view>
      <view class="btn full-btn" bindtap="onDelete">注销并删除数据</view>
    </view>
  </view>
</view>
