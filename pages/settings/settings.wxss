.settings-group {
  margin-bottom: 24rpx;
}

.group-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 8rpx 12rpx;
  padding: 0 4rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.group-dot {
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid var(--ink);
  border-radius: 50%;
  background: #34B8C5;
}

.settings-group.tone-yellow .group-dot {
  background: #F6D081;
}

.settings-group.tone-coral .group-dot {
  background: #F8A9A0;
}

.settings-card {
  padding: 0;
  overflow: hidden;
}

/* 列表行：统一的 88rpx 触控高度 */
.settings-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.settings-row:active {
  background: rgba(52, 184, 197, 0.08);
}

.row-label {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 800;
}

/* 右侧箭头：浅底圆片，压低存在感 */
.row-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(28, 28, 28, 0.06);
  color: var(--muted);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

.row-divider {
  height: 2rpx;
  margin-left: 24rpx;
  background: var(--line);
}

/* 危险操作 */
.settings-row.danger .row-label {
  color: var(--danger);
}

.settings-version {
  margin-top: 8rpx;
  color: #9AA8B2;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}
