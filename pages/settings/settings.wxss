.settings-group {
  margin-bottom: 28rpx;
}

.group-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 8rpx 14rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
  font-weight: 850;
  color: #4F6787;
  letter-spacing: 1rpx;
}

.group-dot {
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 50%;
  background: #34B8C5;
}

.settings-group.tone-yellow .group-dot {
  background: #F6D081;
}

.settings-group.tone-coral .group-dot {
  background: #F8A9A0;
}

.settings-card {
  padding: 0;
  overflow: hidden;
}

/* 列表行 */
.settings-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 24rpx;
}

.settings-row:active {
  background: rgba(52, 184, 197, 0.08);
}

.row-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 750;
  color: #1C1C1C;
}

.row-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(28, 28, 28, 0.06);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1;
  color: #9AA6B4;
}

.row-divider {
  height: 2rpx;
  margin-left: 24rpx;
  background: rgba(28, 28, 28, 0.08);
}

/* 危险操作 */
.settings-row.danger .row-label {
  color: #E64340;
}

.settings-version {
  margin-top: 12rpx;
  color: #9AA6B4;
  font-size: 20rpx;
  text-align: center;
}
