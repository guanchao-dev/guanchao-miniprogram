<view class="page memphis-bg home-page">
  <view class="memphis-layer">
    <view class="geo-square" style="bottom: 160rpx; left: -30rpx; background:#34B8C5;"></view>
    <!-- 气泡背景：呼应吉祥物"泡泡"，从底部缓慢上浮 -->
    <view class="bubble-layer">
      <view class="bubble b1"></view>
      <view class="bubble b2"></view>
      <view class="bubble b3"></view>
      <view class="bubble b4"></view>
      <view class="bubble b5"></view>
      <view class="bubble b6"></view>
      <view class="bubble b7"></view>
      <view class="bubble b8"></view>
      <view class="bubble b9"></view>
      <view class="bubble b10"></view>
      <view class="bubble b11"></view>
      <view class="bubble b12"></view>
      <view class="bubble b13"></view>
      <view class="bubble b14"></view>
      <!-- 粉色点缀泡泡 -->
      <view class="bubble b15 pink"></view>
      <view class="bubble b16 pink"></view>
    </view>
  </view>

  <view class="page-content">
    <view class="top-row">
      <view class="place-chip" bindtap="onTapPlace" hover-class="tap">
        <image class="place-icon" src="https://www.blueakaiwu.cn/api/v1/static/assets/home/home-pin.png" mode="aspectFit"></image>
        <text>{{place}}</text>
      </view>
      <view class="search-chip" bindtap="onSearch" hover-class="tap">
        <text>搜索潮汐 / 点位</text>
        <image class="search-icon" src="https://www.blueakaiwu.cn/api/v1/static/assets/home/home-search.png" mode="aspectFit"></image>
      </view>
    </view>

    <view class="hero card">
      <view class="hero-glow"></view>
      <view class="hero-copy">
        <view class="hero-kicker">追潮记 · 今日</view>
        <view class="hero-title">跟泡泡一起</view>
        <view class="hero-title">出发探索</view>
        <view id="onb-watch" class="btn watch-btn {{watchClass}}" bindtap="onWatchToggle" hover-class="tap">{{watchLabel}}</view>
      </view>
      <view class="hero-visual">
        <image class="hero-mascot" src="https://www.blueakaiwu.cn/api/v1/static/assets/to-upload/paopao-q-2x.png" mode="aspectFit"></image>
      </view>
    </view>

    <view id="onb-spots" class="hot-box card">
      <view class="hot-head">
        <text class="section-title">赶海地点热度排名</text>
        <text class="section-more" bindtap="goRecommend" hover-class="tap">全部 ›</text>
      </view>
      <view class="page-loading" wx:if="{{recLoading}}">
        <view class="spinner"></view>
        <text>加载中…</text>
      </view>
      <view class="empty-tip" wx:elif="{{!recommended.length}}">暂无推荐点位</view>
      <view class="hot-row" wx:for="{{recommended}}" wx:key="id" bindtap="goRecommend" hover-class="tap">
        <text class="hot-rank rank-{{index + 1}}">{{index + 1}}</text>
        <text class="hot-name">{{item.name}}</text>
        <text class="hot-heat">🔥 {{item.heat}}</text>
        <text class="hot-dist">{{item.distanceText}}</text>
      </view>
    </view>

    <view class="ai-row">
      <view id="onb-photo" class="ai-card photo" bindtap="onGuess" hover-class="tap">
        <view class="ai-orb"></view>
        <image class="ai-icon" src="https://www.blueakaiwu.cn/api/v1/static/assets/home/home-camera.png" mode="aspectFit"></image>
        <text class="ai-name">生物识别</text>
      </view>
      <view id="onb-trash" class="ai-card trash" bindtap="onTrashGuess" hover-class="tap">
        <view class="ai-orb"></view>
        <image class="ai-icon" src="https://www.blueakaiwu.cn/api/v1/static/assets/home/home-gear.png" mode="aspectFit"></image>
        <text class="ai-name">生态净滩</text>
      </view>
      <view id="onb-advice" class="ai-card advice" bindtap="onRefreshAdvice" hover-class="tap">
        <view class="ai-orb"></view>
        <image class="ai-icon" src="https://www.blueakaiwu.cn/api/v1/static/assets/home/home-nearby.png" mode="aspectFit"></image>
        <text class="ai-name">出门建议</text>
      </view>
    </view>

    <swiper
      id="onb-activity"
      class="activity-swiper"
      autoplay
      circular
      interval="3500"
      duration="500"
      bindchange="onActivityChange"
    >
      <swiper-item wx:for="{{activities}}" wx:key="id">
        <view class="activity-card {{item.theme}}" data-item="{{item}}" bindtap="onActivity" hover-class="tap">
          <block wx:if="{{item.theme === 'banner'}}">
            <image class="activity-bg" src="{{item.icon}}" mode="aspectFill"></image>
          </block>
          <block wx:else>
            <view class="activity-main">
              <text class="activity-tag">{{item.tag}}</text>
              <text class="activity-name">{{item.title}}</text>
              <text class="activity-desc">{{item.desc}}</text>
            </view>
            <image class="activity-illu" src="{{item.icon}}" mode="aspectFit"></image>
          </block>
        </view>
      </swiper-item>
    </swiper>
    <!-- 自定义圆点指示器 -->
    <view class="activity-dots">
      <view
        class="dot {{activityIndex === index ? 'active' : ''}}"
        wx:for="{{activities}}"
        wx:key="id"
      ></view>
    </view>
  </view>

  <!-- 出门建议弹窗 -->
  <view class="ai-mask" wx:if="{{showAdvice}}" bindtap="closeAdvice" catchtouchmove="noop">
    <view class="adv-card" catchtap="noop">
      <!-- 顶部：透明背景人物 + 标题 + 关闭 -->
      <view class="adv-header">
        <image class="adv-mascot" src="https://www.blueakaiwu.cn/api/v1/static/assets/to-upload/mascot-girl.png" mode="aspectFit"></image>
        <view class="adv-header-right">
          <text class="adv-sub">泡泡的赶海小提醒</text>
        </view>
        <text class="adv-close" bindtap="closeAdvice" hover-class="tap">×</text>
      </view>

      <!-- 核心判断：一句话告诉游客现在能不能去 -->
      <view class="adv-verdict {{advice.suitableNow ? 'go' : 'no'}}">{{advice.verdict}}</view>

      <!-- 后端每天预生成的建议文案 -->
      <view class="adv-copy" wx:if="{{advice.headline || advice.body}}">
        <text class="adv-copy-headline" wx:if="{{advice.headline}}">{{advice.headline}}</text>
        <text class="adv-copy-body" wx:if="{{advice.body}}">{{advice.body}}</text>
      </view>

      <!-- 适合赶海时才显示具体时间和推荐地点 -->
      <block wx:if="{{advice.suitableNow}}">
        <!-- 关键数据：最佳窗口 + 截止离场 -->
        <view class="adv-stats">
          <view class="adv-stat">
            <text class="adv-stat-num">{{advice.bestWindow}}</text>
            <text class="adv-stat-label">最佳赶海窗口</text>
          </view>
          <view class="adv-stat adv-stat-alert">
            <text class="adv-stat-num">{{advice.leaveBefore}}</text>
            <text class="adv-stat-label">涨潮前必须离场</text>
          </view>
        </view>

        <!-- 推荐地点 -->
        <view class="adv-spots" wx:if="{{advice.recommendedSpots.length}}">
          <view class="adv-spots-title">推荐赶海地点</view>
          <view
            class="adv-spot-item"
            wx:for="{{advice.recommendedSpots}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onAdviceSpot"
            hover-class="tap"
          >
            <view class="adv-spot-info">
              <text class="adv-spot-name">{{item.name}}</text>
              <text class="adv-spot-reason">{{item.reason}}</text>
            </view>
            <view class="adv-spot-right">
              <text class="adv-spot-dist">{{item.distance}}</text>
              <text class="adv-spot-arrow">›</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="ai-mask" wx:if="{{showGuess}}" bindtap="closeGuess" catchtouchmove="noop">
    <!-- 图鉴入口定位在这一层：.ai-modal 有 overflow:hidden（圆角需要），
         按钮要探出它的边框之外，作为子元素会被裁掉 -->
    <view class="ai-modal-wrap" catchtap="noop">
    <view class="ai-modal">
      <view class="ai-modal-head only-close">
        <text class="ai-close" bindtap="closeGuess" hover-class="tap">×</text>
      </view>
      <scroll-view scroll-y class="ai-modal-body">
        <image wx:if="{{guessImage}}" class="guess-photo" src="{{guessImage}}" mode="aspectFit"></image>

        <block wx:if="{{guess.isSeaCreature === false}}">
          <view class="not-sea">
            <text class="not-sea-title">{{guess.message}}</text>
            <text class="not-sea-tip">小螃蟹只认潮间带的小生物。把镜头对准海边的礁石、潮池或沙滩上的生物，靠近一点再拍一张试试。</text>
          </view>
        </block>
        <block wx:else>
          <block wx:for="{{guessItems}}" wx:for-item="obj" wx:for-index="oi" wx:key="key">
            <view class="guess-item">
              <view class="guess-item-head">
                <text class="guess-item-label">{{obj.label}}</text>
                <text class="guess-item-count" wx:if="{{obj.count > 1}}">×{{obj.count}}</text>
              </view>

              <block wx:for="{{obj.visibleCandidates}}" wx:for-item="cand" wx:key="rank">
                <view class="candidate">
                  <view data-item="{{cand}}" bindtap="openWiki" hover-class="tap">
                    <view class="candidate-top">
                      <text class="candidate-name">{{cand.name}}</text>
                      <text class="candidate-prob">{{cand.probabilityText}}</text>
                    </view>
                    <text class="candidate-latin" wx:if="{{cand.latinName}}">{{cand.latinName}}</text>
                    <view class="candidate-bar">
                      <view class="candidate-bar-fill" style="width: {{cand.probability * 100}}%;"></view>
                    </view>
                    <text class="candidate-reason">{{cand.reason}}</text>
                    <text class="candidate-wiki" wx:if="{{cand.inEncyclopedia}}">图鉴对照 ›</text>
                  </view>
                  <view
                    class="confirm-species {{obj.confirmedRank === cand.rank ? 'done' : ''}} {{obj.confirmedRank > 0 && obj.confirmedRank !== cand.rank ? 'muted' : ''}}"
                    data-item="{{cand}}"
                    data-oi="{{oi}}"
                    catchtap="onConfirmSpecies"
                  >{{obj.confirmedRank === cand.rank ? '已记入观潮记录 ✓' : '就是这个物种'}}</view>
                </view>
              </block>

              <view class="more-guess" wx:if="{{obj.candidates.length > 1}}" data-oi="{{oi}}" bindtap="toggleItemAll">
                {{obj.expanded ? '收起其他结果 ▲' : '显示其他 ' + (obj.candidates.length - 1) + ' 个结果 ▼'}}
              </view>
            </view>
          </block>
        </block>

      </scroll-view>
    </view>
      <!-- 图鉴入口：贴在弹窗左上角外侧。放在 .ai-modal 之外，才不会被它的
           overflow:hidden 裁掉。点它不关弹窗 —— 用户看完图鉴返回时识别结果还在。 -->
      <view class="wiki-entry" bindtap="goWiki" hover-class="wiki-entry-hover" hover-stay-time="80">
        <image class="wiki-entry-img" src="https://www.blueakaiwu.cn/api/v1/static/assets/home/home-wiki-entry.png" mode="aspectFit"></image>
      </view>
    </view>
  </view>
  <view class="ai-mask" wx:if="{{showTrash}}" bindtap="closeTrash" catchtouchmove="noop">
    <view class="ai-modal" catchtap="noop">
      <view class="ai-modal-head">
        <text>{{trash.isTrash === false ? '小螃蟹没看到垃圾' : '垃圾分类小助手'}}</text>
        <text class="ai-close" bindtap="closeTrash" hover-class="tap">×</text>
      </view>
      <scroll-view scroll-y class="ai-modal-body">
        <image wx:if="{{trashImage}}" class="guess-photo" src="{{trashImage}}" mode="aspectFit"></image>

        <block wx:if="{{trash.isTrash === false}}">
          <view class="not-sea">
            <text class="not-sea-title">{{trash.message}}</text>
            <text class="not-sea-tip">把小螃蟹对准沙滩上的塑料袋、饮料瓶、渔网这类废弃物，靠近一点再拍一张试试。</text>
          </view>
        </block>
        <block wx:else>
          <!-- 这次的垃圾量：少 / 中等 / 多（以件数为主） -->
          <view class="trash-amount" wx:if="{{trash.amount}}">
            <text class="trash-amount-k">这次的垃圾量</text>
            <text class="trash-amount-v lv-{{trash.amount}}">{{trash.amountText}}</text>
          </view>

          <block wx:for="{{trashItems}}" wx:for-item="obj" wx:for-index="oi" wx:key="key">
            <view class="candidate trash-item">
              <view class="guess-item-head">
                <text class="guess-item-label">{{obj.label}}</text>
                <text class="guess-item-count" wx:if="{{obj.count > 1}}">×{{obj.count}}</text>
              </view>
              <view class="candidate-top">
                <text class="candidate-name">{{obj.name}}</text>
              </view>
              <view class="trash-cat cat-{{obj.category}}">{{obj.categoryLabel}}</view>
              <text class="candidate-reason">{{obj.reason}}</text>

              <view class="trash-block" wx:if="{{obj.tip}}">
                <text class="trash-block-label">怎么处理</text>
                <text class="trash-block-text">{{obj.tip}}</text>
              </view>
              <view class="trash-block hazard" wx:if="{{obj.hazardNote}}">
                <text class="trash-block-label">对海洋的影响</text>
                <text class="trash-block-text">{{obj.hazardNote}}</text>
              </view>

              <view
                class="confirm-species {{obj.confirmed ? 'done' : ''}}"
                data-oi="{{oi}}"
                catchtap="onConfirmTrash"
              >{{obj.confirmed ? '已记入观潮记录 ✓' : '就是它，记进观潮记录'}}</view>
            </view>
          </block>
        </block>
      </scroll-view>
    </view>
  </view>
  <unlock-popup id="unlockPopup"></unlock-popup>
</view>

<!-- 开始观潮前的地点选择：推荐点位（距离+热度）或地图自选 -->
<view class="spot-mask" wx:if="{{spotPickerVisible}}" bindtap="closeSpotPicker" catchtouchmove="noop">
  <view class="spot-sheet" catchtap="noop">
    <view class="spot-sheet-head">
      <text class="spot-sheet-title">选择观潮地点</text>
      <text class="spot-sheet-close" bindtap="closeSpotPicker" hover-class="tap">×</text>
    </view>

    <view class="spot-loading" wx:if="{{watchSpotsLoading}}">推荐地点加载中…</view>
    <block wx:else>
      <view class="spot-list">
        <view
          class="spot-row"
          wx:for="{{watchSpots}}"
          wx:key="id"
          data-index="{{index}}"
          bindtap="onPickWatchSpot"
         hover-class="tap">
          <view class="spot-rank">{{index + 1}}</view>
          <view class="spot-row-main">
            <text class="spot-row-name">{{item.name}}</text>
            <view class="spot-row-tags">
              <text class="spot-tag dist">{{item.distanceText}}</text>
              <text class="spot-tag heat">热度 {{item.heat}}</text>
            </view>
          </view>
          <text class="spot-row-go">›</text>
        </view>
        <view class="spot-empty" wx:if="{{!watchSpots.length}}">暂时没有推荐点位，可以从地图自选</view>
      </view>

      <view class="spot-custom" bindtap="onChooseCustomSpot" hover-class="tap">
        <text class="spot-custom-icon">📍</text>
        <view class="spot-custom-main">
          <text class="spot-custom-title">地图上自己选</text>
          <text class="spot-custom-sub">打开地图挑选当前位置或任意赶海点</text>
        </view>
        <text class="spot-row-go">›</text>
      </view>
    </block>
  </view>
</view>

<onboarding
  visible="{{showOnboarding}}"
  start-index="{{onbStartIndex}}"
  target-rect="{{onbRect}}"
  bind:finish="onOnboardingFinish"
  bind:locate="onOnboardingLocate"
/>

<watch-ball />
