.ai-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  background: rgba(11, 31, 56, 0.56);
}

/* 图鉴按钮的定位层。它本身不带 overflow:hidden，按钮才能探出弹窗边框。 */
.ai-modal-wrap {
  position: relative;
  width: 100%;
}

.ai-modal {
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
  border: 4rpx solid #1C1C1C;
  border-radius: 32rpx;
  background: #EAF3FF;
  /* flex 列布局：内容区自适应收缩并在内部滚动。
     块级布局下头部 + 内容区(写死 max-height:68vh) 之和可能超过 80vh，
     超出部分会被 overflow:hidden 裁掉且滚不到 —— 底部按钮会点不到。 */
  display: flex;
  flex-direction: column;
}

.ai-modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 8rpx;
  font-size: 32rpx;
  font-weight: 850;
}

/* 识别弹窗的头部只剩关闭按钮（标题已按需求移除）。
   space-between 在只有一个子元素时会把它顶到左边，这里改成靠右。 */
.ai-modal-head.only-close {
  justify-content: flex-end;
}

.ai-close {
  font-size: 44rpx;
  font-weight: 300;
}

/* 图鉴入口：贴屏幕左缘、压在弹窗左上角上方的大按钮。
   - 绝对定位到 .ai-modal-wrap（弹窗的定位父级）；
   - left: -24rpx 正好抵掉 .ai-mask 的左边距，让按钮左缘落在屏幕边上；
   - top: -110rpx 让按钮探到弹窗上方。这个值受「屏幕上沿到弹窗上沿的余量」限制：
     弹窗最高 80vh 时该余量约 130~160rpx（视屏高），再往上加会顶到屏幕外；
   - 旋转 20° 是逆时针（CSS 负角度）；
   - z-index 要高过弹窗，否则会被弹窗盖住。 */
.wiki-entry {
  position: absolute;
  top: -110rpx;
  left: -24rpx;
  width: 288rpx;
  height: 288rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-20deg);
}

.wiki-entry-hover {
  opacity: 0.6;
}

.wiki-entry-img {
  width: 100%;
  height: 100%;
}

.ai-modal-body {
  /* flex:1 + min-height:0 让内容区在头部变高时自动收缩并内部滚动。
     min-height 必须显式置 0 —— flex 子项默认不会缩到内容高度以下。 */
  flex: 1;
  min-height: 0;
  max-height: 68vh;
  padding: 8rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.guess-photo {
  width: 100%;
  height: 220rpx;
  margin-bottom: 8rpx;
  border-radius: 16rpx;
  background: #fff;
}

.candidate {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
}

.candidate-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.candidate-name {
  font-size: 28rpx;
  font-weight: 800;
}

.candidate-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #D6EAF8;
  color: #1878FF;
  font-size: 20rpx;
}

.candidate-prob {
  font-size: 26rpx;
  font-weight: 850;
  color: #1878FF;
}

.candidate-bar {
  margin-top: 8rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #E3EEF7;
  overflow: hidden;
}

.candidate-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #34B8C5, #1878FF);
}

.candidate-latin {
  display: block;
  margin-top: 4rpx;
  color: #8A97A3;
  font-size: 20rpx;
  font-style: italic;
}

.candidate-wiki {
  display: inline-block;
  margin-top: 8rpx;
  color: #1878FF;
  font-size: 20rpx;
}

.more-guess {
  margin-top: 16rpx;
  padding: 18rpx 0;
  text-align: center;
  color: #1878FF;
  font-size: 24rpx;
  font-weight: 750;
  border-top: 2rpx dashed #DCE6EE;
}

.confirm-species {
  margin-top: 14rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  border: 3rpx solid #1878FF;
  border-radius: 999rpx;
  color: #1878FF;
  font-size: 24rpx;
  font-weight: 750;
  box-sizing: border-box;
}

.confirm-species.done {
  background: #20B85A;
  border-color: #20B85A;
  color: #FFFFFF;
}

.confirm-species.muted {
  border-color: #C9D2DA;
  color: #A8B3BD;
}

.not-sea {
  margin-top: 20rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(246, 208, 129, 0.28);
  text-align: center;
}

.not-sea-title {
  display: block;
  font-size: 32rpx;
  font-weight: 850;
  color: #8A5B00;
}

.not-sea-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7A6A4A;
}

/* ===== 多物品：照片里的每个发现各占一组 ===== */
.guess-item {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed #DCE6EE;
}

.guess-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.guess-item-label {
  color: #1C1C1C;
  font-size: 26rpx;
  font-weight: 850;
}

.guess-item-count {
  color: #7A6A4A;
  font-size: 22rpx;
  font-weight: 800;
}

.trash-item {
  margin-top: 18rpx;
}

/* ===== 垃圾识别：这次的垃圾量（少 / 中等 / 多）===== */
.trash-amount {
  display: flex;
  align-items: center;
  margin: 16rpx 0 2rpx;
}

.trash-amount-k {
  font-size: 26rpx;
  font-weight: 800;
  color: #4F6787;
}

.trash-amount-v {
  margin-left: 14rpx;
  padding: 4rpx 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid #1C1C1C;
  font-size: 26rpx;
  font-weight: 850;
}

/* 越严重越暖：少=青绿，中等=琥珀，多=砖红 */
.trash-amount-v.lv-little {
  background: #D9F2E6;
  color: #1F7A55;
}

.trash-amount-v.lv-some {
  background: #FDF0D0;
  color: #9A6B12;
}

.trash-amount-v.lv-much {
  background: #FBDDD6;
  color: #B03A22;
}

/* ===== 垃圾识别：国标四分类配色 ===== */
.trash-cat {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

/* 与垃圾桶颜色对应：可回收蓝、有害红、厨余绿、其他灰 */
.cat-recyclable {
  background: #D6EAF8;
  color: #1163C7;
}

.cat-hazardous {
  background: #FBE0E0;
  color: #C22B2B;
}

.cat-kitchen {
  background: #DCF3E5;
  color: #1F7F49;
}

.cat-other {
  background: #E6EBF0;
  color: #55636F;
}

.trash-block {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
}

.trash-block.hazard {
  background: rgba(251, 224, 224, 0.5);
}

.trash-block-label {
  display: block;
  font-size: 24rpx;
  font-weight: 850;
  color: #1C1C1C;
}

.trash-block-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #4F6787;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
}

/* ===== 开始观潮：地点选择弹窗 ===== */
.spot-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  background: rgba(11, 31, 56, 0.56);
}

.spot-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border: 3rpx solid #1C1C1C;
  border-bottom: none;
  border-radius: 32rpx 32rpx 0 0;
  background: #FBF7EF;
  box-shadow: 0 -6rpx 0 rgba(28, 28, 28, 0.15);
  box-sizing: border-box;
}

.spot-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.spot-sheet-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1C1C1C;
}

.spot-sheet-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 36rpx;
  font-weight: 800;
  color: #1C1C1C;
}

.spot-sheet-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7A6A4A;
}

.spot-loading,
.spot-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #7A6A4A;
}

.spot-list {
  margin-top: 20rpx;
}

.spot-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 22rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.spot-rank {
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
  line-height: 48rpx;
  text-align: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #F6D081;
  font-size: 26rpx;
  font-weight: 900;
  color: #1C1C1C;
  flex-shrink: 0;
}

.spot-row:nth-child(1) .spot-rank { background: #F2B138; }
.spot-row:nth-child(2) .spot-rank { background: #C9D6DE; }
.spot-row:nth-child(3) .spot-rank { background: #E2A97B; }

.spot-row-main {
  flex: 1;
  min-width: 0;
}

.spot-row-name {
  display: block;
  font-size: 28rpx;
  font-weight: 850;
  color: #1C1C1C;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.spot-row-tags {
  display: flex;
  margin-top: 10rpx;
}

.spot-tag {
  margin-right: 12rpx;
  padding: 4rpx 14rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.spot-tag.dist {
  background: #DDF3F6;
  color: #0E7C92;
}

.spot-tag.heat {
  background: #FDECC8;
  color: #8A5B00;
}

.spot-row-go {
  margin-left: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #B7A98E;
}

/* 地图自选入口：青底与推荐行区分 */
.spot-custom {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 22rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #CDEFF4;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.spot-custom-icon {
  margin-right: 16rpx;
  font-size: 40rpx;
}

.spot-custom-main {
  flex: 1;
  min-width: 0;
}

.spot-custom-title {
  display: block;
  font-size: 28rpx;
  font-weight: 850;
  color: #1C1C1C;
}

.spot-custom-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #4F6787;
}
