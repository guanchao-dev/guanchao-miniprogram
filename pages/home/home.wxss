.home-page {
  padding-top: 20rpx;
  overflow: auto;
}

.top-row {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.place-chip,
.search-chip {
  display: flex;
  align-items: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.place-chip {
  padding: 8rpx 16rpx;
  gap: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.search-chip {
  flex: 1;
  justify-content: space-between;
  padding: 8rpx 16rpx;
  color: #6B7C8A;
  font-size: 20rpx;
}

.place-icon,
.search-icon {
  width: 34rpx;
  height: 34rpx;
}

.hero {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  min-height: 240rpx;
  padding: 24rpx 12rpx 20rpx 28rpx;
  overflow: hidden;
  /* 透明底 Q 版章鱼配浅海青渐变，呼应插画里的海浪蓝 */
  background: linear-gradient(135deg, #F0FAFC 0%, #DCF2F6 100%);
}

/* 左上柔光 */
.hero-glow {
  position: absolute;
  top: -120rpx;
  left: -80rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 70%);
  z-index: 1;
  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 52%;
  flex-shrink: 0;
}

.hero-kicker {
  color: #1888BF;
  font-size: 20rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.2;
}

.hero-kicker + .hero-title {
  margin-top: 8rpx;
}

.watch-btn {
  margin-top: 18rpx;
  min-width: 180rpx;
}

.watch-btn.is-on {
  background: #34B8C5;
  color: #FFFFFF;
}

.watch-btn.is-end {
  background: #F6D081;
  color: #1C1C1C;
}

.hero-visual {
  position: relative;
  z-index: 2;
  flex: 1;
  height: 224rpx;
  margin-left: 4rpx;
}

.hero-mascot {
  position: absolute;
  right: 8rpx;
  bottom: 6rpx;
  width: 308rpx;
  height: 221rpx;
  z-index: 2;
}

.ai-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.ai-card {
  position: relative;
  z-index: 2;
  flex: 1;
  height: 212rpx;
  padding: 20rpx 12rpx 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 4rpx solid #1C1C1C;
  border-radius: 28rpx;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.ai-card.photo {
  background: linear-gradient(165deg, #E7FBFC 0%, #5EC9D4 100%);
}

.ai-card.advice {
  background: linear-gradient(165deg, #FFF8E8 0%, #F6D081 100%);
}

.ai-orb {
  position: absolute;
  top: 14rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
}

.ai-icon {
  position: relative;
  z-index: 1;
  width: 112rpx;
  height: 112rpx;
}

.ai-name {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 850;
}

.spot-section {
  position: relative;
  z-index: 2;
  margin-top: 8rpx;
}

.hot-box {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  padding: 4rpx 8rpx 6rpx;
}

.hot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx 4rpx;
}

.hot-head .section-title {
  font-size: 30rpx;
}

.hot-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 16rpx;
}

.hot-row + .hot-row {
  border-top: 2rpx solid rgba(28, 28, 28, 0.08);
}

.hot-rank {
  width: 40rpx;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
  flex-shrink: 0;
}

.hot-rank.rank-1 { color: #E23D3D; }
.hot-rank.rank-2 { color: #E8892E; }
.hot-rank.rank-3 { color: #1888BF; }

.hot-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
}

.hot-heat,
.hot-dist {
  color: #6B7C8A;
  font-size: 20rpx;
  font-weight: 650;
  flex-shrink: 0;
}

.hot-heat {
  color: #184D97;
}

.advice-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
}

.advice-key {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.advice-key-item {
  padding: 8rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F3FBFA;
  color: #1888BF;
  font-size: 24rpx;
  font-weight: 800;
}

.advice-key-item.key-go {
  background: #34B8C5;
  color: #FFFFFF;
}

.advice-key-item.key-no {
  background: #F6D081;
  color: #1C1C1C;
}

.advice-body {
  display: block;
  margin-top: 20rpx;
  color: #1C1C1C;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.65;
}

.advice-safety {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(52, 184, 197, 0.1);
}

.advice-safety-label {
  display: block;
  color: #1888BF;
  font-size: 22rpx;
  font-weight: 800;
}

.advice-safety-text {
  display: block;
  margin-top: 6rpx;
  color: #4F6787;
  font-size: 24rpx;
  line-height: 1.6;
}

/* ===== 出门建议：泡泡对话式弹窗 ===== */
.adv-card {
  width: 100%;
  max-height: 84vh;
  overflow: hidden;
  border: 4rpx solid #1C1C1C;
  border-radius: 32rpx;
  background: #FBF7EF;
}

/* 顶部蓝带：底色与吉祥物 PNG 背景 #A4C8DB 一致，图片无缝融入 */
.adv-band {
  position: relative;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 18rpx 24rpx;
  background: #A4C8DB;
}

.adv-mascot {
  width: 124rpx;
  height: 126rpx;
  flex-shrink: 0;
}

.adv-band-copy {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
}

.adv-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #102A3D;
}

.adv-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #2F5E78;
}

.adv-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 36rpx;
  font-weight: 800;
  color: #1C1C1C;
  flex-shrink: 0;
}

/* 气泡：白底黑边硬阴影，小尾巴指向左上的泡泡 */
.adv-bubble {
  position: relative;
  margin: 4rpx 24rpx 0;
  padding: 24rpx 24rpx 26rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.adv-bubble-tail {
  position: absolute;
  top: -11rpx;
  left: 48rpx;
  width: 20rpx;
  height: 20rpx;
  background: #FFFFFF;
  border-left: 3rpx solid #1C1C1C;
  border-top: 3rpx solid #1C1C1C;
  transform: rotate(45deg);
}

.adv-bubble .advice-title {
  font-size: 32rpx;
  line-height: 1.4;
}

.adv-scroll {
  max-height: 46vh;
  padding: 22rpx 28rpx 30rpx;
  box-sizing: border-box;
}

.advice-extra,
.candidate-reason,
.ai-hint,
.obs {
  display: block;
  margin-top: 8rpx;
  color: #4F6787;
  font-size: 24rpx;
  line-height: 1.55;
}

.advice-disc {
  display: block;
  margin-top: 20rpx;
  color: #8A7A6B;
  font-size: 20rpx;
  line-height: 1.5;
}

.ai-hint {
  color: #8A7A6B;
  font-size: 20rpx;
}

/* ===== 相关活动自动轮播 ===== */
.activity-swiper {
  position: relative;
  z-index: 2;
  height: 240rpx;
  margin-top: 24rpx;
}

.activity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 240rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  border: 4rpx solid #1C1C1C;
  border-radius: 28rpx;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  overflow: hidden;
}

.activity-card.teal {
  background: linear-gradient(135deg, #E7FBFC 0%, #BDEFF3 100%);
}

.activity-card.yellow {
  background: linear-gradient(135deg, #FFF8E8 0%, #F6E0AC 100%);
}

.activity-card.banner {
  position: relative;
  padding: 0;
  background: #0A2A4A;
}

.activity-card.banner .activity-bg {
  position: absolute;
  top: -3%;
  left: -3%;
  display: block;
  width: 106%;
  height: 106%;
}

.activity-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.activity-tag {
  padding: 4rpx 18rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
}

.activity-name {
  margin-top: 10rpx;
  color: #1C1C1C;
  font-size: 36rpx;
  font-weight: 900;
}

.activity-desc {
  margin-top: 6rpx;
  color: #4F6787;
  font-size: 22rpx;
}

.activity-illu {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ai-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  background: rgba(11, 31, 56, 0.56);
}

/* 只有「识别结果」那个弹窗的遮罩才加左边距 —— 图鉴按钮跨在它左上角、
   向左要探出约 70rpx，原来的 24rpx 会让按钮超出屏幕左边缘。
   出行建议 / 垃圾识别两个弹窗共用 .ai-mask，不能一起改。 */
.ai-mask.with-corner-entry {
  padding-left: 88rpx;
}

/* 图鉴按钮的定位层。它本身不带 overflow:hidden，按钮才能探出弹窗边框。 */
.ai-modal-wrap {
  position: relative;
  width: 100%;
}

.ai-modal {
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
  border: 4rpx solid #1C1C1C;
  border-radius: 32rpx;
  background: #EAF3FF;
  /* flex 列布局：内容区自适应收缩并在内部滚动。
     块级布局下头部 + 内容区(写死 max-height:68vh) 之和可能超过 80vh，
     超出部分会被 overflow:hidden 裁掉且滚不到 —— 底部按钮会点不到。 */
  display: flex;
  flex-direction: column;
}

.ai-modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 8rpx;
  font-size: 32rpx;
  font-weight: 850;
}

.ai-close {
  font-size: 44rpx;
  font-weight: 300;
}

/* 图鉴入口：跨在弹窗左上角边框上，一半在弹窗外、一半压着弹窗。
   - 绝对定位到 .ai-modal-wrap（弹窗的定位父级），负的 top/left 各 70rpx
     正好让 140rpx 的按钮中心落在弹窗左上角上；
   - rotate 后 140rpx 的方形外接框约 180rpx，四周各再溢出约 20rpx，
     遮罩左侧留了 88rpx 足够容纳；
   - 20° 是逆时针（CSS 负角度）。
   - z-index 要高过弹窗，否则会被弹窗盖住。 */
.wiki-entry {
  position: absolute;
  top: -70rpx;
  left: -70rpx;
  width: 140rpx;
  height: 140rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-20deg);
}

.wiki-entry-hover {
  opacity: 0.6;
}

.wiki-entry-img {
  width: 100%;
  height: 100%;
}

.ai-modal-body {
  /* flex:1 + min-height:0 让内容区在头部变高时自动收缩并内部滚动。
     min-height 必须显式置 0 —— flex 子项默认不会缩到内容高度以下。 */
  flex: 1;
  min-height: 0;
  max-height: 68vh;
  padding: 8rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.guess-photo {
  width: 100%;
  height: 220rpx;
  margin-bottom: 8rpx;
  border-radius: 16rpx;
  background: #fff;
}

.candidate {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
}

.candidate-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.candidate-name {
  font-size: 28rpx;
  font-weight: 800;
}

.candidate-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #D6EAF8;
  color: #1878FF;
  font-size: 20rpx;
}

.candidate-prob {
  font-size: 26rpx;
  font-weight: 850;
  color: #1878FF;
}

.candidate-bar {
  margin-top: 8rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #E3EEF7;
  overflow: hidden;
}

.candidate-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #34B8C5, #1878FF);
}

.candidate-latin {
  display: block;
  margin-top: 4rpx;
  color: #8A97A3;
  font-size: 20rpx;
  font-style: italic;
}

.candidate-wiki {
  display: inline-block;
  margin-top: 8rpx;
  color: #1878FF;
  font-size: 20rpx;
}

.more-guess {
  margin-top: 16rpx;
  padding: 18rpx 0;
  text-align: center;
  color: #1878FF;
  font-size: 24rpx;
  font-weight: 750;
  border-top: 2rpx dashed #DCE6EE;
}

.confirm-species {
  margin-top: 14rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  border: 3rpx solid #1878FF;
  border-radius: 999rpx;
  color: #1878FF;
  font-size: 24rpx;
  font-weight: 750;
  box-sizing: border-box;
}

.confirm-species.done {
  background: #20B85A;
  border-color: #20B85A;
  color: #FFFFFF;
}

.confirm-species.muted {
  border-color: #C9D2DA;
  color: #A8B3BD;
}

.not-sea {
  margin-top: 20rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(246, 208, 129, 0.28);
  text-align: center;
}

.not-sea-title {
  display: block;
  font-size: 32rpx;
  font-weight: 850;
  color: #8A5B00;
}

.not-sea-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7A6A4A;
}

/* ===== 多物品：照片里的每个发现各占一组 ===== */
.guess-item {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed #DCE6EE;
}

.guess-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.guess-item-label {
  color: #1C1C1C;
  font-size: 26rpx;
  font-weight: 850;
}

.guess-item-count {
  color: #7A6A4A;
  font-size: 22rpx;
  font-weight: 800;
}

.trash-item {
  margin-top: 18rpx;
}

/* ===== 垃圾识别：国标四分类配色 ===== */
.trash-cat {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

/* 与垃圾桶颜色对应：可回收蓝、有害红、厨余绿、其他灰 */
.cat-recyclable {
  background: #D6EAF8;
  color: #1163C7;
}

.cat-hazardous {
  background: #FBE0E0;
  color: #C22B2B;
}

.cat-kitchen {
  background: #DCF3E5;
  color: #1F7F49;
}

.cat-other {
  background: #E6EBF0;
  color: #55636F;
}

.trash-block {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
}

.trash-block.hazard {
  background: rgba(251, 224, 224, 0.5);
}

.trash-block-label {
  display: block;
  font-size: 24rpx;
  font-weight: 850;
  color: #1C1C1C;
}

.trash-block-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #4F6787;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
}

/* ===== 开始观潮：地点选择弹窗 ===== */
.spot-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  background: rgba(11, 31, 56, 0.56);
}

.spot-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border: 3rpx solid #1C1C1C;
  border-bottom: none;
  border-radius: 32rpx 32rpx 0 0;
  background: #FBF7EF;
  box-shadow: 0 -6rpx 0 rgba(28, 28, 28, 0.15);
  box-sizing: border-box;
}

.spot-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.spot-sheet-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1C1C1C;
}

.spot-sheet-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 36rpx;
  font-weight: 800;
  color: #1C1C1C;
}

.spot-sheet-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7A6A4A;
}

.spot-loading,
.spot-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #7A6A4A;
}

.spot-list {
  margin-top: 20rpx;
}

.spot-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 22rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.spot-rank {
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
  line-height: 48rpx;
  text-align: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #F6D081;
  font-size: 26rpx;
  font-weight: 900;
  color: #1C1C1C;
  flex-shrink: 0;
}

.spot-row:nth-child(1) .spot-rank { background: #F2B138; }
.spot-row:nth-child(2) .spot-rank { background: #C9D6DE; }
.spot-row:nth-child(3) .spot-rank { background: #E2A97B; }

.spot-row-main {
  flex: 1;
  min-width: 0;
}

.spot-row-name {
  display: block;
  font-size: 28rpx;
  font-weight: 850;
  color: #1C1C1C;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.spot-row-tags {
  display: flex;
  margin-top: 10rpx;
}

.spot-tag {
  margin-right: 12rpx;
  padding: 4rpx 14rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.spot-tag.dist {
  background: #DDF3F6;
  color: #0E7C92;
}

.spot-tag.heat {
  background: #FDECC8;
  color: #8A5B00;
}

.spot-row-go {
  margin-left: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #B7A98E;
}

/* 地图自选入口：青底与推荐行区分 */
.spot-custom {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 22rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #CDEFF4;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.spot-custom-icon {
  margin-right: 16rpx;
  font-size: 40rpx;
}

.spot-custom-main {
  flex: 1;
  min-width: 0;
}

.spot-custom-title {
  display: block;
  font-size: 28rpx;
  font-weight: 850;
  color: #1C1C1C;
}

.spot-custom-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #4F6787;
}
