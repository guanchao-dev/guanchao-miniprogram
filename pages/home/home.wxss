.home-page {
  padding-top: 20rpx;
  overflow: auto;
}

.top-row {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.place-chip,
.search-chip {
  display: flex;
  align-items: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.place-chip {
  padding: 8rpx 16rpx;
  gap: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.search-chip {
  flex: 1;
  justify-content: space-between;
  padding: 8rpx 16rpx;
  color: #6B7C8A;
  font-size: 20rpx;
}

.place-icon,
.search-icon {
  width: 34rpx;
  height: 34rpx;
}

.hero {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  min-height: 240rpx;
  padding: 22rpx 20rpx 22rpx 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F7FCFF, #D8F3F6);
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 52%;
  flex-shrink: 0;
}

.hero-kicker {
  color: #1888BF;
  font-size: 20rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.2;
}

.hero-kicker + .hero-title {
  margin-top: 8rpx;
}

.watch-btn {
  margin-top: 18rpx;
  min-width: 180rpx;
}

.watch-btn.is-on {
  background: #34B8C5;
  color: #FFFFFF;
}

.watch-btn.is-end {
  background: #F6D081;
  color: #1C1C1C;
}

.hero-visual {
  position: relative;
  z-index: 2;
  flex: 1;
  height: 196rpx;
  margin-left: 8rpx;
}

.hero-blob {
  position: absolute;
  right: 4rpx;
  top: 20rpx;
  width: 148rpx;
  height: 148rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 40% 50% 45% 55%;
  background: #34B8C5;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  transform: rotate(8deg);
}

.hero-dot-a {
  position: absolute;
  top: 6rpx;
  right: 20rpx;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #F6D081;
}

.hero-dot-b {
  position: absolute;
  left: 12rpx;
  bottom: 30rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #184D97;
  border: 3rpx solid #1C1C1C;
}

.hero-squiggle {
  position: absolute;
  left: 20rpx;
  top: 48rpx;
  width: 46rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #A7D9C7;
  border: 3rpx solid #1C1C1C;
  transform: rotate(-18deg);
}

.hero-mascot {
  position: absolute;
  right: -4rpx;
  bottom: -8rpx;
  width: 184rpx;
  height: 184rpx;
  z-index: 2;
}

.ai-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.ai-card {
  position: relative;
  z-index: 2;
  flex: 1;
  height: 212rpx;
  padding: 20rpx 12rpx 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 4rpx solid #1C1C1C;
  border-radius: 28rpx;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.ai-card.photo {
  background: linear-gradient(165deg, #E7FBFC 0%, #5EC9D4 100%);
}

.ai-card.advice {
  background: linear-gradient(165deg, #FFF8E8 0%, #F6D081 100%);
}

.ai-orb {
  position: absolute;
  top: 14rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
}

.ai-icon {
  position: relative;
  z-index: 1;
  width: 112rpx;
  height: 112rpx;
}

.ai-name {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 850;
}

.spot-section {
  position: relative;
  z-index: 2;
  margin-top: 8rpx;
}

.hot-box {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  padding: 4rpx 8rpx 6rpx;
}

.hot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx 4rpx;
}

.hot-head .section-title {
  font-size: 30rpx;
}

.hot-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 16rpx;
}

.hot-row + .hot-row {
  border-top: 2rpx solid rgba(28, 28, 28, 0.08);
}

.hot-rank {
  width: 40rpx;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
  flex-shrink: 0;
}

.hot-rank.rank-1 { color: #E23D3D; }
.hot-rank.rank-2 { color: #E8892E; }
.hot-rank.rank-3 { color: #1888BF; }

.hot-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
}

.hot-heat,
.hot-dist {
  color: #6B7C8A;
  font-size: 20rpx;
  font-weight: 650;
  flex-shrink: 0;
}

.hot-heat {
  color: #184D97;
}

.advice-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
}

.advice-key {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.advice-key-item {
  padding: 8rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F3FBFA;
  color: #1888BF;
  font-size: 24rpx;
  font-weight: 800;
}

.advice-key-item.key-go {
  background: #34B8C5;
  color: #FFFFFF;
}

.advice-key-item.key-no {
  background: #F6D081;
  color: #1C1C1C;
}

.advice-body {
  display: block;
  margin-top: 20rpx;
  color: #1C1C1C;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.65;
}

.advice-safety {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(52, 184, 197, 0.1);
}

.advice-safety-label {
  display: block;
  color: #1888BF;
  font-size: 22rpx;
  font-weight: 800;
}

.advice-safety-text {
  display: block;
  margin-top: 6rpx;
  color: #4F6787;
  font-size: 24rpx;
  line-height: 1.6;
}

.advice-extra,
.candidate-reason,
.ai-hint,
.obs {
  display: block;
  margin-top: 8rpx;
  color: #4F6787;
  font-size: 24rpx;
  line-height: 1.55;
}

.advice-disc {
  display: block;
  margin-top: 20rpx;
  color: #8A7A6B;
  font-size: 20rpx;
  line-height: 1.5;
}

.ai-hint {
  color: #8A7A6B;
  font-size: 20rpx;
}

/* ===== 相关活动自动轮播 ===== */
.activity-swiper {
  position: relative;
  z-index: 2;
  height: 196rpx;
  margin-top: 24rpx;
}

.activity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 176rpx;
  padding: 20rpx 28rpx 24rpx;
  box-sizing: border-box;
  border: 4rpx solid #1C1C1C;
  border-radius: 28rpx;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  overflow: hidden;
}

.activity-card.teal {
  background: linear-gradient(135deg, #E7FBFC 0%, #BDEFF3 100%);
}

.activity-card.yellow {
  background: linear-gradient(135deg, #FFF8E8 0%, #F6E0AC 100%);
}

.activity-card.banner {
  position: relative;
  padding: 0;
  background: #0A2A4A;
}

.activity-card.banner .activity-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.activity-card.banner .activity-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(8,28,52,0.82) 0%, rgba(8,28,52,0.55) 45%, rgba(8,28,52,0.15) 100%);
}

.activity-card.banner .activity-main {
  position: relative;
  z-index: 2;
  justify-content: center;
  height: 100%;
  padding: 20rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.activity-card.banner .activity-tag {
  background: rgba(255,255,255,0.92);
  color: #0A2A4A;
}

.activity-card.banner .activity-name {
  color: #FFFFFF;
}

.activity-card.banner .activity-desc {
  color: rgba(255,255,255,0.88);
}

.activity-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.activity-tag {
  padding: 4rpx 18rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
}

.activity-name {
  margin-top: 10rpx;
  color: #1C1C1C;
  font-size: 36rpx;
  font-weight: 900;
}

.activity-desc {
  margin-top: 6rpx;
  color: #4F6787;
  font-size: 22rpx;
}

.activity-illu {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ai-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  background: rgba(11, 31, 56, 0.56);
}

.ai-modal {
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
  border: 4rpx solid #1C1C1C;
  border-radius: 32rpx;
  background: #EAF3FF;
}

.ai-modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 8rpx;
  font-size: 32rpx;
  font-weight: 850;
}

.ai-close {
  font-size: 44rpx;
  font-weight: 300;
}

.ai-modal-body {
  max-height: 68vh;
  padding: 8rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.guess-photo {
  width: 100%;
  height: 220rpx;
  margin-bottom: 8rpx;
  border-radius: 16rpx;
  background: #fff;
}

.candidate {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
}

.candidate-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.candidate-name {
  font-size: 28rpx;
  font-weight: 800;
}

.candidate-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #D6EAF8;
  color: #1878FF;
  font-size: 20rpx;
}

.candidate-prob {
  font-size: 26rpx;
  font-weight: 850;
  color: #1878FF;
}

.candidate-bar {
  margin-top: 8rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #E3EEF7;
  overflow: hidden;
}

.candidate-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #34B8C5, #1878FF);
}

.candidate-latin {
  display: block;
  margin-top: 4rpx;
  color: #8A97A3;
  font-size: 20rpx;
  font-style: italic;
}

.candidate-wiki {
  display: inline-block;
  margin-top: 8rpx;
  color: #1878FF;
  font-size: 20rpx;
}

.more-guess {
  margin-top: 16rpx;
  padding: 18rpx 0;
  text-align: center;
  color: #1878FF;
  font-size: 24rpx;
  font-weight: 750;
  border-top: 2rpx dashed #DCE6EE;
}

.confirm-species {
  margin-top: 14rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  border: 3rpx solid #1878FF;
  border-radius: 999rpx;
  color: #1878FF;
  font-size: 24rpx;
  font-weight: 750;
  box-sizing: border-box;
}

.confirm-species.done {
  background: #20B85A;
  border-color: #20B85A;
  color: #FFFFFF;
}

.confirm-species.muted {
  border-color: #C9D2DA;
  color: #A8B3BD;
}

.not-sea {
  margin-top: 20rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(246, 208, 129, 0.28);
  text-align: center;
}

.not-sea-title {
  display: block;
  font-size: 32rpx;
  font-weight: 850;
  color: #8A5B00;
}

.not-sea-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7A6A4A;
}

/* ===== 多物品：照片里的每个发现各占一组 ===== */
.guess-item {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed #DCE6EE;
}

.guess-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.guess-item-label {
  color: #1C1C1C;
  font-size: 26rpx;
  font-weight: 850;
}

.guess-item-count {
  color: #7A6A4A;
  font-size: 22rpx;
  font-weight: 800;
}

.trash-item {
  margin-top: 18rpx;
}

/* ===== 垃圾识别：国标四分类配色 ===== */
.trash-cat {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

/* 与垃圾桶颜色对应：可回收蓝、有害红、厨余绿、其他灰 */
.cat-recyclable {
  background: #D6EAF8;
  color: #1163C7;
}

.cat-hazardous {
  background: #FBE0E0;
  color: #C22B2B;
}

.cat-kitchen {
  background: #DCF3E5;
  color: #1F7F49;
}

.cat-other {
  background: #E6EBF0;
  color: #55636F;
}

.trash-block {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
}

.trash-block.hazard {
  background: rgba(251, 224, 224, 0.5);
}

.trash-block-label {
  display: block;
  font-size: 24rpx;
  font-weight: 850;
  color: #1C1C1C;
}

.trash-block-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #4F6787;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
}
