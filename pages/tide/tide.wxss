.tide-page {
  padding-top: 20rpx;
}

.tide-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.status-item {
  padding: 8rpx 16rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  color: #3D4A54;
  font-size: 20rpx;
  font-weight: 700;
}

.status-item.status-trend {
  background: #E7FBFC;
  color: #1888BF;
}

.status-item.status-height {
  background: #FFF6E0;
  color: #8A5B00;
}

.spot-pick {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  color: #1C1C1C;
  font-size: 22rpx;
  font-weight: 800;
}

.chart-card {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  padding: 16rpx;
}

.tide-canvas {
  display: block;
  width: 100%;
  height: 360rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 18rpx;
  background: #F3FBFA;
}

.legend {
  display: flex;
  gap: 24rpx;
  padding: 12rpx 8rpx 2rpx;
  color: #6B7C8A;
  font-size: 20rpx;
  font-weight: 650;
}

.leg.teal::before,
.leg.gold::before {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #1888BF;
  vertical-align: middle;
}

.leg.gold::before {
  background: #F4A51C;
}

.weather {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 24rpx;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  background: linear-gradient(135deg, #F7FCFF, #E4F6F8);
  color: #3D4A54;
  font-size: 22rpx;
  font-weight: 650;
}

.date-strip {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  white-space: nowrap;
}

.date-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 112rpx;
  margin-right: 12rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  color: #6B7C8A;
  vertical-align: top;
}

.date-chip.on {
  background: #34B8C5;
  color: #FFFFFF;
}

.date-day {
  font-size: 32rpx;
  font-weight: 850;
}

.date-week {
  margin-top: 4rpx;
  font-size: 20rpx;
}

.nav-row {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.nav-btn,
.nav-mid {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  font-size: 24rpx;
  font-weight: 800;
}

.nav-btn {
  background: #FFFFFF;
  color: #1C1C1C;
}

.nav-mid {
  background: #F6D081;
  color: #1C1C1C;
  font-weight: 850;
}

.block {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  padding: 22rpx 22rpx 12rpx;
}

.block-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  color: #1C1C1C;
  font-size: 30rpx;
  font-weight: 850;
}

.block-title::before {
  content: '';
  width: 14rpx;
  height: 28rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 6rpx;
  background: #34B8C5;
}

.phase {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid rgba(28, 28, 28, 0.08);
  font-size: 24rpx;
}

.phase-time {
  width: 200rpx;
  color: #1C1C1C;
  font-weight: 700;
}

.phase-tag {
  width: 96rpx;
  padding: 4rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
}

.phase-tag.up {
  background: rgba(230, 67, 64, 0.1);
  color: #E64340;
}

.phase-tag.down {
  background: rgba(24, 136, 191, 0.1);
  color: #1888BF;
}

.phase-delta {
  flex: 1;
  text-align: right;
  color: #6B7C8A;
}

.table-head,
.table-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 24rpx;
}

.table-head {
  color: #1888BF;
  font-weight: 800;
}

.table-row {
  border-top: 2rpx solid rgba(28, 28, 28, 0.08);
  color: #1C1C1C;
}

.table-head text,
.table-row text {
  width: 33%;
}

.table-head text:nth-child(2),
.table-row text:nth-child(2),
.table-head text:nth-child(3),
.table-row text:nth-child(3) {
  text-align: right;
}

.empty {
  padding: 12rpx 0 16rpx;
  color: #6B7C8A;
  font-size: 22rpx;
}
