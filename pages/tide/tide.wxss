.tide-page {
  padding-top: 20rpx;
}

.tide-page .page-content {
  /* 给右下角的 AI 浮标和赶海悬浮球留出空间，避免盖住最后一屏内容 */
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.swipe-hint {
  margin: 6rpx 6rpx 0;
  color: #8A99A6;
  text-align: center;
  font-size: 19rpx;
  font-weight: 650;
  letter-spacing: 0.5rpx;
}

/* 开始 / 结束赶海 */
.tide-watch-btn {
  width: 100%;
  margin: 16rpx 0 18rpx;
  height: 88rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  border: 4rpx solid #1C1C1C;
  border-radius: 44rpx;
  background: #F6D081;
  box-shadow: 5rpx 5rpx 0 rgba(28, 28, 28, 0.85);
  color: #1C1C1C;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  text-align: center;
}

.tide-watch-btn.is-on {
  background: #34B8C5;
  color: #FFFFFF;
}

.tide-watch-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.tide-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.status-item {
  padding: 7rpx 14rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
  color: #3D4A54;
  font-size: 19rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.status-item.status-trend {
  background: #E7FBFC;
  color: #1888BF;
}

.status-item.status-height {
  background: #FFF6E0;
  color: #8A5B00;
}

/* picker 是 flex 子项，别让它被右侧状态胶囊挤压 */
.tide-top picker {
  flex-shrink: 0;
}

.spot-pick {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  max-width: 400rpx;
  padding: 8rpx 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  color: #1C1C1C;
  font-size: 21rpx;
  font-weight: 800;
  /* 点位名保持一行，不被挤成两行 */
  white-space: nowrap;
}

.chart-card {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  padding: 14rpx;
}

.chart-stage {
  position: relative;
  height: 360rpx;
}

.tide-canvas {
  display: block;
  width: 100%;
  height: 360rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #F3FBFA;
}

.chart-stage .tide-canvas {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
}

/* 导出的曲线图盖在画布位置 */
.chart-shot {
  z-index: 2;
}

.legend {
  display: flex;
  gap: 22rpx;
  padding: 14rpx 8rpx 4rpx;
  color: #6B7C8A;
  font-size: 19rpx;
  font-weight: 650;
}

.leg.teal::before,
.leg.best::before,
.leg.gold::before {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #1888BF;
  vertical-align: middle;
}

.leg.best::before {
  background: rgba(255, 197, 61, 0.28);
  box-shadow: inset 0 0 0 2rpx #FFC53D;
}

.leg.gold::before {
  background: #F4A51C;
}

/* 天气条：四格等宽，与数据条同一套节奏 */
.weather {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 18rpx 8rpx;
  background: #FFFFFF;
}

.weather-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.weather-v {
  color: #1C1C1C;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.weather-k {
  margin-top: 4rpx;
  color: #6B7C8A;
  font-size: 18rpx;
  font-weight: 700;
}

.weather-divider {
  flex: none;
  width: 2rpx;
  height: 44rpx;
  background: rgba(28, 28, 28, 0.1);
}

.date-strip {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  white-space: nowrap;
}

.date-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 104rpx;
  margin-right: 10rpx;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  color: #6B7C8A;
  vertical-align: top;
}

.date-chip.on {
  background: #34B8C5;
  color: #FFFFFF;
}

.date-chip:active {
  transform: translate(1rpx, 1rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}

.date-day {
  font-size: 30rpx;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
}

.date-week {
  margin-top: 2rpx;
  font-size: 19rpx;
  font-weight: 650;
}

.nav-date {
  position: relative;
  z-index: 2;
  margin-top: 14rpx;
  text-align: center;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.block {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  padding: 20rpx 20rpx 10rpx;
}

.block-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
  color: #1C1C1C;
  font-size: 30rpx;
  font-weight: 850;
  letter-spacing: 0.5rpx;
}

.block-title::before {
  content: '';
  width: 12rpx;
  height: 26rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 5rpx;
  background: #34B8C5;
}

.phase {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 2rpx solid rgba(28, 28, 28, 0.08);
  font-size: 23rpx;
}

.phase-time {
  width: 200rpx;
  color: #1C1C1C;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.phase-tag {
  width: 92rpx;
  padding: 3rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 800;
}

.phase-tag.up {
  background: rgba(230, 67, 64, 0.1);
  color: #E64340;
}

.phase-tag.down {
  background: rgba(24, 136, 191, 0.1);
  color: #1888BF;
}

.phase-delta {
  flex: 1;
  text-align: right;
  color: #6B7C8A;
}

.table-head,
.table-row {
  display: flex;
  justify-content: space-between;
  padding: 13rpx 0;
  font-size: 23rpx;
}

.table-head {
  color: #1888BF;
  font-weight: 800;
}

.table-row {
  border-top: 2rpx solid rgba(28, 28, 28, 0.08);
  color: #1C1C1C;
}

.table-head text,
.table-row text {
  width: 33%;
}

.table-row text:nth-child(2),
.table-row text:nth-child(3) {
  font-variant-numeric: tabular-nums;
}

.table-head text:nth-child(2),
.table-row text:nth-child(2),
.table-head text:nth-child(3),
.table-row text:nth-child(3) {
  text-align: right;
}

.empty {
  padding: 12rpx 0 16rpx;
  color: #6B7C8A;
  font-size: 22rpx;
}

/* 潮汐类型 / 最佳窗口 / 教学入口：天气上方收成一行 */
.tide-subline {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 2rpx 0;
}

.subline-tags {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* 次级信息：比状态胶囊小一号、无阴影，不抢按钮 */
.meta-chip {
  padding: 5rpx 14rpx;
  border: 2rpx solid rgba(28, 28, 28, 0.18);
  border-radius: 999rpx;
  background: #F4F7F8;
  color: #5B6B78;
  font-size: 19rpx;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}

.meta-chip.type {
  background: #E7FBFC;
  color: #1888BF;
}

.meta-chip.season.live {
  background: #FFF6E0;
  color: #8A5B00;
}

.meta-chip.best {
  background: #FFF6E0;
  color: #8A5B00;
}

.tutorial-entry {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  color: #1888BF;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* ===== 出门建议（原首页弹窗迁移到此，改为页内卡片） ===== */
.advice-empty,
.advice-loading {
  padding: 10rpx 0 14rpx;
  color: #6B7C8A;
  font-size: 23rpx;
  line-height: 1.6;
}

.adv-verdict {
  margin-top: 4rpx;
  padding: 4rpx 0 12rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 0.5rpx;
}

.adv-verdict.go {
  color: #1888BF;
}

.adv-verdict.no {
  color: #5A6878;
}

.adv-copy {
  margin-top: 4rpx;
  padding: 16rpx 18rpx;
  border: 3rpx solid rgba(28, 28, 28, 0.16);
  border-radius: 16rpx;
  background: #FFFFFF;
}

.adv-copy-headline {
  display: block;
  color: #102A3D;
  font-size: 27rpx;
  font-weight: 900;
}

.adv-copy-body {
  display: block;
  margin-top: 6rpx;
  color: #46566A;
  font-size: 23rpx;
  line-height: 1.6;
}

.adv-stats {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.adv-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 10rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.adv-stat.alert {
  background: #FFF2F2;
}

.adv-stat-num {
  color: #1C1C1C;
  font-size: 27rpx;
  font-weight: 900;
  text-align: center;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.adv-stat.alert .adv-stat-num {
  color: #D63031;
}

.adv-stat-label {
  margin-top: 6rpx;
  color: #6B7B8B;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.adv-stat.alert .adv-stat-label {
  color: #D63031;
}

.adv-spot {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 15rpx 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.adv-spot:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

.adv-spot-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.adv-spot-name {
  color: #1C1C1C;
  font-size: 26rpx;
  font-weight: 900;
}

.adv-spot-reason {
  margin-top: 2rpx;
  color: #6B7B8B;
  font-size: 21rpx;
}

.adv-spot-dist {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #34B8C5;
  font-size: 22rpx;
  font-weight: 800;
}




/* 悬浮球固定层：把组件整体抬到所有卡片之上 */
.watch-ball-layer {
  position: fixed;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  z-index: 9999;
}
