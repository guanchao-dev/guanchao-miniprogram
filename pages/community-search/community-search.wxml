<view class="community-page">
  <view class="card search-box">
    <input
      focus
      value="{{keyword}}"
      placeholder="搜索笔记 / 同学 / 话题"
      confirm-type="search"
      bindinput="onInput"
      bindconfirm="onSearch"
    />
    <view class="btn" bindtap="onSearch">搜索</view>
  </view>

  <block wx:if="{{!searched}}">
    <view class="section-head"><text class="section-title">热门搜索</text></view>
    <view class="chip-row">
      <view class="chip" wx:for="{{hot}}" wx:key="keyword" data-word="{{item.keyword}}" bindtap="onHot">{{item.keyword}}</view>
    </view>
    <view class="section-head" wx:if="{{history.length}}">
      <text class="section-title">最近搜过</text>
      <text class="section-more" bindtap="clearHistory">清空</text>
    </view>
    <view class="chip-row">
      <view class="chip" wx:for="{{history}}" wx:key="*this" data-word="{{item}}" bindtap="onHot">{{item}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="chip-row">
      <view class="chip {{type === item.id ? 'active' : ''}}" wx:for="{{types}}" wx:key="id" data-id="{{item.id}}" bindtap="onType">{{item.name}}</view>
    </view>
    <view class="empty-tip" wx:if="{{!notes.length && !users.length && !topics.length}}">没有找到相关内容</view>

    <view class="section-head" wx:if="{{notes.length}}"><text class="section-title">笔记</text></view>
    <view class="waterfall" wx:if="{{notes.length}}">
      <view class="wf-col">
        <view class="note-card card" wx:for="{{left}}" wx:key="id" data-id="{{item.id}}" bindtap="openNote">
          <image class="note-cover" src="{{item.coverUrl}}" mode="aspectFill" style="height: {{item.coverHeight}}rpx;"></image>
          <view class="note-title">{{item.title}}</view>
        </view>
      </view>
      <view class="wf-col">
        <view class="note-card card" wx:for="{{right}}" wx:key="id" data-id="{{item.id}}" bindtap="openNote">
          <image class="note-cover" src="{{item.coverUrl}}" mode="aspectFill" style="height: {{item.coverHeight}}rpx;"></image>
          <view class="note-title">{{item.title}}</view>
        </view>
      </view>
    </view>

    <view class="section-head" wx:if="{{users.length}}"><text class="section-title">同学</text></view>
    <view class="card list-card" wx:for="{{users}}" wx:key="id" data-id="{{item.id}}" bindtap="openUser">
      <view class="list-title">{{item.nickname}}</view>
      <view class="list-meta">{{item.title}} ｜ {{item.noteCount}} 篇笔记</view>
    </view>

    <view class="section-head" wx:if="{{topics.length}}"><text class="section-title">话题</text></view>
    <view class="card list-card" wx:for="{{topics}}" wx:key="id" data-id="{{item.id}}" bindtap="openTopic">
      <view class="list-title"># {{item.name}}</view>
      <view class="list-meta">{{item.noteCount}} 篇相关笔记</view>
    </view>
  </block>
</view>
