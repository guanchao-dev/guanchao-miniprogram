.collection-page {
  padding-top: 12rpx;
}

.col-header {
  padding: 24rpx;
}

.col-title {
  color: #1C1C1C;
  font-size: 34rpx;
  font-weight: 900;
}

.col-sub {
  margin-top: 8rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.col-track {
  height: 20rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F0F2F5;
}

.col-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #34B8C5;
}

.col-empty {
  margin-top: 24rpx;
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.col-empty-text {
  color: #6B7C8A;
  font-size: 24rpx;
  font-weight: 650;
}

.col-login {
  margin-top: 24rpx;
  padding: 0 44rpx;
  height: 80rpx;
  border-width: 4rpx;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  background: #1888BF;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 850;
}

.col-login:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
}

/* 城市 / 区两级筛选：同一套 chip 造型，选中统一青底白字 */
.filter-tabs {
  white-space: nowrap;
  margin: 10rpx 6rpx 20rpx;
  padding: 2rpx 4rpx 6rpx;
  box-sizing: border-box;
}

.filter-chip {
  display: inline-block;
  margin-right: 16rpx;
  padding: 12rpx 26rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
  color: #1C1C1C;
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.3;
}

.filter-chip:last-child {
  margin-right: 4rpx;
}

.filter-chip.on {
  background: #34B8C5;
  color: #FFFFFF;
  font-weight: 850;
}

.empty-tip {
  margin: 40rpx 6rpx;
  color: #6B7C8A;
  font-size: 24rpx;
  text-align: center;
}

/* 点亮墙：一排 2 个纯文本点位牌 */
.spot-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 10rpx 16rpx;
}

.spot-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 10rpx;
}

/* 没去过：灰底灰字 */
.spot-cell-name {
  display: block;
  padding: 24rpx 14rpx;
  border: 3rpx solid rgba(28, 28, 28, 0.16);
  border-radius: 16rpx;
  background: #F3F5F7;
  color: #9AA8B2;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 去过：和成就页「已点亮」同一套金色语言 */
.spot-cell.lit .spot-cell-name {
  border-color: #E0A83A;
  background: #FFF6E0;
  box-shadow: 3rpx 3rpx 0 rgba(224, 168, 58, 0.5);
  color: #8A5A10;
  font-weight: 800;
}
