.collection-page {
  padding-top: 12rpx;
}

.col-header {
  padding: 24rpx;
}

.col-title {
  font-size: 34rpx;
  font-weight: 850;
}

.col-sub {
  margin-top: 8rpx;
  color: #6B7C8A;
  font-size: 22rpx;
}

.col-track {
  height: 22rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFF4E8;
}

.col-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #184D97, #34B8C5);
}

.col-empty {
  margin-top: 24rpx;
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.col-empty-text {
  color: #6B7C8A;
  font-size: 24rpx;
}

.col-login {
  margin-top: 24rpx;
  padding: 0 48rpx;
  height: 76rpx;
  background: #1888BF;
  color: #fff;
}

/* 点亮墙：一排 2 个纯文本点位牌 */
.spot-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding: 20rpx 12rpx 12rpx;
}

.spot-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

/* 没去过：灰底灰字 */
.spot-cell-name {
  display: block;
  padding: 18rpx 12rpx;
  border: 3rpx solid #DCE2E7;
  border-radius: 14rpx;
  background: #F3F5F7;
  color: #9AA3AF;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 去过：和成就页「已点亮」同一套金色语言 */
.spot-cell.lit .spot-cell-name {
  border-color: #E0A83A;
  background: linear-gradient(180deg, #FFF7E6 0%, #FFFDF7 58%, #FFFFFF 100%);
  box-shadow: 3rpx 3rpx 0 rgba(224, 168, 58, 0.5);
  color: #8A5A10;
  font-weight: 800;
}