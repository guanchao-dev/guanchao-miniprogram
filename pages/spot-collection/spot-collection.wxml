<view class="page memphis-bg collection-page">
  <view class="memphis-layer">
    <view class="geo-circle lg" style="top: 40rpx; right: -40rpx; background:#A7D9C7;"></view>
  </view>

  <view class="page-content">
    <view class="col-header card">
      <view class="col-title">赶海足迹</view>
      <view class="col-sub">已点亮 {{visitedCount}} / {{total}} 个赶海点</view>
      <view class="col-track">
        <view class="col-fill" style="width: {{percent}}%;"></view>
      </view>
    </view>

    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>

    <view class="col-empty card" wx:elif="{{!loggedIn}}">
      <text class="col-empty-text">登录后查看你去过的赶海点</text>
      <view class="btn col-login" bindtap="goLogin" hover-class="tap">去登录</view>
    </view>

    <view class="empty-tip" wx:elif="{{!list.length}}">暂无赶海点数据</view>

    <!-- 城市 → 区两级筛选，和搜索结果同一套分类交互 -->
    <block wx:else>
      <scroll-view class="filter-tabs" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          class="filter-chip {{city === item ? 'on' : ''}}"
          wx:for="{{cities}}"
          wx:key="*this"
          data-city="{{item}}"
          bindtap="onCity"
          hover-class="tap"
        >{{item}}</view>
      </scroll-view>

      <scroll-view class="filter-tabs" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{districts.length > 1}}">
        <view
          class="filter-chip sub {{district === item.id ? 'on' : ''}}"
          wx:for="{{districts}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onDistrict"
          hover-class="tap"
        >{{item.name}}</view>
      </scroll-view>

      <!-- 点亮墙：去过的像成就页一样金边点亮，没去过的置灰 -->
      <view class="spot-grid card" wx:if="{{visibleSpots.length}}">
        <view class="spot-cell {{item.visited ? 'lit' : ''}}" wx:for="{{visibleSpots}}" wx:key="id" data-id="{{item.id}}" bindtap="openSpot" hover-class="tap">
          <text class="spot-cell-name">{{item.name}}</text>
        </view>
      </view>
      <view class="empty-tip" wx:else>该城市暂无赶海点</view>
    </block>
  </view>

  <watch-ball />
</view>