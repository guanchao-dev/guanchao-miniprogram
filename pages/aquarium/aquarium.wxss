.aquarium-page {
  background: #FBF6EA;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.aquarium-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.head-copy { min-width: 0; }

.title {
  font-size: 44rpx;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.head-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.head-links {
  display: flex;
  gap: 16rpx;
}

/* 三个层级：住客数=状态文字，审核记录=次级文字链接，清空=危险操作 */
.count {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
}

.audit-link,
.clear {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding: 0 10rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.audit-link { color: var(--blue); }
.clear { color: #C0392B; }

.aquarium-tap { opacity: .78; }

/* ===== 鱼缸 ===== */
.tank {
  position: relative;
  height: 720rpx;
  overflow: hidden;
  border: 2rpx solid var(--ink);
  border-radius: 20rpx;
  background: linear-gradient(180deg, #B7DDE2 0%, #7FB4BC 30%, #4C8A94 62%, #2A5F69 100%);
  box-shadow: 0 14rpx 34rpx rgba(28, 28, 28, .12);
}

.waterline {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 56rpx;
  background: radial-gradient(120% 100% at 50% 0%, rgba(255, 255, 255, .55), transparent 70%);
  z-index: 2;
  pointer-events: none;
}

.rays {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  overflow: hidden;
  pointer-events: none;
}

.ray {
  position: absolute;
  top: -30%;
  height: 130%;
  background: linear-gradient(180deg, rgba(255, 255, 255, .34), transparent 75%);
  filter: blur(10rpx);
  transform: rotate(14deg);
  animation: rayPulse 9s ease-in-out infinite alternate;
}

.ray1 { left: 8%; width: 18%; animation-delay: -1.5s; }
.ray2 { left: 42%; width: 12%; animation-delay: -4.2s; opacity: .7; }
.ray3 { left: 72%; width: 16%; animation-delay: -2.4s; opacity: .55; }

@keyframes rayPulse {
  from { opacity: .35; transform: rotate(12deg) translateX(-8rpx); }
  to { opacity: .8; transform: rotate(18deg) translateX(18rpx); }
}

/* ===== 气泡 ===== */
.bubble-field {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  overflow: hidden;
  pointer-events: none;
}

.bubble {
  position: absolute;
  bottom: -40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, .55);
  background: rgba(255, 255, 255, .16);
  animation: bubbleRise linear infinite;
}

.b1  { width: 18rpx; height: 18rpx; left: 6%;  animation-duration: 12s; animation-delay: -2s; }
.b2  { width: 10rpx; height: 10rpx; left: 18%; animation-duration: 9s;  animation-delay: -6s; }
.b3  { width: 26rpx; height: 26rpx; left: 32%; animation-duration: 15s; animation-delay: -4s; }
.b4  { width: 14rpx; height: 14rpx; left: 45%; animation-duration: 11s; animation-delay: -9s; }
.b5  { width: 8rpx;  height: 8rpx;  left: 58%; animation-duration: 8s;  animation-delay: -3s; }
.b6  { width: 20rpx; height: 20rpx; left: 68%; animation-duration: 13s; animation-delay: -7s; }
.b7  { width: 12rpx; height: 12rpx; left: 78%; animation-duration: 10s; animation-delay: -1s; }
.b8  { width: 28rpx; height: 28rpx; left: 88%; animation-duration: 16s; animation-delay: -5s; }
.b9  { width: 10rpx; height: 10rpx; left: 24%; animation-duration: 9.5s; animation-delay: -8s; }
.b10 { width: 16rpx; height: 16rpx; left: 52%; animation-duration: 14s; animation-delay: -11s; }

@keyframes bubbleRise {
  0% { transform: translate3d(0, 0, 0) scale(.8); opacity: 0; }
  12% { opacity: .9; }
  55% { transform: translate3d(-14rpx, -420rpx, 0) scale(1); }
  100% { transform: translate3d(24rpx, -900rpx, 0) scale(1.1); opacity: 0; }
}

/* ===== 海草 ===== */
.kelp {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

.back-kelp { z-index: 3; opacity: .82; }
.front-kelp { z-index: 7; }

.blade {
  position: absolute;
  bottom: 0;
  border-radius: 999rpx 999rpx 40% 40%;
  background: linear-gradient(180deg, #5FC28E, #1E7D5C);
  transform-origin: bottom center;
  animation: sway 4s ease-in-out infinite alternate;
}

.kb1 { left: 7%;  width: 26rpx; height: 36%; animation-duration: 3.4s; animation-delay: -1.2s; }
.kb2 { left: 15%; width: 18rpx; height: 50%; animation-duration: 4.2s; animation-delay: -2s; }
.kb3 { left: 82%; width: 22rpx; height: 44%; animation-duration: 3.8s; animation-delay: -.6s; }
.kb4 { left: 91%; width: 16rpx; height: 32%; animation-duration: 4.8s; animation-delay: -2.6s; }
.kf1 { left: 3%;  width: 32rpx; height: 28%; animation-duration: 3.1s; animation-delay: -.4s; background: linear-gradient(180deg, rgba(111, 214, 152, .92), rgba(22, 108, 80, .95)); }
.kf2 { left: 95%; width: 28rpx; height: 26%; animation-duration: 3.7s; animation-delay: -1.8s; background: linear-gradient(180deg, rgba(111, 214, 152, .92), rgba(22, 108, 80, .95)); }

@keyframes sway {
  from { transform: rotate(-4deg) scaleX(.94); }
  to { transform: rotate(5deg) scaleX(1.06); }
}

/* ===== 沙地 / 礁石 ===== */
.sand {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 19%;
  z-index: 4;
  border-radius: 50% 50% 0 0 / 16% 16% 0 0;
  background: linear-gradient(180deg, #F6E3B0 0%, #E4C98E 55%, #C9A968 100%);
  pointer-events: none;
}

.rocks {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 8%;
  height: 52rpx;
  z-index: 5;
  pointer-events: none;
}

.rock {
  position: absolute;
  bottom: 0;
  border-radius: 60% 40% 30% 70% / 60% 50% 50% 40%;
  box-shadow: inset -8rpx -8rpx 0 rgba(0, 0, 0, .12);
}

.rock1 { left: 6%;  width: 16%; height: 38rpx; background: #2C6E7C; }
.rock2 { left: 23%; width: 9%;  height: 24rpx; background: #1F5D6B; }
.rock3 { left: 69%; width: 13%; height: 30rpx; background: #276878; }
.rock4 { left: 86%; width: 8%;  height: 20rpx; background: #174F5E; }

/* ===== 住客 ===== */
.residents {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 6;
}

.resident {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  will-change: transform;
}

.resident-body {
  width: 100%;
  transform-origin: 50% 50%;
}

.resident-img {
  display: block;
  width: 100%;
  height: auto;
  filter: drop-shadow(0 8rpx 8rpx rgba(3, 34, 50, .3));
  pointer-events: none;
}

.nameplate {
  position: absolute;
  left: 50%;
  top: calc(100% + 4rpx);
  transform: translateX(-50%);
  padding: 2rpx 10rpx;
  border: 1rpx solid rgba(28, 28, 28, .28);
  border-radius: 6rpx;
  background: rgba(255, 255, 255, .92);
  color: var(--ink);
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
  pointer-events: none;
}

.say {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 10rpx);
  transform: translateX(-50%);
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(28, 28, 28, .25);
  border-radius: 8rpx;
  background: #fff;
  color: var(--ink);
  font-size: 19rpx;
  font-weight: 600;
  white-space: nowrap;
  animation: sayPop .85s ease-out forwards;
  pointer-events: none;
  z-index: 3;
}

.say::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 100%;
  width: 10rpx;
  height: 10rpx;
  background: #fff;
  border-right: 3rpx solid var(--ink);
  border-bottom: 3rpx solid var(--ink);
  transform: translate(-50%, -5rpx) rotate(45deg);
}

@keyframes sayPop {
  0% { opacity: 0; transform: translate(-50%, 8rpx) scale(.7); }
  15% { opacity: 1; transform: translate(-50%, 0) scale(1.05); }
  80% { opacity: 1; transform: translate(-50%, -2rpx) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -12rpx) scale(.98); }
}

.wake-bubble {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, .55);
  background: rgba(255, 255, 255, .18);
  pointer-events: none;
}

.wake-left { animation: wakeLeft 1.4s ease-out forwards; }
.wake-right { animation: wakeRight 1.4s ease-out forwards; }

@keyframes wakeLeft {
  0% { transform: translate(0, 0) scale(.65); opacity: .75; }
  100% { transform: translate(-24rpx, -52rpx) scale(1.15); opacity: 0; }
}
@keyframes wakeRight {
  0% { transform: translate(0, 0) scale(.65); opacity: .75; }
  100% { transform: translate(24rpx, -52rpx) scale(1.15); opacity: 0; }
}

/* ===== 水光 / 玻璃 ===== */
.water-tint {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 8;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(120, 225, 245, .10) 0%, rgba(13, 92, 134, .06) 60%, rgba(4, 50, 78, .22) 100%);
}

.shimmer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 8;
  pointer-events: none;
  opacity: .38;
  background: linear-gradient(115deg,
    transparent 0%,
    rgba(255, 255, 255, .18) 16%,
    transparent 34%,
    rgba(255, 255, 255, .10) 52%,
    transparent 70%,
    rgba(255, 255, 255, .16) 86%,
    transparent 100%);
  background-size: 220% 220%;
  animation: shimmerMove 12s linear infinite;
}

@keyframes shimmerMove {
  from { background-position: 0% 0%; }
  to { background-position: 100% 100%; }
}

.glass {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9;
  border-radius: 34rpx;
  pointer-events: none;
  box-shadow: inset 0 0 90rpx rgba(0, 27, 45, .4), inset 16rpx 0 40rpx rgba(255, 255, 255, .16);
}

.glass::after {
  content: '';
  position: absolute;
  left: 6%;
  top: 5%;
  width: 42%;
  height: 16%;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, .35), transparent);
  transform: rotate(-12deg);
  filter: blur(4rpx);
}

/* ===== 空缸 ===== */
.empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.empty-card {
  padding: 30rpx 40rpx;
  border: 1rpx dashed rgba(255, 255, 255, .55);
  border-radius: 10rpx;
  background: rgba(4, 44, 66, .28);
  text-align: center;
  color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(0, 35, 50, .35);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 900;
}

/* ===== 底部 ===== */
.dock {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  margin-top: 30rpx;
}

.add-btn {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 30rpx;
  border-radius: 14rpx;
  background: #2F7F86;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(47, 127, 134, .22);
}

/* ===== 自定义背景 / 横竖版 / 白天夜晚 ===== */
.tank-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* 横版 = 全屏展示：隐藏页面其他部分，让用户把手机横过来 */
.aquarium-page.fullscreen {
  padding: 0;
  overflow: hidden;
}

.aquarium-page.fullscreen .aquarium-head,
.aquarium-page.fullscreen .dock {
  display: none;
}

.aquarium-page.fullscreen .tank {
  position: fixed;
  left: 50%;
  top: 50%;
  width: 100vh;
  height: 100vw;
  transform: translate(-50%, -50%) rotate(90deg);
  transform-origin: center;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  z-index: 100;
}

.aquarium-page.fullscreen .tank::after,
.aquarium-page.fullscreen .tank-menu-btn {
  display: none;
}

.exit-fs {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(28, 28, 28, .16);
  border-radius: 12rpx;
  background: #fff;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(28, 28, 28, .12);
}

.tank.night {
  background: linear-gradient(180deg, #243B57 0%, #14263D 45%, #0A1424 100%);
}

.tank.has-bg .water-tint {
  background: linear-gradient(180deg, rgba(6, 26, 30, .04) 0%, rgba(4, 18, 22, .24) 60%, rgba(3, 14, 18, .42) 100%);
}

.tank.night .water-tint {
  background: linear-gradient(180deg, rgba(6, 16, 28, .22) 0%, rgba(3, 9, 16, .42) 60%, rgba(2, 6, 10, .58) 100%);
}

.tank.night .kelp,
.tank.night .rocks,
.tank.night .sand {
  filter: brightness(.45);
}

.tank.night .resident-img {
  filter: brightness(.9) drop-shadow(0 8rpx 8rpx rgba(0, 10, 18, .35));
}

.tank.night .glass {
  box-shadow: inset 0 0 100rpx rgba(0, 8, 16, .55), inset 14rpx 0 40rpx rgba(160, 210, 230, .08);
}

.tank-menu-btn {
  position: absolute;
  top: 14rpx;
  right: 18rpx;
  z-index: 14;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 64rpx;
  color: rgba(255, 255, 255, .96);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 20, 30, .45);
}

.tank-menu-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 11;
  background: rgba(4, 20, 28, .16);
}

.tank-menu {
  position: absolute;
  top: 92rpx;
  right: 18rpx;
  z-index: 13;
  width: 440rpx;
  max-width: calc(100% - 36rpx);
  overflow: hidden;
  border: 1rpx solid rgba(28, 28, 28, .12);
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(28, 28, 28, .16);
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 96rpx;
  padding: 8rpx 16rpx;
}

.setting-row + .setting-row {
  border-top: 1rpx solid rgba(28, 28, 28, .08);
}

.setting-label {
  flex-shrink: 0;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 800;
}

.segmented {
  display: flex;
  padding: 4rpx;
  border-radius: 12rpx;
  background: #F1F3F2;
}

.seg {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 84rpx;
  min-height: 72rpx;
  padding: 0 14rpx;
  border-radius: 9rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 700;
}

.seg.active {
  background: #fff;
  color: var(--ink);
  font-weight: 900;
  box-shadow: 0 2rpx 6rpx rgba(28, 28, 28, .12);
}

.setting-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.setting-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #2F7F86;
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
}

.setting-reset {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding: 0 2rpx;
  color: #C0392B;
  font-size: 20rpx;
  font-weight: 800;
}

/* ===== 白天/夜晚：圆形扩散主题切换 ===== */
.theme-reveal {
  position: absolute;
  z-index: 15;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%) scale(0);
  animation: themeReveal 420ms ease-out forwards;
  pointer-events: none;
}

@keyframes themeReveal {
  0% {
    transform: translate(-50%, -50%) scale(0);
    opacity: 1;
  }
  65% { opacity: 1; }
  100% {
    transform: translate(-50%, -50%) scale(60);
    opacity: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .theme-reveal {
    animation: none;
    display: none;
  }
}

/* ===== 长按住客：调整大小 ===== */
.size-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(8, 18, 24, .42);
}

.size-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 20rpx 20rpx 0 0;
  background: #fff;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, .12);
}

.size-sheet-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.size-sheet-name {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.size-sheet-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.sheet-slider {
  flex: 1;
  margin: 0;
}

.size-sheet-value {
  flex-shrink: 0;
  min-width: 84rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
}

.size-sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.size-sheet-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.size-sheet-btn.ghost {
  border: 1rpx solid rgba(28, 28, 28, .16);
  background: #fff;
  color: var(--ink);
}

.size-sheet-btn.primary {
  background: #2F7F86;
  color: #fff;
}

.sheet-label {
  flex-shrink: 0;
  width: 72rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 700;
}

/* ===== 管理生物 ===== */
.manage-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 210;
  background: rgba(8, 18, 24, .42);
}

.manage-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 211;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 20rpx 20rpx 0 0;
  background: #fff;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, .12);
}

.manage-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(28, 28, 28, .10);
}

.manage-title {
  color: #1C1C1C;
  font-size: 30rpx;
  font-weight: 800;
}

.manage-count {
  color: #6B7C8A;
  font-size: 20rpx;
}

.manage-list {
  height: 48vh;
}

.manage-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(28, 28, 28, .08);
}

.manage-thumb {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #F4F7F6;
}

.manage-info {
  flex: 1;
  min-width: 0;
}

.manage-name {
  color: #1C1C1C;
  font-size: 26rpx;
