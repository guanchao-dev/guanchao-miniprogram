<view class="page">
  <view class="page-content">
    <view class="card list-card">
      <image wx:if="{{spot.coverUrl}}" class="cover" src="{{spot.coverUrl}}" mode="aspectFill"></image>
      <view class="list-title">{{spot.name}}</view>
      <view class="list-meta">{{spot.city}} ｜ {{spot.openTime}}</view>
      <view class="list-meta">{{spot.ageHint}}</view>
      <view class="chip-row">
        <text class="chip" wx:for="{{spot.safetyTags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="list-meta">{{spot.description || spot.observeHint}}</view>
      <view class="chip-row" wx:if="{{spot.gearList.length}}">
        <text class="chip" wx:for="{{spot.gearList}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="list-meta" wx:if="{{spot.source}}">来源：{{spot.source}}</view>
      <view class="btn full-btn" bindtap="useSpot">设为当前观察点</view>
      <view class="btn full-btn ghost-btn" bindtap="goExplore">开始探索</view>
    </view>
  </view>
</view>

<watch-ball />
