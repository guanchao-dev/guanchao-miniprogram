.detail-card {
  padding: 24rpx 28rpx 40rpx;
}

/* 封面/全景 */
.pano {
  height: 320rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F3FBFA;
}

.pano-img {
  width: 100%;
  height: 320rpx;
}

.pano-fallback {
  height: 240rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 24rpx;
  background: #D8F3F6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6B7C8A;
  font-size: 24rpx;
}

.pano-fallback image {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 10rpx;
}

/* 标题区 */
.spot-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #1C1C1C;
  line-height: 1.3;
}

.spot-meta {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 26rpx;
}

/* 基础信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.info-k {
  color: #6B7C8A;
  flex-shrink: 0;
}

.info-v {
  font-weight: 700;
  text-align: right;
}

/* 导航行 */
.nav-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.nav-row-main {
  flex: 1;
  min-width: 0;
}

.nav-row-title {
  display: block;
  font-size: 30rpx;
  font-weight: 850;
  color: #1C1C1C;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-row-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A99A6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-row-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.nav-plane {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 50%;
  background: #F2F4F7;
  font-size: 32rpx;
  color: #4F6787;
}

.nav-row-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8A99A6;
}

/* 区块标题 */
.block-title {
  margin: 28rpx 0 10rpx;
  font-size: 30rpx;
  font-weight: 850;
  color: #1C1C1C;
}

/* 潮汐 */
.tide-summary {
  display: block;
  color: #184D97;
  font-size: 26rpx;
  font-weight: 700;
}

.tide-table {
  margin-top: 12rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  overflow: hidden;
  background: #FFFFFF;
}

.tide-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-top: 2rpx solid rgba(28, 28, 28, 0.1);
  font-size: 26rpx;
  font-weight: 650;
}

.tide-row:first-child {
  border-top: 0;
}

/* 标签 */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.chip {
  padding: 8rpx 22rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F3FBFA;
  color: #1888BF;
  font-size: 24rpx;
  font-weight: 700;
}

.chip.active {
  background: #34B8C5;
  color: #FFFFFF;
}

.chip.safety {
  background: #FFF2F2;
  color: #E0533D;
  border-color: #E0533D;
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #4F6787;
  font-size: 26rpx;
  line-height: 1.6;
}

.source {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(28, 28, 28, 0.1);
  color: #9AA8B2;
  font-size: 22rpx;
}
