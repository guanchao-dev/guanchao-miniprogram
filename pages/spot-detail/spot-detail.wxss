.detail-card {
  padding: 24rpx 28rpx 40rpx;
}

/* 封面/全景 */
.pano {
  height: 320rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F3FBFA;
}

.pano-img {
  width: 100%;
  height: 320rpx;
}

.pano-fallback {
  height: 240rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid #1C1C1C;
  border-radius: 24rpx;
  background: #D8F3F6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6B7C8A;
  font-size: 24rpx;
}

.pano-fallback image {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 10rpx;
}

/* 标题区 */
.spot-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #1C1C1C;
  line-height: 1.3;
}

.spot-meta {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 26rpx;
}

/* 基础信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.info-k {
  color: #6B7C8A;
  flex-shrink: 0;
}

.info-v {
  font-weight: 700;
  text-align: right;
}

/* 导航行 */
.nav-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
}

.nav-row-main {
  flex: 1;
  min-width: 0;
}

.nav-row-title {
  display: block;
  font-size: 30rpx;
  font-weight: 850;
  color: #1C1C1C;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-row-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A99A6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-row-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.nav-plane {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 50%;
  background: #F2F4F7;
  font-size: 32rpx;
  color: #4F6787;
}

.nav-row-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8A99A6;
}

/* 区块标题 */
.block-title {
  margin: 28rpx 0 10rpx;
  font-size: 30rpx;
  font-weight: 850;
  color: #1C1C1C;
}

/* 潮汐 */
.tide-summary {
  display: block;
  color: #184D97;
  font-size: 26rpx;
  font-weight: 700;
}

.tide-table {
  margin-top: 12rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  overflow: hidden;
  background: #FFFFFF;
}

.tide-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-top: 2rpx solid rgba(28, 28, 28, 0.1);
  font-size: 26rpx;
  font-weight: 650;
}

.tide-row:first-child {
  border-top: 0;
}

/* 标签 */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.chip {
  padding: 8rpx 22rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #F3FBFA;
  color: #1888BF;
  font-size: 24rpx;
  font-weight: 700;
}

.chip.active {
  background: #34B8C5;
  color: #FFFFFF;
}

.chip.safety {
  background: #FFF2F2;
  color: #E0533D;
  border-color: #E0533D;
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #4F6787;
  font-size: 26rpx;
  line-height: 1.6;
}

.source {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(28, 28, 28, 0.1);
  color: #9AA8B2;
  font-size: 22rpx;
}

/* ===== 反馈入口 ===== */
.fb-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border: 3rpx dashed rgba(28, 28, 28, 0.25);
  border-radius: 20rpx;
  color: var(--muted);
  font-size: 24rpx;
}
.fb-entry-arrow {
  font-size: 34rpx;
  line-height: 1;
}

/* ===== 反馈弹窗（居中；尺寸与结构参照 achieve 的 medal-modal）===== */
.fb-mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  background: rgba(11, 31, 56, 0.56);
}
.fb-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 680rpx;
  /* 关键：没有 max-height 时内容一高就顶出屏幕，底部按钮被切掉 */
  max-height: 82vh;
  overflow: hidden;
  box-sizing: border-box;
  border: 4rpx solid var(--ink);
  border-radius: 36rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}
.fb-head {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}
.fb-title {
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.4;
}
.fb-close {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: var(--muted);
  font-size: 44rpx;
  line-height: 1;
}
/* 内容区可滚动：小屏 / 键盘弹起也不会把底部按钮挤出屏幕 */
.fb-body {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
  padding: 0 28rpx;
  box-sizing: border-box;
}
.fb-spot {
  display: block;
  margin-bottom: 16rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}
.fb-input {
  width: 100%;
  box-sizing: border-box;
  height: 220rpx;
  padding: 20rpx;
  border: 3rpx solid var(--ink);
  border-radius: 20rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  line-height: 1.6;
}
.fb-contact {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  margin: 16rpx 0 8rpx;
  padding: 0 20rpx;
  border: 3rpx solid var(--ink);
  border-radius: 20rpx;
  background: #FFFFFF;
  font-size: 26rpx;
}
.fb-ph {
  color: #A8ADB5;
}
.fb-foot {
  flex: none;
  padding: 20rpx 28rpx 28rpx;
  box-sizing: border-box;
}
/* 不复用全局 .btn：它没设 box-sizing，width:100% 加 padding 会溢出 */
.fb-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: var(--yellow);
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}
.fb-submit.disabled {
  opacity: 0.6;
}
.fb-submit:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}
