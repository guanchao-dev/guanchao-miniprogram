<view class="page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle md" style="top: 30rpx; right: -40rpx; background:#34B8C5;"></view>
  </view>

  <view class="page-content">
    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>

    <view class="empty-tip" wx:elif="{{!faq.length}}">暂无常见问题</view>

    <!-- 手风琴列表 -->
    <view wx:for="{{faq}}" wx:key="id" class="faq-item card">
      <view class="faq-q-row" bindtap="toggleItem" data-index="{{index}}" hover-class="tap">
        <view class="faq-q-icon">Q</view>
        <text class="faq-q-text">{{item.q}}</text>
        <text class="faq-arrow {{item.open ? 'open' : ''}}">›</text>
      </view>
      <view class="faq-a-row" wx:if="{{item.open}}">
        <view class="faq-a-icon">A</view>
        <text class="faq-a-text">{{item.a}}</text>
      </view>
    </view>
  </view>
</view>

<watch-ball />
