<view class="page">
  <view class="page-content">
    <view class="card list-card">
      <view class="list-title">常见问题</view>
      <view class="page-loading" wx:if="{{loading}}">
        <view class="spinner"></view>
        <text>加载中…</text>
      </view>
      <view class="empty-tip" wx:elif="{{!faq.length}}">暂无常见问题</view>
      <view wx:for="{{faq}}" wx:key="id" class="faq-item">
        <view class="list-title faq-q">Q：{{item.q}}</view>
        <view class="list-meta faq-a">{{item.a}}</view>
      </view>
    </view>
  </view>
</view>

<watch-ball />
