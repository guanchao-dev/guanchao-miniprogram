<view class="page">
  <view class="page-content">
    <view class="card list-card">
      <view class="list-title">打卡日历</view>
      <view class="list-meta">完成现场观察后，同一天只计 1 次打卡。</view>
      <view class="btn full-btn" bindtap="goDiscover">去生成图鉴卡</view>
    </view>

    <view class="empty-tip" wx:if="{{!list.length}}">还没有打卡记录</view>
    <view class="card list-card" wx:for="{{list}}" wx:key="date">
      <view class="list-title">{{item.spotName || item.date || '观察打卡'}}</view>
      <view class="list-meta">{{item.date}} {{item.time || ''}}</view>
      <view class="list-meta" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
  </view>
</view>

<watch-ball />
