<view class="page">
  <view class="page-content">
    <view class="card list-card" wx:if="{{quiz.title}}">
      <view class="list-title">{{quiz.title}}</view>
      <view class="list-meta">共 {{questions.length}} 题，答案提交后揭晓</view>
    </view>

    <view class="card list-card" wx:for="{{questions}}" wx:key="id">
      <view class="list-title">{{index + 1}}. {{item.stem}}</view>
      <view class="chip-row quiz-options">
        <view
          class="chip {{answers[item.id] === opt.id ? 'active' : ''}}"
          wx:for="{{item.options}}"
          wx:for-item="opt"
          wx:key="id"
          data-qid="{{item.id}}"
          data-oid="{{opt.id}}"
          bindtap="onPick"
        >{{opt.text}}</view>
      </view>
    </view>

    <view class="card list-card" wx:if="{{result}}">
      <view class="list-title">得分 {{result.score}} ｜ {{result.correctCount}}/{{result.total}}</view>
      <view class="list-meta">{{result.passed ? '闯关成功' : '再看一遍解析，下次会更好'}}</view>
      <view class="list-meta" wx:for="{{result.wrong}}" wx:key="questionId">{{item.explain}}</view>
    </view>

    <view class="btn full-btn" wx:if="{{questions.length && !result}}" bindtap="onSubmit">提交答案</view>
  </view>
  <unlock-popup id="unlockPopup"></unlock-popup>
</view>
