<view class="page memphis-bg light-page">
  <view class="memphis-layer">
    <view class="geo-circle lg" style="top: 20rpx; right: -40rpx; background:#34B8C5;"></view>
    <view class="geo-square" style="bottom: 160rpx; left: -30rpx; background:#F6D081;"></view>
  </view>

  <view class="page-content">
    <view class="map-card card">
      <view class="map-switch" bindtap="onSwitchMap">{{mapName}} ▾</view>
      <view class="page-loading" wx:if="{{loading}}">
        <view class="spinner"></view>
        <text>加载中…</text>
      </view>
      <view class="map-stage" wx:else>
        <image class="map-image" src="{{mapUrl}}" mode="aspectFill"></image>
        <view
          class="fog-patch {{item.state}}"
          wx:for="{{regions}}"
          wx:key="id"
          style="left: {{item.left}}%; top: {{item.top}}%; width: {{item.width}}%; height: {{item.height}}%;"
        >
          <view class="fog-fill"></view>
          <view class="light-burst" wx:if="{{item.state === 'clearing'}}"></view>
        </view>
      </view>
    </view>
  </view>
</view>

<watch-ball />
