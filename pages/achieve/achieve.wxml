<view class="page memphis-bg achieve-page">
  <view class="memphis-layer">
    <view class="geo-circle lg" style="top: 40rpx; right: -40rpx; background:#F6D081;"></view>
    <view class="geo-square" style="bottom: 120rpx; left: -20rpx; background:#A7D9C7;"></view>
    <!-- 气泡背景：呼应吉祥物"泡泡"，从底部缓慢上浮 -->
    <view class="bubble-layer">
      <view class="bubble b1"></view>
      <view class="bubble b2"></view>
      <view class="bubble b3"></view>
      <view class="bubble b4"></view>
      <view class="bubble b5"></view>
      <view class="bubble b6"></view>
      <view class="bubble b7"></view>
      <view class="bubble b8"></view>
      <view class="bubble b9"></view>
      <view class="bubble b10"></view>
      <view class="bubble b11"></view>
      <view class="bubble b12"></view>
      <view class="bubble b13"></view>
      <view class="bubble b14"></view>
      <!-- 金色点缀泡泡 -->
      <view class="bubble b15 gold"></view>
      <view class="bubble b16 gold"></view>
    </view>
  </view>

  <view class="page-content">
    <view class="hero">
      <view class="hero-copy">
        <view class="hero-title">每一次探索</view>
        <view class="hero-title">都是荣耀的印记</view>
        <view class="hero-sub">收集勋章，记录你的海洋足迹</view>
      </view>
      <view class="hero-visual">
        <view class="hero-mascot-box">
          <image class="hero-mascot" src="https://www.blueakaiwu.cn/api/v1/static/assets/to-upload/mascot-boy-3x.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <view class="progress card">
      <view class="progress-top">
        <view class="progress-copy">
          <view class="progress-num">{{score}} <text>/ {{total}}</text></view>
          <view class="progress-label">已解锁成就 · 完成度 {{percent}}%</view>
        </view>
      </view>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{percent}}%;"></view>
      </view>
      <view class="milestones">
        <text>初露锋芒</text>
        <text>渐入佳境</text>
        <text>成就大师</text>
        <text>完美收藏</text>
      </view>
    </view>

    <view class="section-head">
      <view class="section-title-wrap">
        <view class="section-accent"></view>
        <text class="section-title">勋章墙</text>
      </view>
      <view class="section-link" bindtap="goMedalWall" hover-class="tap">
        <text class="section-more">已解锁 {{unlockedCount}} / {{medalTotal}}</text>
        <text class="section-go">全部 ›</text>
      </view>
    </view>

    <!-- 成就页只陈列 8 枚（2 行 × 4 个），点整块进勋章墙，点单枚进勋章详情 -->
    <view class="medal-wall card" bindtap="goMedalWall" hover-class="tap">
      <view class="wall-topline"><view class="wall-topline-dot"></view></view>
      <view class="page-loading" wx:if="{{medalLoading}}">
        <view class="spinner"></view>
        <text>加载中…</text>
      </view>
      <view class="empty-tip" wx:elif="{{!medals.length}}">暂无勋章</view>
      <view class="medal-grid" wx:else>
        <view
          class="medal-card {{item.locked ? 'locked' : ''}}"
          wx:for="{{medals}}"
          wx:key="id"
          data-index="{{index}}"
          catchtap="goMedalDetail"
          hover-class="tap"
        >
          <view class="medal-tag" style="background: {{item.tagBg}}; color: {{item.tagColor}};">{{item.tag}}</view>
          <image class="medal-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <text class="medal-name">{{item.locked ? '???' : item.title}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-row">
      <view class="level-card card">
        <image class="level-medal" src="https://www.blueakaiwu.cn/api/v1/static/assets/badges/medal-wing.png" mode="aspectFit"></image>
        <view class="level-title">{{levelText}}</view>
        <view class="mini-bar"><view style="width: 64%;"></view></view>
        <view class="btn level-btn" bindtap="goSpotCollection" hover-class="tap">赶海足迹</view>
      </view>

      <view class="rank-card card">
        <view class="rank-head" bindtap="goLeaderboard" hover-class="tap">
          <text class="rank-title">排行榜</text>
          <text class="rank-more">查看完整榜单 ›</text>
        </view>
        <view class="rank-item {{item.me ? 'me' : ''}}" wx:for="{{friends}}" wx:key="key" bindtap="goLeaderboard" hover-class="tap">
          <text class="rank-no">{{item.rank}}</text>
          <image src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="rank-meta">
            <text class="rank-name">{{item.name}}</text>
            <text class="rank-level">{{item.level}}</text>
          </view>
          <text class="rank-score">{{item.score}}</text>
        </view>
        <view class="page-loading" wx:if="{{boardLoading}}">
          <view class="spinner"></view>
          <text>加载中…</text>
        </view>
        <view class="rank-empty" wx:elif="{{!friends.length}}">暂无排行数据</view>
      </view>
    </view>
  </view>

  <unlock-popup id="unlockPopup"></unlock-popup>
</view>

<onboarding
  visible="{{showOnboarding}}"
  start-index="{{onbStartIndex}}"
  target-rect="{{onbRect}}"
  bind:finish="onOnboardingFinish"
  bind:locate="onOnboardingLocate"
/>

<watch-ball />