.achieve-page {
  padding-top: 12rpx;
}

.hero {
  position: relative;
  /* 必须高于下方 .card 的 z-index:2，否则吉祥物会被进度卡盖住 */
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.28;
}

.hero-sub {
  margin-top: 12rpx;
  color: #6B7C8A;
  font-size: 22rpx;
}

.hero-visual {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  /* 高于下方进度卡，人物才能压上去 */
  z-index: 3;
}

/* 男版吉祥物是自带圆形勋章底的方图：不裁切，允许人物溢出叠压 */
.hero-mascot-box {
  position: absolute;
  right: 0;
  top: 12rpx;
  width: 224rpx;
  height: 224rpx;
  overflow: visible;
  z-index: 3;
}

.hero-mascot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 224rpx;
  height: 224rpx;
  z-index: 3;
  /* 放大并往左下移，人物盖在下方卡片上，形成叠压层次 */
  transform: scale(1.5) translate(2%, 25%);
  transform-origin: 100% 100%;
}

/* 成就进度卡：黑边 + 暖白渐变底 */
.progress {
  padding: 22rpx 24rpx 20rpx;
  background: linear-gradient(180deg, #FFFBF0 0%, #FFFFFF 48%);
}

.progress-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-num {
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.1;
}

.progress-num text {
  color: #B07A18;
  font-size: 24rpx;
  font-weight: 700;
}

.progress-label {
  margin-top: 6rpx;
  color: #8A7A6B;
  font-size: 22rpx;
}

/* 进度条：加金色内圈和一道高光，呼应金边 */
.bar-track {
  position: relative;
  height: 24rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFF4E8;
  box-shadow: inset 0 0 0 2rpx rgba(224, 168, 58, 0.35);
}

.bar-fill {
  position: relative;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #184D97, #34B8C5 72%, #6FD3C4);
}

/* 进度条顶部高光 */
.bar-fill::after {
  content: '';
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 3rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
}

.milestones {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #8A7A6B;
  font-size: 18rpx;
}

/* 勋章墙这一块是这页的"战利品展柜"，整块走金色：金边、金投影、暖底 */
.medal-wall {
  padding: 34rpx 12rpx 14rpx;
  border-color: #E0A83A;
  box-shadow: 5rpx 5rpx 0 #E0A83A, inset 0 0 0 3rpx rgba(224, 168, 58, 0.2);
  background: linear-gradient(180deg, #FFF7E6 0%, #FFFDF7 58%, #FFFFFF 100%);
}

/* 展柜顶部一条金色饰线，中间一颗菱形，做出"陈列"的仪式感 */
.wall-topline {
  position: absolute;
  top: 15rpx;
  left: 28rpx;
  right: 28rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(224, 168, 58, 0) 0%, #E0A83A 50%, rgba(224, 168, 58, 0) 100%);
  opacity: 0.8;
  pointer-events: none;
}

.wall-topline-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 15rpx;
  height: 15rpx;
  margin: -7.5rpx 0 0 -7.5rpx;
  border-radius: 3rpx;
  background: #E0A83A;
  transform: rotate(45deg);
}

/* 勋章墙入口：右侧「已解锁 x / y」+「全部 ›」，整块卡片也可点 */
.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 标题前一抹金色，和展柜金边呼应 */
.section-accent {
  width: 10rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #F6D081, #E0A83A);
  box-shadow: 2rpx 2rpx 0 rgba(224, 168, 58, 0.35);
}

.section-link {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-more {
  color: #8A7A6B;
  font-size: 24rpx;
  font-weight: 650;
}

.section-go {
  color: #B07A18;
  font-size: 24rpx;
  font-weight: 800;
}

.medal-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.medal-card {
  position: relative;
  width: 23%;
  height: 176rpx;
  margin-right: 2.666%;
  margin-bottom: 12rpx;
  padding: 22rpx 5rpx 6rpx;
  box-sizing: border-box;
  /* 已解锁的勋章是这页的"战利品"，用金边点睛 */
  border: 3rpx solid #E0A83A;
  border-radius: 18rpx;
  background: #FFFBF2;
  box-shadow: 3rpx 3rpx 0 rgba(224, 168, 58, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.medal-card:nth-child(4n) {
  margin-right: 0;
}

.medal-tag {
  position: absolute;
  top: 6rpx;
  left: 4rpx;
  z-index: 2;
  max-width: 92%;
  padding: 2rpx 6rpx;
  border-radius: 999rpx;
  font-size: 12rpx;
  font-weight: 750;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 勋章图尽量铺满格子，只给名称留一行 */
.medal-icon {
  width: 118rpx;
  height: 118rpx;
  margin-bottom: 2rpx;
}

.medal-name {
  display: block;
  width: 100%;
  color: #2F3A4A;
  font-size: 16rpx;
  font-weight: 750;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 未解锁：弱化边框与投影，让勋章墙产生"点亮/待解锁"的层级 */
.medal-card.locked {
  border-color: #DCE2E7;
  background: #F3F5F7;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.08);
}

.medal-card.locked .medal-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 24rpx;
  opacity: 0.75;
}

.medal-card.locked .medal-name {
  color: #9AA3AF;
}

.bottom-row {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.level-card,
.rank-card {
  flex: 1;
  padding: 20rpx;
}

/* Lv 勋章图自带一块 #F6F8FA 方形底，卡片同色后与图片底无缝 */
.level-card {
  background: #F6F8FA;
}

.level-medal {
  width: 96rpx;
  height: 96rpx;
  display: block;
  margin: 0 auto 8rpx;
}

.level-title {
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
}

.mini-bar {
  height: 14rpx;
  margin: 14rpx 0 18rpx;
  overflow: hidden;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #EEF6FF;
}

.mini-bar view {
  height: 100%;
  background: #1888BF;
}

.level-btn {
  width: 100%;
  box-sizing: border-box;
  background: #1888BF;
  color: #fff;
}

.rank-empty {
  padding: 24rpx 0 8rpx;
  color: #6B7C8A;
  font-size: 22rpx;
  text-align: center;
}

.rank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rank-more {
  color: #1878FF;
  font-size: 20rpx;
  font-weight: 750;
}

.rank-no {
  width: 32rpx;
  text-align: center;
  color: #8A7A6B;
  font-size: 20rpx;
  font-weight: 850;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
  padding: 8rpx;
  border-radius: 16rpx;
}

.rank-item.me {
  background: #E7F5FB;
  border: 3rpx solid #1C1C1C;
}

.rank-item image {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #ddd;
}

.rank-meta {
  flex: 1;
  min-width: 0;
}

.rank-name {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-level,
.rank-score {
  color: #8A7A6B;
  font-size: 18rpx;
}

.rank-score {
  font-weight: 750;
  color: #184D97;
}

