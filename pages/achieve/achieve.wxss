.achieve-page {
  padding-top: 12rpx;
}

.hero {
  position: relative;
  /* 必须高于下方 .card 的 z-index:2，否则吉祥物会被进度卡盖住 */
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 12rpx;
  color: #6B7C8A;
  font-size: 22rpx;
  font-weight: 650;
}

.hero-visual {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  /* 高于下方进度卡，人物才能压上去 */
  z-index: 3;
}

/* 男版吉祥物是自带圆形勋章底的方图：不裁切，允许人物溢出叠压 */
.hero-mascot-box {
  position: absolute;
  right: 0;
  top: 12rpx;
  width: 224rpx;
  height: 224rpx;
  overflow: visible;
  z-index: 3;
}

.hero-mascot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 224rpx;
  height: 224rpx;
  z-index: 3;
  /* 放大并往左下移，人物盖在下方卡片上，形成叠压层次 */
  transform: scale(1.5) translate(2%, 25%);
  transform-origin: 100% 100%;
}

/* 泡泡身后的粉色光圈 */
.hero-mascot-halo {
  position: absolute;
  right: -46rpx;
  bottom: -46rpx;
  width: 320rpx;
  height: 320rpx;
  z-index: 1;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 138, 170, 0.55) 0%, rgba(255, 182, 203, 0.26) 48%, rgba(255, 182, 203, 0) 72%);
  animation: mascotGlow 3.2s ease-in-out infinite;
}

@keyframes mascotGlow {
  0%, 100% { opacity: 0.72; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.07); }
}

/* 成就进度卡：黑边 + 暖白底 */
.progress {
  padding: 24rpx 24rpx 20rpx;
  background: #FFFFFF;
}

.progress-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-num {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.progress-num text {
  color: #8A5B00;
  font-size: 22rpx;
  font-weight: 700;
}

.progress-label {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 650;
}

/* 进度条：与勋章墙同一条进度语言 */
.bar-track {
  position: relative;
  height: 20rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFF6E0;
}

.bar-fill {
  position: relative;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1888BF, #34B8C5);
}

.milestones {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #6B7C8A;
  font-size: 19rpx;
  font-weight: 650;
}

/* 勋章墙这一块是这页的"战利品展柜"：墨色描边 + 金色硬投影 + 暖底 */
.medal-wall {
  padding: 32rpx 12rpx 12rpx;
  box-shadow: 4rpx 4rpx 0 #E0A83A;
  background: #FFFBF2;
}

/* 展柜顶部一条金色饰线，中间一颗菱形，做出"陈列"的仪式感 */
.wall-topline {
  position: absolute;
  top: 15rpx;
  left: 28rpx;
  right: 28rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: rgba(224, 168, 58, .7);
  pointer-events: none;
}

.wall-topline-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 3rpx;
  background: #E0A83A;
  transform: rotate(45deg);
}

/* 勋章墙入口：右侧「已解锁 x / y」+「全部 ›」，整块卡片也可点 */
.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 标题前一抹金色，和展柜金边呼应 */
.section-accent {
  width: 10rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #E0A83A;
}

.section-link {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-more {
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.section-go {
  color: #8A5B00;
  font-size: 22rpx;
  font-weight: 800;
}

.medal-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.medal-card {
  position: relative;
  width: 23%;
  height: 176rpx;
  margin-right: 2.666%;
  margin-bottom: 12rpx;
  padding: 22rpx 5rpx 6rpx;
  box-sizing: border-box;
  /* 已解锁的勋章是这页的"战利品"，用金边点睛 */
  border: 3rpx solid #E0A83A;
  border-radius: 18rpx;
  background: #FFFBF2;
  box-shadow: 2rpx 2rpx 0 rgba(224, 168, 58, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.medal-card:nth-child(4n) {
  margin-right: 0;
}

.medal-tag {
  position: absolute;
  top: 6rpx;
  left: 4rpx;
  z-index: 2;
  max-width: 92%;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 750;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 勋章图尽量铺满格子，只给名称留一行 */
.medal-icon {
  width: 118rpx;
  height: 118rpx;
  margin-bottom: 2rpx;
}

.medal-name {
  display: block;
  width: 100%;
  color: #2F3A4A;
  font-size: 18rpx;
  font-weight: 750;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 未解锁：弱化边框与投影，让勋章墙产生"点亮/待解锁"的层级 */
.medal-card.locked {
  border-color: #DCE2E7;
  background: #F3F5F7;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.08);
}

.medal-card.locked .medal-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 24rpx;
  opacity: 0.75;
}

.medal-card.locked .medal-name {
  color: #9AA3AF;
}

.bottom-row {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.level-card,
.rank-card {
  flex: 1;
  padding: 20rpx;
}

/* Lv 勋章图自带一块 #F6F8FA 方形底，卡片同色后与图片底无缝 */
.level-card {
  background: #F6F8FA;
}

.level-medal {
  width: 96rpx;
  height: 96rpx;
  display: block;
  margin: 0 auto 8rpx;
}

.level-title {
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
}

.mini-bar {
  height: 16rpx;
  margin: 14rpx 0 20rpx;
  overflow: hidden;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #EEF6FF;
}

.mini-bar view {
  height: 100%;
  background: #1888BF;
}

.level-btn {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  border-width: 4rpx;
  box-shadow: 4rpx 4rpx 0 rgba(28, 28, 28, 0.85);
  background: #1888BF;
  color: #fff;
  font-size: 24rpx;
  font-weight: 850;
}

.rank-empty {
  padding: 24rpx 0 8rpx;
  color: #6B7C8A;
  font-size: 24rpx;
  font-weight: 650;
  text-align: center;
}

.rank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rank-more {
  color: #1888BF;
  font-size: 21rpx;
  font-weight: 750;
}

.rank-no {
  width: 32rpx;
  text-align: center;
  color: #6B7C8A;
  font-size: 20rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
  padding: 10rpx;
  border-radius: 16rpx;
}

.rank-item.me {
  background: #E7FBFC;
  border: 3rpx solid #1C1C1C;
}

.rank-item image {
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #ddd;
}

.rank-meta {
  flex: 1;
  min-width: 0;
}

.rank-name {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-level,
.rank-score {
  color: #6B7C8A;
  font-size: 19rpx;
  font-weight: 650;
}

.rank-score {
  font-weight: 850;
  color: #184D97;
  font-variant-numeric: tabular-nums;
}

