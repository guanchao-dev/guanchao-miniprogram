.spot-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 22rpx 22rpx;
}

.spot-item.tap {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

.item-rank {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #F6D081;
  text-align: center;
  line-height: 42rpx;
  font-size: 24rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.item-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  color: #1888BF;
}

.mask {
  position: fixed;
  inset: 0;
  /* 高于悬浮赶海球（90） */
  z-index: 95;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(11, 31, 56, 0.56);
}

.sheet {
  width: 100%;
  max-height: 84vh;
  overflow: hidden;
  border: 4rpx solid #1C1C1C;
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  background: #FBF7EF;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx 10rpx;
  font-size: 30rpx;
  font-weight: 850;
  color: #1C1C1C;
}

.sheet-head text:first-child {
  flex: 1;
  min-width: 0;
}

.sheet-close {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  color: #1C1C1C;
}

.sheet-body {
  max-height: 72vh;
  padding: 8rpx 24rpx 0;
  box-sizing: border-box;
}

.sheet-bottom-gap {
  height: calc(60rpx + env(safe-area-inset-bottom));
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #3C556B;
  font-size: 25rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
