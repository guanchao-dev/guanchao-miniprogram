<view class="page memphis-bg">
  <view class="memphis-layer">
    <view class="geo-circle lg" style="top: 20rpx; right: -40rpx; background:#F6D081;"></view>
    <view class="geo-square" style="bottom: 180rpx; left: -30rpx; background:#34B8C5;"></view>
  </view>

  <view class="page-content">
    <view class="page-loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中…</text>
    </view>
    <view class="empty-tip" wx:elif="{{!list.length}}">暂无科普内容</view>
    <view class="spot-item card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen" hover-class="tap">
      <view class="item-rank">{{index + 1}}</view>
      <view class="item-body">
        <view class="item-name">{{item.title}}</view>
        <view class="item-meta">{{item.summary}}</view>
      </view>
      <text class="item-arrow">›</text>
    </view>
  </view>

  <view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text>{{detail.title}}</text>
        <text class="sheet-close" bindtap="closeDetail" hover-class="tap">×</text>
      </view>
      <scroll-view scroll-y class="sheet-body">
        <view class="page-loading" wx:if="{{detailLoading}}">
          <view class="spinner"></view>
          <text>加载中…</text>
        </view>
        <block wx:else>
          <view class="chip-row" wx:if="{{detail.tags.length}}">
            <text class="chip" wx:for="{{detail.tags}}" wx:key="*this">{{item}}</text>
          </view>
          <text class="hint">{{detail.body}}</text>
        </block>
        <!-- scroll-view 的 padding-bottom 不计入滚动高度，用占位块保证底部留白 -->
        <view class="sheet-bottom-gap"></view>
      </scroll-view>
    </view>
  </view>
</view>

<watch-ball />
