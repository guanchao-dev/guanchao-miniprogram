<view class="page">
  <view class="page-content">
    <view class="card search-box">
      <input placeholder="搜索赶海点 / 图鉴" value="{{keyword}}" bindinput="onInput" confirm-type="search" bindconfirm="onSearch" />
      <view class="btn" bindtap="onSearch" hover-class="tap">搜索</view>
    </view>

    <view class="type-tabs">
      <view class="type-tab {{tab === 'spot' ? 'on' : ''}}" data-tab="spot" bindtap="onTab" hover-class="tap">赶海点</view>
      <view class="type-tab {{tab === 'wiki' ? 'on' : ''}}" data-tab="wiki" bindtap="onTab" hover-class="tap">图鉴</view>
    </view>

    <scroll-view
      class="city-tabs"
      wx:if="{{tab === 'spot' && cities.length}}"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view
        class="city-chip {{city === item ? 'on' : ''}}"
        wx:for="{{cities}}"
        wx:key="*this"
        data-city="{{item}}"
        bindtap="onCity"
        hover-class="tap"
      >{{item}}</view>
    </scroll-view>

    <block wx:if="{{tab === 'spot'}}">
      <block wx:for="{{visibleGroups}}" wx:key="city" wx:for-item="group">
        <view class="card list-card" wx:for="{{group.list}}" wx:key="id" data-id="{{item.id}}" bindtap="openSpot" hover-class="tap">
          <view class="list-title">{{item.shortName}}</view>
          <view class="list-meta">{{item.district || item.city}} {{item.observeHint}}</view>
        </view>
      </block>
      <view class="empty-tip" wx:if="{{searched && !visibleGroups.length}}">没有找到相关赶海点</view>
    </block>

    <block wx:else>
      <view class="card list-card" wx:for="{{species}}" wx:key="id" data-id="{{item.id}}" bindtap="openWiki" hover-class="tap">
        <view class="list-title">{{item.name}}</view>
        <view class="list-meta">{{item.summary}}</view>
      </view>
      <view class="empty-tip" wx:if="{{searched && !species.length}}">没有找到相关图鉴</view>
    </block>
  </view>
</view>

<watch-ball />
