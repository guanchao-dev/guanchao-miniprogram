.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  margin-bottom: 24rpx;
}

/* 输入框做成纸色胶囊，和卡片的白底区分开 */
.search-box input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 3rpx solid rgba(28, 28, 28, 0.16);
  border-radius: 999rpx;
  background: #FBF7EF;
  color: #1C1C1C;
  font-size: 25rpx;
  font-weight: 650;
}

.search-box .btn {
  height: 68rpx;
  padding: 0 34rpx;
  font-size: 24rpx;
  font-weight: 850;
}

/* 结果分类：赶海点 / 图鉴 */
.type-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.type-tab {
  flex: 1;
  padding: 17rpx 0;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  color: #4F6787;
  text-align: center;
  font-size: 25rpx;
  font-weight: 800;
}

.type-tab.on {
  background: #34B8C5;
  color: #FFFFFF;
}

/* 赶海点下的二级地点，可横向滚动 */
.city-tabs {
  margin-bottom: 22rpx;
  padding: 2rpx 4rpx 6rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.city-chip {
  display: inline-block;
  margin-right: 16rpx;
  padding: 12rpx 26rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 0 rgba(28, 28, 28, 0.85);
  color: #1C1C1C;
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.3;
}

.city-chip:last-child {
  margin-right: 4rpx;
}

.city-chip.on {
  background: #34B8C5;
  color: #FFFFFF;
  font-weight: 850;
}

/* 结果卡：收一行行高、压一层阴影，点下去有实感 */
.list-card {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
}

.list-card:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(28, 28, 28, 0.85);
}

.list-title {
  color: #1C1C1C;
  font-size: 28rpx;
  font-weight: 850;
}

.list-meta {
  margin-top: 6rpx;
  color: #6B7C8A;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.5;
}
