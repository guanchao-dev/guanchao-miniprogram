page {
  --navy: #184D97;
  --blue: #1888BF;
  --teal: #34B8C5;
  --mint: #A7D9C7;
  --yellow: #F6D081;
  --cream: #F6E9D3;
  --ink: #1C1C1C;
  --muted: #6B7C8A;
  --card: #FFFFFF;
  --bg: #FFFFFF;
  --shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
  position: relative;
  overflow-x: hidden;
  overflow-y: auto;
  background: var(--bg);
}

.memphis-bg {
  background: var(--bg);
}

.memphis-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

/* ===== 上浮泡泡：呼应吉祥物"泡泡"，首页/成就/我的共用 ===== */
.bubble-layer {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

/* 选择器都收在 .bubble-layer 下，避免和其它页同名的 .bN 类互相影响 */
.bubble-layer .bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.8), rgba(52,184,197,0.3) 55%, rgba(24,136,191,0.18));
  box-shadow: inset -3rpx -3rpx 10rpx rgba(255,255,255,0.4), 0 0 12rpx rgba(52,184,197,0.25);
  animation: bubbleRise linear infinite;
}

/* 14 个气泡：从页面底部开始上浮，大小、位置、速度各异 */
.bubble-layer .b1  { width: 90rpx;  height: 90rpx;  left: 6%;  top: 1200rpx; animation-duration: 13s; animation-delay: 0s; }
.bubble-layer .b2  { width: 52rpx;  height: 52rpx;  left: 18%; top: 1300rpx; animation-duration: 10s; animation-delay: 2s; }
.bubble-layer .b3  { width: 130rpx; height: 130rpx; left: 72%; top: 1150rpx; animation-duration: 17s; animation-delay: 1s; }
.bubble-layer .b4  { width: 40rpx;  height: 40rpx;  left: 88%; top: 1280rpx; animation-duration: 8s;  animation-delay: 3s; }
.bubble-layer .b5  { width: 70rpx;  height: 70rpx;  left: 42%; top: 1350rpx; animation-duration: 12s; animation-delay: 0.5s; }
.bubble-layer .b6  { width: 32rpx;  height: 32rpx;  left: 12%; top: 1400rpx; animation-duration: 9s;  animation-delay: 4s; }
.bubble-layer .b7  { width: 100rpx; height: 100rpx; left: 58%; top: 1250rpx; animation-duration: 15s; animation-delay: 2.5s; }
.bubble-layer .b8  { width: 46rpx;  height: 46rpx;  left: 90%; top: 1380rpx; animation-duration: 11s; animation-delay: 1.5s; }
.bubble-layer .b9  { width: 60rpx;  height: 60rpx;  left: 30%; top: 1450rpx; animation-duration: 14s; animation-delay: 5s; }
.bubble-layer .b10 { width: 36rpx;  height: 36rpx;  left: 75%; top: 1420rpx; animation-duration: 8.5s; animation-delay: 6s; }
.bubble-layer .b11 { width: 80rpx;  height: 80rpx;  left: 50%; top: 1480rpx; animation-duration: 16s; animation-delay: 3.5s; }
.bubble-layer .b12 { width: 28rpx;  height: 28rpx;  left: 5%;  top: 1500rpx; animation-duration: 7.5s; animation-delay: 4.5s; }
.bubble-layer .b13 { width: 110rpx; height: 110rpx; left: 82%; top: 1520rpx; animation-duration: 18s; animation-delay: 7s; }
.bubble-layer .b14 { width: 50rpx;  height: 50rpx;  left: 38%; top: 1550rpx; animation-duration: 10.5s; animation-delay: 5.5s; }
/* 点缀色泡泡：首页用粉色、成就页用金色，各 2 颗 */
.bubble-layer .b15 { width: 64rpx;  height: 64rpx;  left: 24%; top: 1320rpx; animation-duration: 12.5s; animation-delay: 1.2s; }
.bubble-layer .b16 { width: 44rpx;  height: 44rpx;  left: 66%; top: 1440rpx; animation-duration: 10s;   animation-delay: 3.2s; }

.bubble-layer .bubble.pink {
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.9), rgba(255,150,178,0.38) 55%, rgba(255,120,160,0.2));
  box-shadow: inset -3rpx -3rpx 10rpx rgba(255,255,255,0.5), 0 0 12rpx rgba(255,138,160,0.35);
}

.bubble-layer .bubble.gold {
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.9), rgba(246,208,129,0.5) 55%, rgba(224,168,58,0.28));
  box-shadow: inset -3rpx -3rpx 10rpx rgba(255,255,255,0.5), 0 0 12rpx rgba(224,168,58,0.4);
}

@keyframes bubbleRise {
  0% {
    transform: translateY(0) scale(1);
    opacity: 0;
  }
  8% { opacity: 0.85; }
  92% { opacity: 0.7; }
  100% {
    transform: translateY(-1700rpx) scale(1.15);
    opacity: 0;
  }
}

.page-content {
  position: relative;
  z-index: 2;
}

.dot,
.geo-circle,
.geo-square,
.geo-star {
  position: absolute;
  z-index: 0;
  pointer-events: none;
  box-shadow: none !important;
  border: 0 !important;
  filter: blur(14rpx);
  opacity: 0.45;
}

.dot,
.geo-circle {
  border-radius: 50%;
}

.geo-circle.sm {
  width: 90rpx;
  height: 90rpx;
  filter: blur(14rpx);
}

.geo-circle.md {
  width: 160rpx;
  height: 160rpx;
  filter: blur(18rpx);
}

.geo-circle.lg {
  width: 240rpx;
  height: 240rpx;
  filter: blur(24rpx);
}

.geo-square {
  width: 140rpx;
  height: 140rpx;
  transform: rotate(14deg);
  filter: blur(16rpx);
  opacity: 0.4;
}

.geo-square.sm {
  width: 100rpx;
  height: 100rpx;
  filter: blur(14rpx);
}

.geo-star {
  width: 120rpx;
  height: 120rpx;
  background: #F6D081;
  transform: rotate(45deg);
  filter: blur(16rpx);
  opacity: 0.42;
}

.geo-star.blue { background: #1888BF; }
.geo-star.teal { background: #34B8C5; }
.geo-star.navy { background: #184D97; opacity: 0.28; }
.geo-star.lg {
  width: 170rpx;
  height: 170rpx;
  filter: blur(20rpx);
}

.dot {
  width: 70rpx;
  height: 70rpx;
  background: rgba(24, 77, 151, 0.22);
  filter: blur(12rpx);
}

.card {
  position: relative;
  z-index: 2;
  background: var(--card);
  border: 4rpx solid var(--ink);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
}

.section-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 4rpx 18rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
}

.section-more {
  color: var(--blue);
  font-size: 24rpx;
  font-weight: 650;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  height: 64rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: var(--yellow);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 750;
  box-shadow: 3rpx 3rpx 0 rgba(28, 28, 28, 0.85);
}

.btn::after {
  border: 0;
}

.empty-tip {
  padding: 80rpx 20rpx;
  color: var(--muted);
  text-align: center;
  font-size: 26rpx;
}

/* 加载中：数据没回来之前就转圈，不显示占位假数据 */
.page-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 20rpx;
  border: 5rpx solid #E3E9EF;
  border-top-color: #1878FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.list-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 850;
}

.list-meta {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.chip {
  padding: 8rpx 18rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #FFFFFF;
}

.chip.active {
  background: #1878FF;
  color: #FFFFFF;
}

.cover {
  width: 100%;
  height: 280rpx;
  border: 3rpx solid #1C1C1C;
  border-radius: 20rpx;
  background: #F3FBFA;
}

.full-btn {
  width: 100%;
  height: 80rpx;
  margin-top: 24rpx;
  background: #1878FF;
  color: #FFFFFF;
  box-sizing: border-box;
}

.ghost-btn {
  background: #FFFFFF;
  color: #1C1C1C;
}

.note {
  width: 100%;
  min-height: 180rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 3rpx solid #1C1C1C;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.faq-item {
  margin-top: 18rpx;
}

.quiz-options {
  margin-top: 12rpx;
}

/* ============================================================
   全局动效
   ------------------------------------------------------------
   页面之间的切换动画由微信原生控制（webview 渲染器改不了），
   所以「顺滑感」只能从这三处来：弹窗过渡、按下反馈、内容入场。

   时长与曲线统一用一套：短（0.2s 上下）、减速曲线（ease-out），
   不做弹跳、不做大位移 —— 动作越小越像系统原生。
   ============================================================ */

@keyframes mask-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* 面板轻微上浮 + 从略小回到原尺寸。位移只有 28rpx，避免"飞进来"的廉价感 */
@keyframes panel-in {
  from { opacity: 0; transform: translateY(28rpx) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 内容入场：只用透明度。
   刻意不用位移 —— transform 会给内部 position:fixed 的弹窗制造包含块，
   弹窗就会相对内容区定位而不是视口，直接错位。 */
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* 遮罩淡入。弹窗都用 wx:if 控制显隐，进场动画纯 CSS 就能生效，不用改 JS。
   出场没做：wx:if 会把元素立刻移除，要做出场得改成常驻 DOM + visible 控制，
   收益不大、改动面却很大。 */
.mask,
.ai-mask,
.unlock-mask,
.spot-mask {
  animation: mask-in 0.22s ease-out both;
}

/* 弹窗面板。.panel 是 checkin-form 里的内联表单面板，所以只在遮罩内才动 */
.sheet,
.ai-modal,
.mask .panel,
.spot-mask .panel {
  animation: panel-in 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* 按下反馈。wxml 上用 hover-class="tap" 指定，这里只定义样子。
   之前 157 个可点击元素只有 1 个有反馈，点下去毫无动静 —— 这是"顺滑感"
   里体感最强的一块。 */
.tap {
  opacity: 0.68;
}

/* 页面内容入场。放在 .page-content 上，每个页面首次加载淡入一次；
   tabBar 页面被切回来时不会重放（元素没销毁）。 */
.page-content {
  animation: page-in 0.2s ease-out both;
}
